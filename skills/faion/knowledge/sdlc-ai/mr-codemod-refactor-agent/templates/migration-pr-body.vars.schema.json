{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdlc-ai/mr-codemod-refactor-agent/migration-pr-body.vars.schema.json",
  "title": "migration-pr-body template variables",
  "description": "Values for templates/migration-pr-body.md.j2 and templates/migration-pr-body.html.j2. Generated by tpl-jinja from migration-pr-body.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "call_sites": {
      "type": "string",
      "title": "Call sites",
      "description": "Call-sites rewritten. From section 'Stats'."
    },
    "files_count": {
      "type": "integer",
      "title": "Files count",
      "description": "Files touched. From section 'Stats'."
    },
    "risk_level": {
      "type": "string",
      "title": "Risk level",
      "description": "The risk level used under 'Risk'."
    },
    "tail_files": {
      "type": "string",
      "title": "Tail files",
      "description": "LLM tail-pass files. From section 'Stats'."
    }
  },
  "required": [
    "call_sites",
    "files_count",
    "risk_level",
    "tail_files"
  ],
  "x-faion-dictionary-refs": 0
}
