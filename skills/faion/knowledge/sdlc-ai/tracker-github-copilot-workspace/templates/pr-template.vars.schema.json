{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdlc-ai/tracker-github-copilot-workspace/pr-template.vars.schema.json",
  "title": "pr-template template variables",
  "description": "Values for templates/pr-template.md.j2 and templates/pr-template.html.j2. Generated by tpl-jinja from pr-template.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "issue_number": {
      "type": "integer",
      "title": "Issue number",
      "description": "Closes #."
    },
    "snapshot_id": {
      "type": "string",
      "title": "Snapshot id",
      "description": "Workspace snapshot: https."
    }
  },
  "required": [
    "issue_number",
    "snapshot_id"
  ],
  "x-faion-dictionary-refs": 0
}
