{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/infra/gitops/spec.vars.schema.json",
  "title": "spec template variables",
  "description": "Values for templates/spec.md.j2 and templates/spec.html.j2. Generated by tpl-jinja from spec.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "title": "Name",
      "description": "The name used under 'Components'."
    },
    "plan": {
      "type": "string",
      "title": "Plan",
      "description": "Mitigation. From section 'Risks'."
    },
    "responsibility_interfaces": {
      "type": "string",
      "title": "Responsibility interfaces",
      "description": "The responsibility interfaces used under 'Components'."
    },
    "risk": {
      "type": "string",
      "title": "Risk",
      "description": "The risk used under 'Risks'."
    }
  },
  "required": [
    "name",
    "plan",
    "responsibility_interfaces",
    "risk"
  ],
  "x-faion-dictionary-refs": 0
}
