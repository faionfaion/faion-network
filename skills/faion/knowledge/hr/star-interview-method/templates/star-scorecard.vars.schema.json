{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/hr/star-interview-method/star-scorecard.vars.schema.json",
  "title": "star-scorecard template variables",
  "description": "Values for templates/star-scorecard.md.j2 and templates/star-scorecard.html.j2. Generated by tpl-jinja from star-scorecard.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "behavioral_question_text": {
      "type": "string",
      "title": "Behavioral question text",
      "description": "Question 1. From section 'STAR Interview Scorecard'."
    },
    "candidate_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/candidate_name"
        }
      ],
      "description": "STAR Interview Scorecard."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'STAR Interview Scorecard'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Interviewer. From section 'STAR Interview Scorecard'."
    },
    "role": {
      "type": "string",
      "title": "Role",
      "description": "STAR Interview Scorecard."
    }
  },
  "required": [
    "behavioral_question_text",
    "date",
    "name",
    "role"
  ],
  "x-faion-dictionary-refs": 1
}
