{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/hr/employer-branding/content-calendar.vars.schema.json",
  "title": "content-calendar template variables",
  "description": "Values for templates/content-calendar.md.j2 and templates/content-calendar.html.j2. Generated by tpl-jinja from content-calendar.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "evp_pillar": {
      "type": "string",
      "title": "Evp pillar",
      "description": "The evp pillar used under 'Week 1'.",
      "enum": [
        "Growth",
        "Purpose",
        "Flexibility — pick one"
      ]
    },
    "job_title_link": {
      "type": "string",
      "title": "Job title link",
      "description": "Role. From section 'Week 4'."
    },
    "others": {
      "type": "string",
      "title": "Others",
      "description": "Channel. From section 'Week 4'."
    }
  },
  "required": [
    "evp_pillar",
    "job_title_link",
    "others"
  ],
  "x-faion-dictionary-refs": 0
}
