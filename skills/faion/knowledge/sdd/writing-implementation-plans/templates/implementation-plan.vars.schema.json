{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/writing-implementation-plans/implementation-plan.vars.schema.json",
  "title": "implementation-plan template variables",
  "description": "Values for templates/implementation-plan.md.j2 and templates/implementation-plan.html.j2. Generated by tpl-jinja from implementation-plan.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action_verb_target": {
      "type": "string",
      "title": "Action verb target",
      "description": "TASK-001. From section 'Tasks'."
    },
    "feature_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/feature_name"
        }
      ],
      "description": "Implementation Plan."
    }
  },
  "required": [
    "action_verb_target",
    "feature_name"
  ],
  "x-faion-dictionary-refs": 1
}
