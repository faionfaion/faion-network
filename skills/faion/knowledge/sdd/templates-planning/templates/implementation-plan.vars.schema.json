    },
    "mitigation": {
      "type": "string",
      "title": "Mitigation",
      "description": "The mitigation used under 'Risks'."
    },
    "path": {
      "type": "string",
      "title": "Path",
      "description": "The path used under 'TASK 001'."
    },
    "risk": {
      "type": "string",
      "title": "Risk",
      "description": "The risk used under 'Risks'."
