{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/templates-planning/confidence-check.vars.schema.json",
  "title": "confidence-check template variables",
  "description": "Values for templates/confidence-check.md.j2 and templates/confidence-check.html.j2. Generated by tpl-jinja from confidence-check.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "title": "Action",
      "description": "The action used under 'Recommended Actions'."
    },
    "phase": {
      "type": "string",
      "title": "Phase",
      "description": "Confidence Check."
    },
    "question": {
      "type": "string",
      "title": "Question",
      "description": "1. From section 'Questions to Answer First'."
    }
  },
  "required": [
    "action",
    "phase",
    "question"
  ],
  "x-faion-dictionary-refs": 0
}
