{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/templates-planning/constitution.vars.schema.json",
  "title": "constitution template variables",
  "description": "Values for templates/constitution.md.j2 and templates/constitution.html.j2. Generated by tpl-jinja from constitution.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "brief_explanation": {
      "type": "string",
      "title": "Brief explanation",
      "description": "The brief explanation used under 'Architecture Patterns'."
    },
    "db": {
      "type": "string",
      "title": "Db",
      "description": "Database. From section 'Tech Stack'."
    },
    "framework": {
      "type": "string",
      "title": "Framework",
      "description": "The framework used under 'Tech Stack'."
    },
    "lang": {
      "type": "string",
      "title": "Lang",
      "description": "Language. From section 'Tech Stack'."
    },
    "location": {
      "type": "string",
      "title": "Location",
      "description": "Config. From section 'Formatting'."
    },
    "path": {
      "type": "string",
      "title": "Path",
      "description": "Test location. From section 'Testing'."
    },
    "pattern": {
      "type": "string",
      "title": "Pattern",
      "description": "The pattern used under 'Architecture Patterns'."
    },
    "platform": {
      "type": "string",
      "title": "Platform",
      "description": "Hosting. From section 'Tech Stack'."
    },
    "principle_1": {
      "type": "string",
      "title": "Principle 1",
      "description": "1. From section 'Principles'."
    },
    "principle_2": {
      "type": "string",
      "title": "Principle 2",
      "description": "2. From section 'Principles'."
    },
    "principle_3": {
      "type": "string",
      "title": "Principle 3",
      "description": "3. From section 'Principles'."
    },
    "project_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/project_name"
        }
      ],
      "description": "Constitution."
    },
    "requirements": {
      "type": "string",
      "title": "Requirements",
      "description": "PR requirements. From section 'Git Workflow'."
    },
    "strategy": {
      "type": "string",
      "title": "Strategy",
      "description": "Branch strategy. From section 'Git Workflow'."
    },
    "tool": {
      "type": "string",
      "title": "Tool",
      "description": "Formatter. From section 'Formatting'."
    }
  },
  "required": [
    "brief_explanation",
    "db",
    "framework",
    "lang",
    "location",
    "path",
    "pattern",
    "platform",
    "principle_1",
    "principle_2",
    "principle_3",
    "project_name",
    "requirements",
    "strategy",
    "tool"
  ],
  "x-faion-dictionary-refs": 1
}
