    },
    "action": {
      "type": "string",
      "title": "Action",
      "description": "When. From section 'Acceptance Criteria'."
    },
    "decision_title": {
      "type": "string",
      "title": "Decision title",
      "description": "AD-X. From section 'Architecture Decisions'."
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "CREATE. From section 'Files to Change'."
    },
    "error_handling": {
      "type": "string",
      "title": "Error handling",
      "description": "Then. From section 'Acceptance Criteria'."
    },
    "error_scenario": {
      "type": "string",
      "title": "Error scenario",
      "description": "AC-2. From section 'Acceptance Criteria'."
    },
    "expected_result": {
      "type": "string",
      "title": "Expected result",
      "description": "Then. From section 'Acceptance Criteria'."
    },
    "feature_nnn_name": {
      "type": "string",
      "title": "Feature nnn name",
      "description": "Feature. From section 'Metadata'."
    },
    "fs": {
      "type": "string",
      "title": "Fs",
      "description": "TASK YYY. From section 'Dependencies'."
    },
    "precondition": {
      "type": "string",
      "title": "Precondition",
      "description": "Given. From section 'Acceptance Criteria'."
    },
    "reason": {
      "type": "string",
      "title": "Reason",
      "description": "TASK YYY. From section 'Dependencies'."
    },
    "relevant_sections": {
      "type": "string",
      "title": "Relevant sections",
      "description": "Constitution. From section 'SDD References'."
