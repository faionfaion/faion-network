  "required": [
    "achievement_1",
    "action",
    "decision_title",
    "description",
    "error_handling",
    "error_scenario",
    "expected_result",
    "feature_nnn_name",
    "fs",
    "precondition",
    "reason",
    "relevant_sections",
    "requirement_title",
    "scenario_name",
    "skill",
