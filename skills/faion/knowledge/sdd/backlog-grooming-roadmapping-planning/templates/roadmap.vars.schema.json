{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/backlog-grooming-roadmapping-planning/roadmap.vars.schema.json",
  "title": "roadmap template variables",
  "description": "Values for templates/roadmap.md.j2 and templates/roadmap.html.j2. Generated by tpl-jinja from roadmap.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "dependency": {
      "type": "string",
      "title": "Dependency",
      "description": "The dependency used under 'Dependencies'."
    },
    "item": {
      "type": "string",
      "title": "Item",
      "description": "The item used under 'Dependencies'."
    },
    "item_1": {
      "type": "string",
      "title": "Item 1",
      "description": "The item 1 used under 'Not Planned'."
    },
    "level": {
      "type": "string",
      "title": "Level",
      "description": "The level used under 'Dependencies'."
    },
    "milestone_name": {
      "type": "string",
      "title": "Milestone name",
      "description": "The milestone name used under 'Now (Current Quarter)'."
    },
    "month": {
      "type": "string",
      "title": "Month",
      "description": "Target."
    },
    "product_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/product_name"
        }
      ],
      "description": "Product Roadmap."
    },
    "theme_name": {
      "type": "string",
      "title": "Theme name",
      "description": "The theme name used under 'Later (6-12 months)'."
    },
    "what_changed": {
      "type": "string",
      "title": "What changed",
      "description": "YYYY-MM-DD. From section 'Change Log'."
    },
    "x_months": {
      "type": "string",
      "title": "X months",
      "description": "Time Horizon. From section 'Product Roadmap'."
    }
  },
  "required": [
    "dependency",
    "item",
    "item_1",
    "level",
    "milestone_name",
    "month",
    "product_name",
    "theme_name",
    "what_changed",
    "x_months"
  ],
  "x-faion-dictionary-refs": 1
}
