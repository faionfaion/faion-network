{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/backlog-grooming-roadmapping-planning/grooming-session.vars.schema.json",
  "title": "grooming-session template variables",
  "description": "Values for templates/grooming-session.md.j2 and templates/grooming-session.html.j2. Generated by tpl-jinja from grooming-session.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "title": "Action",
      "description": "The action used under 'Action Items'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "Due. From section 'Action Items'."
    },
    "reason": {
      "type": "string",
      "title": "Reason",
      "description": "BL. From section 'Priority Changes'."
    },
    "what_changed": {
      "type": "string",
      "title": "What changed",
      "description": "BL. From section 'Items Refined'."
    },
    "why_archived": {
      "type": "string",
      "title": "Why archived",
      "description": "BL. From section 'Items Archived'."
    },
    "x_minutes": {
      "type": "string",
      "title": "X minutes",
      "description": "Duration. From section 'Backlog Grooming'."
    }
  },
  "required": [
    "action",
    "date",
    "reason",
    "what_changed",
    "why_archived",
    "x_minutes"
  ],
  "x-faion-dictionary-refs": 0
}
