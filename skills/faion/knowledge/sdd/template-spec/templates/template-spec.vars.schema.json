{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/template-spec/template-spec.vars.schema.json",
  "title": "template-spec template variables",
  "description": "Values for templates/template-spec.md.j2 and templates/template-spec.html.j2. Generated by tpl-jinja from template-spec.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artefact_slug": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/artefact_slug"
    },
    "decision": {
      "type": "string",
      "title": "Decision",
      "description": "The decision used under 'Template Spec'.",
      "enum": [
        "go",
        "hold",
        "no-op"
      ]
    },
    "input_name": {
      "type": "string",
      "title": "Input name",
      "description": "The input name used under 'Template Spec'."
    },
    "owner_handle": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_handle"
    }
  },
  "required": [
    "artefact_slug",
    "decision",
    "input_name"
  ],
  "x-faion-dictionary-refs": 2
}
