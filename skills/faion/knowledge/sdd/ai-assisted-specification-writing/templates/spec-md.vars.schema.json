{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/ai-assisted-specification-writing/spec-md.vars.schema.json",
  "title": "spec-md template variables",
  "description": "Values for templates/spec-md.md.j2 and templates/spec-md.html.j2. Generated by tpl-jinja from spec-md.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "baseline": {
      "type": "string",
      "title": "Baseline",
      "description": "The baseline used under 'Success Metrics'."
    },
    "behavior": {
      "type": "string",
      "title": "Behavior",
      "description": "EC-1. From section 'Edge Cases'."
    },
    "benefit": {
      "type": "string",
      "title": "Benefit",
      "description": "So that. From section 'US-1'."
    },
    "list": {
      "type": "string",
      "title": "List",
      "description": "Stakeholders. From section 'Metadata'."
    },
    "metric": {
      "type": "string",
      "title": "Metric",
      "description": "The metric used under 'Success Metrics'."
    },
    "mitigation": {
      "type": "string",
      "title": "Mitigation",
      "description": "High/Med/Low High/Med/Low. From section 'Risks'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Author. From section 'Metadata'."
    },
    "primary_goal": {
      "type": "string",
      "title": "Primary goal",
      "description": "1. From section 'Goals'."
    },
    "question_needing_resolution": {
      "type": "string",
      "title": "Question needing resolution",
      "description": "The question needing resolution used under 'Open Questions'."
    },
    "requirement_title": {
      "type": "string",
      "title": "Requirement title",
      "description": "FR-1. From section 'Functional Requirements'."
    },
    "risk": {
      "type": "string",
      "title": "Risk",
      "description": "The risk used under 'Risks'."
    },
    "scenario": {
      "type": "string",
      "title": "Scenario",
      "description": "EC-1. From section 'Edge Cases'."
    },
    "secondary_goal": {
      "type": "string",
      "title": "Secondary goal",
      "description": "2. From section 'Goals'."
    },
    "service": {
      "type": "string",
      "title": "Service",
      "description": "The service used under 'Dependencies'."
    },
    "story_title": {
      "type": "string",
      "title": "Story title",
      "description": "US-1. From section 'User Stories'."
    },
    "target": {
      "type": "string",
      "title": "Target",
      "description": "The target used under 'Success Metrics'."
    },
    "user_type": {
      "type": "string",
      "title": "User type",
      "description": "As a. From section 'US-1'."
    }
  },
  "required": [
    "baseline",
    "behavior",
    "benefit",
    "list",
    "metric",
    "mitigation",
    "name",
    "primary_goal",
    "question_needing_resolution",
    "requirement_title",
    "risk",
    "scenario",
    "secondary_goal",
    "story_title",
    "target",
    "user_type"
  ],
  "x-faion-dictionary-refs": 0
}
