{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/living-documentation/living-documentation.vars.schema.json",
  "title": "living-documentation template variables",
  "description": "Values for templates/living-documentation.md.j2 and templates/living-documentation.html.j2. Generated by tpl-jinja from living-documentation.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artefact_id": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/artefact_id"
        }
      ],
      "description": "Living Documentation."
    },
    "document_version": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/document_version"
    },
    "last_reviewed_date": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/last_reviewed_date"
    },
    "owner_full_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_full_name"
    }
  },
  "required": [
    "artefact_id",
    "last_reviewed_date"
  ],
  "x-faion-dictionary-refs": 4
}
