{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/task-creation-template-guide/task-template.vars.schema.json",
  "title": "task-template template variables",
  "description": "Values for templates/task-template.md.j2 and templates/task-template.html.j2. Generated by tpl-jinja from task-template.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "achievement_1": {
      "type": "string",
      "title": "Achievement 1",
      "description": "The achievement 1 used under 'Summary'."
    },
    "achievement_2": {
      "type": "string",
      "title": "Achievement 2",
      "description": "The achievement 2 used under 'Summary'."
    },
    "action": {
      "type": "string",
      "title": "Action",
      "description": "When. From section 'Acceptance Criteria'."
    },
    "concrete_action": {
      "type": "string",
      "title": "Concrete action",
      "description": "Low/Med/High Low/Med/High. From section 'Risks and Mitigations'."
    },
    "critical_code_snippet": {
      "type": "string",
      "title": "Critical code snippet",
      "description": "The critical code snippet used under 'Task Dependency Tree'."
    },
    "decision_title": {
      "type": "string",
      "title": "Decision title",
      "description": "AD-X. From section 'FR-X'."
    },
    "expected_result": {
      "type": "string",
      "title": "Expected result",
      "description": "Then. From section 'Acceptance Criteria'."
    },
    "explicit_exclusion_2": {
      "type": "string",
      "title": "Explicit exclusion 2",
      "description": "The explicit exclusion 2 used under 'Out of Scope'."
    },
    "feature": {
      "type": "string",
      "title": "Feature",
      "description": "The feature used under 'Metadata'."
    },
    "fs": {
      "type": "string",
      "title": "Fs",
      "description": "TASK YYY. From section 'Dependencies'."
    },
    "precondition": {
      "type": "string",
      "title": "Precondition",
      "description": "Given. From section 'Acceptance Criteria'."
    },
    "project": {
      "type": "string",
      "title": "Project",
      "description": "The project used under 'Metadata'."
    },
    "reason": {
      "type": "string",
      "title": "Reason",
      "description": "TASK YYY. From section 'Dependencies'."
    },
    "requirement_title": {
      "type": "string",
      "title": "Requirement title",
      "description": "FR-X. From section 'Requirements Coverage'."
    },
    "reusable_pattern_discovered": {
      "type": "string",
      "title": "Reusable pattern discovered",
      "description": "The reusable pattern discovered used under 'Lessons Learned'."
    },
    "risk": {
      "type": "string",
      "title": "Risk",
      "description": "The risk used under 'Risks and Mitigations'."
    },
    "scenario_name": {
      "type": "string",
      "title": "Scenario name",
      "description": "AC-1. From section 'Acceptance Criteria'."
    },
    "skill": {
      "type": "string",
      "title": "Skill",
      "description": "Faion. From section 'Recommended Skills'."
    },
    "title": {
      "type": "string",
      "title": "Title",
      "description": "TASK XXX."
    },
    "what_changes": {
      "type": "string",
      "title": "What changes",
      "description": "MODIFY. From section 'Files to Change'."
    }
  },
  "required": [
    "achievement_1",
    "achievement_2",
    "action",
    "concrete_action",
    "critical_code_snippet",
    "decision_title",
    "expected_result",
    "explicit_exclusion_2",
    "feature",
    "fs",
    "precondition",
    "project",
    "reason",
    "requirement_title",
    "reusable_pattern_discovered",
    "risk",
    "scenario_name",
    "skill",
    "title",
    "what_changes"
  ],
  "x-faion-dictionary-refs": 0
}
