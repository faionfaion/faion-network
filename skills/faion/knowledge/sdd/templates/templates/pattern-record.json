{
  "__faion_header__": {
    "purpose": "Pattern record: a reusable solution captured after it worked twice, with context and evidence",
    "consumes": "see AGENTS.md Prerequisites",
    "produces": "spec",
    "depends-on": "content/01-core-rules.xml",
    "token-budget-impact": "~150 tokens when loaded as context"
  },
  "id": "PAT-{NNN}",
  "timestamp": "YYYY-MM-DDTHH:MM:SSZ",
  "project": "{project}",
  "task_type": "{type}",
  "pattern_name": "{name}",
  "description": "{what worked}",
  "context": "{when to use}",
  "code_example": "{code snippet or empty string}",
  "success_count": 1,
  "tags": [
    "tag1",
    "tag2"
  ]
}
