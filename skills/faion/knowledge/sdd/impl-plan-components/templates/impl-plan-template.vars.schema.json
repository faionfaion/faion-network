{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/impl-plan-components/impl-plan-template.vars.schema.json",
  "title": "impl-plan-template template variables",
  "description": "Values for templates/impl-plan-template.md.j2 and templates/impl-plan-template.html.j2. Generated by tpl-jinja from impl-plan-template.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "author_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/author_name"
        }
      ],
      "description": "Author. From section 'Implementation Plan'."
    },
    "concrete_action": {
      "type": "string",
      "title": "Concrete action",
      "description": "Low/Med/High Low/Med/High. From section 'Risk Assessment'."
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "CREATE. From section 'TASK-001'."
    },
    "feature_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/feature_name"
        }
      ],
      "description": "Implementation Plan."
    },
    "project_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/project_name"
        }
      ],
      "description": "Project. From section 'Implementation Plan'."
    },
    "risk": {
      "type": "string",
      "title": "Risk",
      "description": "The risk used under 'Risk Assessment'."
    },
    "task_title": {
      "type": "string",
      "title": "Task title",
      "description": "TASK-001. From section 'Phase 1'."
    },
    "verifiable_condition_1": {
      "type": "string",
      "title": "Verifiable condition 1",
      "description": "The verifiable condition 1 used under 'TASK-001'."
    },
    "verifiable_condition_2": {
      "type": "string",
      "title": "Verifiable condition 2",
      "description": "The verifiable condition 2 used under 'TASK-001'."
    }
  },
  "required": [
    "concrete_action",
    "description",
    "feature_name",
    "project_name",
    "risk",
    "task_title",
    "verifiable_condition_1",
    "verifiable_condition_2"
  ],
  "x-faion-dictionary-refs": 3
}
