{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/impl-plan-task-format/task-template.vars.schema.json",
  "title": "task-template template variables",
  "description": "Values for templates/task-template.md.j2 and templates/task-template.html.j2. Generated by tpl-jinja from task-template.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ad": {
      "type": "integer",
      "title": "Ad",
      "description": "The ad used under 'TASK'."
    },
    "another_specific_criterion": {
      "type": "string",
      "title": "Another specific criterion",
      "description": "The another specific criterion used under 'TASK'."
    },
    "fr": {
      "type": "integer",
      "title": "Fr",
      "description": "The fr used under 'TASK'."
    },
    "fs": {
      "type": "string",
      "title": "Fs",
      "description": "Depends on. From section 'TASK'."
    },
    "modify": {
      "type": "string",
      "title": "Modify",
      "description": "The modify used under 'TASK'.",
      "enum": [
        "what to add",
        "change"
      ]
    },
    "phase": {
      "type": "integer",
      "title": "Phase",
      "description": "The phase used under 'TASK'."
    },
    "specific_test_description": {
      "type": "string",
      "title": "Specific test description",
      "description": "Unit. From section 'TASK'."
    },
    "ss": {
      "type": "string",
      "title": "Ss",
      "description": "Depends on. From section 'TASK'."
    },
    "wave": {
      "type": "integer",
      "title": "Wave",
      "description": "The wave used under 'TASK'."
    }
  },
  "required": [
    "ad",
    "another_specific_criterion",
    "fr",
    "fs",
    "modify",
    "phase",
    "specific_test_description",
    "ss",
    "wave"
  ],
  "x-faion-dictionary-refs": 0
}
