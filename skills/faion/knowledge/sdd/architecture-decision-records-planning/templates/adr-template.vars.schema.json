{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/architecture-decision-records-planning/adr-template.vars.schema.json",
  "title": "adr-template template variables",
  "description": "Values for templates/adr-template.md.j2 and templates/adr-template.html.j2. Generated by tpl-jinja from adr-template.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "adr": {
      "type": "integer",
      "title": "Adr",
      "description": "The adr used under 'Related Decisions'."
    },
    "benefit_2": {
      "type": "string",
      "title": "Benefit 2",
      "description": "The benefit 2 used under 'Positive'."
    },
    "benefits": {
      "type": "string",
      "title": "Benefits",
      "description": "Pros. From section 'Alternative 1'."
    },
    "deciders": {
      "type": "string",
      "title": "Deciders",
      "description": "The deciders used under 'ADR'.",
      "enum": [
        "List of people",
        "roles involved"
      ]
    },
    "decision_title": {
      "type": "string",
      "title": "Decision title",
      "description": "ADR."
    },
    "drawbacks": {
      "type": "string",
      "title": "Drawbacks",
      "description": "Cons. From section 'Alternative 1'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Alternative 1. From section 'Alternatives Considered'."
    },
    "related_decision_title": {
      "type": "string",
      "title": "Related decision title",
      "description": "ADR. From section 'Related Decisions'."
    },
    "specific_reason": {
      "type": "string",
      "title": "Specific reason",
      "description": "Why rejected. From section 'Alternative 1'."
    },
    "status": {
      "type": "integer",
      "title": "Status",
      "description": "The status used under 'ADR'."
    }
  },
  "required": [
    "adr",
    "benefit_2",
    "benefits",
    "deciders",
    "decision_title",
    "drawbacks",
    "name",
    "related_decision_title",
    "specific_reason",
    "status"
  ],
  "x-faion-dictionary-refs": 0
}
