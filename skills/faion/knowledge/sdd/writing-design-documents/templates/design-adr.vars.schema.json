{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/writing-design-documents/design-adr.vars.schema.json",
  "title": "design-adr template variables",
  "description": "Values for templates/design-adr.md.j2 and templates/design-adr.html.j2. Generated by tpl-jinja from design-adr.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "adr": {
      "type": "integer",
      "title": "Adr",
      "description": "The adr used under 'Related'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'ADR'."
    },
    "decision_title": {
      "type": "string",
      "title": "Decision title",
      "description": "ADR."
    },
    "related_decision": {
      "type": "string",
      "title": "Related decision",
      "description": "ADR. From section 'Related'."
    },
    "relevant_section": {
      "type": "string",
      "title": "Relevant section",
      "description": "Constitution section. From section 'Related'."
    },
    "status": {
      "type": "integer",
      "title": "Status",
      "description": "The status used under 'ADR'."
    },
    "what_becomes_harder": {
      "type": "string",
      "title": "What becomes harder",
      "description": "The what becomes harder used under 'Consequences'."
    }
  },
  "required": [
    "adr",
    "date",
    "decision_title",
    "related_decision",
    "relevant_section",
    "status",
    "what_becomes_harder"
  ],
  "x-faion-dictionary-refs": 0
}
