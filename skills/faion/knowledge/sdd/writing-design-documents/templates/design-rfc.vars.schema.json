{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/writing-design-documents/design-rfc.vars.schema.json",
  "title": "design-rfc template variables",
  "description": "Values for templates/design-rfc.md.j2 and templates/design-rfc.html.j2. Generated by tpl-jinja from design-rfc.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "author_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/author_name"
    },
    "created": {
      "type": "string",
      "title": "Created",
      "description": "The created used under 'RFC'."
    },
    "last_updated": {
      "type": "string",
      "title": "Last updated",
      "description": "The last updated used under 'RFC'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Alternative A. From section 'Alternatives Considered'."
    },
    "supersedes": {
      "type": "integer",
      "title": "Supersedes",
      "description": "The supersedes used under 'RFC'."
    },
    "title": {
      "type": "string",
      "title": "Title",
      "description": "RFC."
    },
    "unresolved_question": {
      "type": "string",
      "title": "Unresolved question",
      "description": "2. From section 'Open Questions'."
    },
    "what": {
      "type": "string",
      "title": "What",
      "description": "Phase 1. From section 'Implementation Plan'."
    }
  },
  "required": [
    "created",
    "last_updated",
    "name",
    "supersedes",
    "title",
    "unresolved_question",
    "what"
  ],
  "x-faion-dictionary-refs": 1
}
