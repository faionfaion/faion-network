{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/writing-design-documents/design-tdd.vars.schema.json",
  "title": "design-tdd template variables",
  "description": "Values for templates/design-tdd.md.j2 and templates/design-tdd.html.j2. Generated by tpl-jinja from design-tdd.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "author_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/author_name"
    },
    "choice": {
      "type": "string",
      "title": "Choice",
      "description": "The choice used under 'Trade-offs'."
    },
    "external_reference": {
      "type": "string",
      "title": "External reference",
      "description": "The external reference used under 'References'."
    },
    "other_option": {
      "type": "string",
      "title": "Other option",
      "description": "The other option used under 'Trade-offs'."
    },
    "owner": {
      "type": "string",
      "title": "Owner",
      "description": "The owner used under 'Open Questions'."
    },
    "question": {
      "type": "string",
      "title": "Question",
      "description": "The question used under 'Open Questions'."
    },
    "rationale": {
      "type": "string",
      "title": "Rationale",
      "description": "The rationale used under 'Trade-offs'."
    },
    "review_deadline": {
      "type": "string",
      "title": "Review deadline",
      "description": "The review deadline used under 'Technical Design Document'."
    }
  },
  "required": [
    "choice",
    "external_reference",
    "other_option",
    "owner",
    "question",
    "rationale",
    "review_deadline"
  ],
  "x-faion-dictionary-refs": 1
}
