{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/workflows-planning/route-record.vars.schema.json",
  "title": "route-record template variables",
  "description": "Values for templates/route-record.md.j2 and templates/route-record.html.j2. Generated by tpl-jinja from route-record.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "feature": {
      "type": "string",
      "title": "Feature",
      "description": "Artefact id."
    },
    "missing_draft_accepted": {
      "type": "string",
      "title": "Missing draft accepted",
      "description": "Spec."
    },
    "owner_email": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_email"
        }
      ],
      "description": "Owner."
    },
    "owner_full_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_full_name"
        }
      ],
      "description": "Owner."
    },
    "path": {
      "type": "string",
      "title": "Path",
      "description": "Next methodology to dispatch. From section 'SDD Phase Route'."
    },
    "phase": {
      "type": "string",
      "title": "Phase",
      "description": "Active phase. From section 'SDD Phase Route'."
    },
    "phase_methodology": {
      "type": "string",
      "title": "Phase methodology",
      "description": "Next methodology."
    },
    "status": {
      "type": "string",
      "title": "Status",
      "description": "Feature dir."
    }
  },
  "required": [
    "feature",
    "missing_draft_accepted",
    "owner_email",
    "owner_full_name",
    "path",
    "phase",
    "phase_methodology",
    "status"
  ],
  "x-faion-dictionary-refs": 2
}
