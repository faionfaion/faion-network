{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/pattern-memory/pattern-memory.vars.schema.json",
  "title": "pattern-memory template variables",
  "description": "Values for templates/pattern-memory.md.j2 and templates/pattern-memory.html.j2. Generated by tpl-jinja from pattern-memory.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artefact_id": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/artefact_id"
        }
      ],
      "description": "Pattern Memory."
    },
    "document_version": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/document_version"
        }
      ],
      "description": "Version (string). From section 'Pattern Memory'."
    },
    "last_reviewed_date": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/last_reviewed_date"
        }
      ],
      "description": "Last reviewed (date). From section 'Pattern Memory'."
    },
    "named_author": {
      "type": "string",
      "title": "Named author",
      "description": "Owner (string). From section 'Pattern Memory'."
    },
    "pattern_name": {
      "type": "string",
      "title": "Pattern name",
      "description": "Title (string). From section 'Pattern Memory'."
    }
  },
  "required": [
    "artefact_id",
    "last_reviewed_date",
    "named_author",
    "pattern_name"
  ],
  "x-faion-dictionary-refs": 3
}
