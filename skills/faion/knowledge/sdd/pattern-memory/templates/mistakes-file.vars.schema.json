{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/pattern-memory/mistakes-file.vars.schema.json",
  "title": "mistakes-file template variables",
  "description": "Values for templates/mistakes-file.md.j2 and templates/mistakes-file.html.j2. Generated by tpl-jinja from mistakes-file.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "detection_method": {
      "type": "string",
      "title": "Detection method",
      "description": "Detection."
    },
    "feature_nnn_name": {
      "type": "string",
      "title": "Feature nnn name",
      "description": "First seen."
    },
    "fix_description": {
      "type": "string",
      "title": "Fix description",
      "description": "Fix."
    },
    "mistake_name": {
      "type": "string",
      "title": "Mistake name",
      "description": "The mistake name used under 'Mistakes'."
    },
    "updated": {
      "type": "string",
      "title": "Updated",
      "description": "The updated used under 'Mistakes'."
    }
  },
  "required": [
    "detection_method",
    "feature_nnn_name",
    "fix_description",
    "mistake_name",
    "updated"
  ],
  "x-faion-dictionary-refs": 0
}
