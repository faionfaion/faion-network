{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/workflow-design-phase/design.vars.schema.json",
  "title": "design template variables",
  "description": "Values for templates/design.md.j2 and templates/design.html.j2. Generated by tpl-jinja from design.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decision_headline": {
      "type": "string",
      "title": "Decision headline",
      "description": "AD. From section 'Architectural Decisions'."
    },
    "feature": {
      "type": "string",
      "title": "Feature",
      "description": "Artefact id."
    },
    "option_b": {
      "type": "string",
      "title": "Option b",
      "description": "Rejected. From section 'AD'."
    },
    "owner_email": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_email"
    },
    "owner_full_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_full_name"
    },
    "pattern_observed": {
      "type": "string",
      "title": "Pattern observed",
      "description": "The pattern observed used under 'Codebase Survey'."
    },
    "status": {
      "type": "string",
      "title": "Status",
      "description": "Spec ref."
    },
    "verb": {
      "type": "string",
      "title": "Verb",
      "description": "The verb used under 'API Contracts'."
    }
  },
  "required": [
    "decision_headline",
    "feature",
    "option_b",
    "pattern_observed",
    "status",
    "verb"
  ],
  "x-faion-dictionary-refs": 2
}
