{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/spec-advanced-guidelines/spec-full-template.vars.schema.json",
  "title": "spec-full-template template variables",
  "description": "Values for templates/spec-full-template.md.j2 and templates/spec-full-template.html.j2. Generated by tpl-jinja from spec-full-template.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "behavior": {
      "type": "string",
      "title": "Behavior",
      "description": "Requirement. From section 'NFR-001'."
    },
    "edge_case": {
      "type": "string",
      "title": "Edge case",
      "description": "AC-003. From section 'AC-002'."
    },
    "error_case": {
      "type": "string",
      "title": "Error case",
      "description": "AC-002. From section 'AC-001'."
    },
    "feature": {
      "type": "string",
      "title": "Feature",
      "description": "Requirement. From section 'NFR-001'."
    },
    "feature_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/feature_name"
    },
    "happy_path": {
      "type": "string",
      "title": "Happy path",
      "description": "AC-001. From section 'Acceptance Criteria'."
    },
    "high_level_approach": {
      "type": "string",
      "title": "High level approach",
      "description": "Solution. From section 'Problem Statement'."
    },
    "impact": {
      "type": "string",
      "title": "Impact",
      "description": "The impact used under 'Problem Statement'.",
      "enum": [
        "business",
        "user cost if unsolved"
      ]
    },
    "nfr_name": {
      "type": "string",
      "title": "Nfr name",
      "description": "NFR-001. From section 'Non-Functional Requirements'."
    },
    "persona_1": {
      "type": "string",
      "title": "Persona 1",
      "description": "US-001. From section 'User Stories'."
    },
    "persona_2": {
      "type": "string",
      "title": "Persona 2",
      "description": "US-002. From section 'User Stories'."
    },
    "quantifiable_target": {
      "type": "string",
      "title": "Quantifiable target",
      "description": "Requirement. From section 'NFR-001'."
    },
    "target_user_group": {
      "type": "string",
      "title": "Target user group",
      "description": "Who. From section 'Problem Statement'."
    },
    "test_method": {
      "type": "string",
      "title": "Test method",
      "description": "Validation. From section 'NFR-001'."
    }
  },
  "required": [
    "behavior",
    "edge_case",
    "error_case",
    "feature",
    "feature_name",
    "happy_path",
    "high_level_approach",
    "impact",
    "nfr_name",
    "persona_1",
    "persona_2",
    "quantifiable_target",
    "target_user_group",
    "test_method"
  ],
  "x-faion-dictionary-refs": 1
}
