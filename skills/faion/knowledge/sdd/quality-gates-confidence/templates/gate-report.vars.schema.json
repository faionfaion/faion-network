{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/quality-gates-confidence/gate-report.vars.schema.json",
  "title": "gate-report template variables",
  "description": "Values for templates/gate-report.md.j2 and templates/gate-report.html.j2. Generated by tpl-jinja from gate-report.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "check_name": {
      "type": "string",
      "title": "Check name",
      "description": "The check name used under 'Failures'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Gate Report'."
    },
    "design_implementation_merge": {
      "type": "string",
      "title": "Design implementation merge",
      "description": "Phase. From section 'Gate Report'."
    },
    "title": {
      "type": "string",
      "title": "Title",
      "description": "Task. From section 'Gate Report'."
    }
  },
  "required": [
    "check_name",
    "date",
    "design_implementation_merge",
    "title"
  ],
  "x-faion-dictionary-refs": 0
}
