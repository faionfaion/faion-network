    },
    "explicit_exclusion": {
      "type": "string",
      "title": "Explicit exclusion",
      "description": "The explicit exclusion used under 'Out of Scope'."
    },
    "measurable_outcome": {
      "type": "string",
      "title": "Measurable outcome",
      "description": "1. From section 'Goals'."
    },
    "precondition": {
      "type": "string",
      "title": "Precondition",
      "description": "Given. From section 'FR-1'."
    },
    "result": {
      "type": "string",
      "title": "Result",
      "description": "Then. From section 'FR-1'."
    },
    "title": {
      "type": "string",
      "title": "Title",
      "description": "FR-1. From section 'Requirements'."
    }
  },
  "required": [
    "action",
    "explicit_exclusion",
    "measurable_outcome",
    "precondition",
    "result",
    "title"
  ],
  "x-faion-dictionary-refs": 0
