{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/writing-specifications/spec-full.vars.schema.json",
  "title": "spec-full template variables",
  "description": "Values for templates/spec-full.md.j2 and templates/spec-full.html.j2. Generated by tpl-jinja from spec-full.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "title": "Action",
      "description": "When. From section 'FR-1'."
    },
    "business_constraint": {
      "type": "string",
      "title": "Business constraint",
      "description": "The business constraint used under 'Constraints'."
    },
    "error_handling_result": {
      "type": "string",
      "title": "Error handling result",
      "description": "Then. From section 'FR-2'."
    },
    "error_precondition": {
      "type": "string",
      "title": "Error precondition",
      "description": "Given. From section 'FR-2'."
    },
    "feature_nnn_name": {
      "type": "string",
      "title": "Feature nnn name",
      "description": "Feature. From section 'Metadata'."
    },
    "full_description": {
      "type": "string",
      "title": "Full description",
      "description": "The full description used under 'FR-2'."
    },
    "person_role": {
      "type": "string",
      "title": "Person role",
      "description": "The person role used under 'Open Questions'."
    },
    "precondition": {
      "type": "string",
      "title": "Precondition",
      "description": "Given. From section 'FR-1'."
    },
    "problem": {
      "type": "string",
      "title": "Problem",
      "description": "The problem used under 'Problem Statement'.",
      "enum": [
        "what is broken",
        "missing"
      ]
    },
    "requirement_title": {
      "type": "string",
      "title": "Requirement title",
      "description": "FR-1. From section 'Functional Requirements'."
    },
    "verifiable_result": {
      "type": "string",
      "title": "Verifiable result",
      "description": "Then. From section 'FR-1'."
    },
    "why_excluded": {
      "type": "string",
      "title": "Why excluded",
      "description": "The why excluded used under 'Out of Scope'."
    }
  },
  "required": [
    "action",
    "business_constraint",
    "error_handling_result",
    "error_precondition",
    "feature_nnn_name",
    "full_description",
    "person_role",
    "precondition",
    "problem",
    "requirement_title",
    "verifiable_result",
    "why_excluded"
  ],
  "x-faion-dictionary-refs": 0
}
