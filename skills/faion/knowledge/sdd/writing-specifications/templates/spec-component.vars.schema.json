{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/writing-specifications/spec-component.vars.schema.json",
  "title": "spec-component template variables",
  "description": "Values for templates/spec-component.md.j2 and templates/spec-component.html.j2. Generated by tpl-jinja from spec-component.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "behavior_title": {
      "type": "string",
      "title": "Behavior title",
      "description": "FR-1. From section 'Behavior'."
    },
    "callback_description": {
      "type": "string",
      "title": "Callback description",
      "description": "OnAction. From section 'Props / Interface'."
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "Default. From section 'States'."
    },
    "expected_result": {
      "type": "string",
      "title": "Expected result",
      "description": "Then. From section 'FR-1'."
    },
    "keyboard": {
      "type": "string",
      "title": "Keyboard",
      "description": "The keyboard used under 'Accessibility'.",
      "enum": [
        "Tab",
        "Enter",
        "Escape behavior"
      ]
    },
    "precondition": {
      "type": "string",
      "title": "Precondition",
      "description": "Given. From section 'FR-1'."
    },
    "unresolved_design_question": {
      "type": "string",
      "title": "Unresolved design question",
      "description": "The unresolved design question used under 'Open Questions'."
    },
    "user_action": {
      "type": "string",
      "title": "User action",
      "description": "When. From section 'FR-1'."
    },
    "visual_variant": {
      "type": "string",
      "title": "Visual variant",
      "description": "Variant. From section 'Props / Interface'."
    }
  },
  "required": [
    "behavior_title",
    "callback_description",
    "description",
    "expected_result",
    "keyboard",
    "precondition",
    "unresolved_design_question",
    "user_action",
    "visual_variant"
  ],
  "x-faion-dictionary-refs": 0
}
