{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/workflow-spec-phase/spec.vars.schema.json",
  "title": "spec template variables",
  "description": "Values for templates/spec.md.j2 and templates/spec.html.j2. Generated by tpl-jinja from spec.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bounded_statement_1": {
      "type": "string",
      "title": "Bounded statement 1",
      "description": "The bounded statement 1 used under 'In Scope'."
    },
    "bounded_statement_2": {
      "type": "string",
      "title": "Bounded statement 2",
      "description": "The bounded statement 2 used under 'In Scope'."
    },
    "domain_term_1": {
      "type": "string",
      "title": "Domain term 1",
      "description": "The domain term 1 used under 'Glossary'."
    },
    "domain_term_2": {
      "type": "string",
      "title": "Domain term 2",
      "description": "The domain term 2 used under 'Glossary'."
    },
    "domain_term_3": {
      "type": "string",
      "title": "Domain term 3",
      "description": "The domain term 3 used under 'Glossary'."
    },
    "feature": {
      "type": "string",
      "title": "Feature",
      "description": "Artefact id."
    },
    "fr": {
      "type": "integer",
      "title": "Fr",
      "description": "The fr used under 'Functional Requirements'."
    },
    "nfr": {
      "type": "integer",
      "title": "Nfr",
      "description": "The nfr used under 'Non-Functional Requirements'."
    },
    "owner_email": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_email"
        }
      ],
      "description": "Owner."
    },
    "owner_full_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_full_name"
        }
      ],
      "description": "Owner."
    }
  },
  "required": [
    "bounded_statement_1",
    "bounded_statement_2",
    "domain_term_1",
    "domain_term_2",
    "domain_term_3",
    "feature",
    "fr",
    "nfr"
  ],
  "x-faion-dictionary-refs": 2
}
