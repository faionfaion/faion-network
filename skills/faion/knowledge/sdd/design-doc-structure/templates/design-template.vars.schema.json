{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/design-doc-structure/design-template.vars.schema.json",
  "title": "design-template template variables",
  "description": "Values for templates/design-template.md.j2 and templates/design-template.html.j2. Generated by tpl-jinja from design-template.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "approach": {
      "type": "string",
      "title": "Approach",
      "description": "The approach used under 'Performance Considerations'."
    },
    "benefits": {
      "type": "string",
      "title": "Benefits",
      "description": "Positive. From section 'AD-001'."
    },
    "concern": {
      "type": "string",
      "title": "Concern",
      "description": "The concern used under 'Performance Considerations'."
    },
    "critical_user_flow": {
      "type": "string",
      "title": "Critical user flow",
      "description": "The critical user flow used under 'E2E Tests'."
    },
    "decision_title": {
      "type": "string",
      "title": "Decision title",
      "description": "AD-001. From section 'Architectural Decisions'."
    },
    "endpoint": {
      "type": "string",
      "title": "Endpoint",
      "description": "/api/. From section 'API Contracts'."
    },
    "feature_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/feature_name"
    },
    "method": {
      "type": "string",
      "title": "Method",
      "description": "The method used under 'API Contracts'."
    },
    "model_name": {
      "type": "string",
      "title": "Model name",
      "description": "The model name used under 'Data Models'."
    },
    "option_b": {
      "type": "string",
      "title": "Option b",
      "description": "The option b used under 'AD-001'."
    },
    "project_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/project_name"
    },
    "trade_offs": {
      "type": "string",
      "title": "Trade offs",
      "description": "Negative. From section 'AD-001'."
    },
    "what_was_decided": {
      "type": "string",
      "title": "What was decided",
      "description": "Decision. From section 'AD-001'."
    },
    "why": {
      "type": "string",
      "title": "Why",
      "description": "The why used under 'External Services'."
    },
    "why_needed": {
      "type": "string",
      "title": "Why needed",
      "description": "^X.Y.Z. From section 'Packages'."
    }
  },
  "required": [
    "approach",
    "benefits",
    "concern",
    "critical_user_flow",
    "decision_title",
    "endpoint",
    "feature_name",
    "method",
    "model_name",
    "option_b",
    "project_name",
    "trade_offs",
    "what_was_decided",
    "why",
    "why_needed"
  ],
  "x-faion-dictionary-refs": 2
}
