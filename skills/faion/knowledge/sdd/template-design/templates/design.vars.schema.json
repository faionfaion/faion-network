{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/template-design/design.vars.schema.json",
  "title": "design template variables",
  "description": "Values for templates/design.md.j2 and templates/design.html.j2. Generated by tpl-jinja from design.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "author_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/author_name"
        }
      ],
      "description": "Author. From section 'Design'."
    },
    "benefits": {
      "type": "string",
      "title": "Benefits",
      "description": "The benefits used under 'AD-1'."
    },
    "chosen_solution": {
      "type": "string",
      "title": "Chosen solution",
      "description": "Decision. From section 'AD-1'."
    },
    "component": {
      "type": "string",
      "title": "Component",
      "description": "The component used under 'Unit Tests'."
    },
    "component_b": {
      "type": "string",
      "title": "Component b",
      "description": "→ validate →. From section 'Data Flow'."
    },
    "component_c": {
      "type": "string",
      "title": "Component c",
      "description": "→ validate → → process →. From section 'Data Flow'."
    },
    "decision_name": {
      "type": "string",
      "title": "Decision name",
      "description": "AD-1. From section 'Architecture Decisions'."
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "Test integration.py. From section 'Integration Tests'."
    },
    "drawbacks": {
      "type": "string",
      "title": "Drawbacks",
      "description": "A: — Pros. From section 'AD-1'."
    },
    "feature_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/feature_name"
        }
      ],
      "description": "Design."
    },
    "flow": {
      "type": "string",
      "title": "Flow",
      "description": "The flow used under 'Integration Tests'."
    },
    "id": {
      "type": "string",
      "title": "Id",
      "description": "GET. From section 'API Endpoints'."
    },
    "mitigation": {
      "type": "string",
      "title": "Mitigation",
      "description": "High/Med/Low High/Med/Low. From section 'Risks'."
    },
    "model_name": {
      "type": "string",
      "title": "Model name",
      "description": "The model name used under 'Data Models'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Component 1. From section 'Components'."
    },
    "option": {
      "type": "string",
      "title": "Option",
      "description": "The option used under 'AD-1'."
    },
    "path": {
      "type": "string",
      "title": "Path",
      "description": "Location. From section 'Component 1'."
    },
    "risk": {
      "type": "string",
      "title": "Risk",
      "description": "The risk used under 'Risks'."
    },
    "target": {
      "type": "string",
      "title": "Target",
      "description": "Test .py. From section 'Unit Tests'."
    },
    "trade_offs": {
      "type": "string",
      "title": "Trade offs",
      "description": "Negative. From section 'AD-1'."
    }
  },
  "required": [
    "benefits",
    "chosen_solution",
    "component",
    "component_b",
    "component_c",
    "decision_name",
    "description",
    "drawbacks",
    "feature_name",
    "flow",
    "id",
    "mitigation",
    "model_name",
    "name",
    "option",
    "path",
    "risk",
    "target",
    "trade_offs"
  ],
  "x-faion-dictionary-refs": 2
}
