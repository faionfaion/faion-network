{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/sdd/template-design/template-design.vars.schema.json",
  "title": "template-design template variables",
  "description": "Values for templates/template-design.md.j2 and templates/template-design.html.j2. Generated by tpl-jinja from template-design.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artefact_slug": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/artefact_slug"
        }
      ],
      "description": "Artefact id. From section 'Template Design'."
    },
    "decision": {
      "type": "string",
      "title": "Decision",
      "description": "The decision used under 'Template Design'.",
      "enum": [
        "go",
        "hold",
        "no-op"
      ]
    },
    "input_name": {
      "type": "string",
      "title": "Input name",
      "description": "The input name used under 'Template Design'."
    },
    "owner_handle": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_handle"
        }
      ],
      "description": "Owner. From section 'Template Design'."
    }
  },
  "required": [
    "artefact_slug",
    "decision",
    "input_name",
    "owner_handle"
  ],
  "x-faion-dictionary-refs": 2
}
