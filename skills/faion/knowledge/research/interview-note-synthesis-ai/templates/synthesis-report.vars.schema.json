{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/research/interview-note-synthesis-ai/synthesis-report.vars.schema.json",
  "title": "synthesis-report template variables",
  "description": "Values for templates/synthesis-report.md.j2 and templates/synthesis-report.html.j2. Generated by tpl-jinja from synthesis-report.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cohort": {
      "type": "integer",
      "title": "Cohort",
      "description": "The cohort used under 'Interview Synthesis'."
    },
    "label": {
      "type": "string",
      "title": "Label",
      "description": "T1. From section 'Themes'."
    },
    "research_question": {
      "type": "string",
      "title": "Research question",
      "description": "Interview Synthesis."
    }
  },
  "required": [
    "cohort",
    "label",
    "research_question"
  ],
  "x-faion-dictionary-refs": 0
}
