{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/research/market-research-tam-sam-som/quick-market-check.vars.schema.json",
  "title": "quick-market-check template variables",
  "description": "Values for templates/quick-market-check.md.j2 and templates/quick-market-check.html.j2. Generated by tpl-jinja from quick-market-check.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "customer_count_source": {
      "type": "string",
      "title": "Customer count source",
      "description": "The customer count source used under 'SOM (Reality check, ~5 min)'.",
      "enum": [
        "LinkedIn search",
        "Census data",
        "estimate"
      ]
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "Result: $X (Source. From section 'TAM (Rough, ~5 min)'."
    },
    "idea": {
      "type": "string",
      "title": "Idea",
      "description": "Quick Market Check."
    },
    "industry": {
      "type": "string",
      "title": "Industry",
      "description": "Google search. From section 'TAM (Rough, ~5 min)'."
    },
    "ok_stale": {
      "type": "string",
      "title": "Ok stale",
      "description": "TAM source age. From section 'Confidence'."
    },
    "sourced_estimated": {
      "type": "string",
      "title": "Sourced estimated",
      "description": "Bottom-up customer count. From section 'Confidence'."
    },
    "url": {
      "type": "string",
      "title": "Url",
      "description": "Result. From section 'TAM (Rough, ~5 min)'."
    },
    "why_x": {
      "type": "string",
      "title": "Why x",
      "description": "Assumption. From section 'SAM (Segment, ~5 min)'."
    },
    "x_months": {
      "type": "string",
      "title": "X months",
      "description": "TAM source age. From section 'Confidence'."
    },
    "year": {
      "type": "string",
      "title": "Year",
      "description": "Google search. From section 'TAM (Rough, ~5 min)'."
    }
  },
  "required": [
    "customer_count_source",
    "date",
    "idea",
    "industry",
    "ok_stale",
    "sourced_estimated",
    "url",
    "why_x",
    "x_months",
    "year"
  ],
  "x-faion-dictionary-refs": 0
}
