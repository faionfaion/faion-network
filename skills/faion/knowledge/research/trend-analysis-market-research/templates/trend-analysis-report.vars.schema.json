{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/research/trend-analysis-market-research/trend-analysis-report.vars.schema.json",
  "title": "trend-analysis-report template variables",
  "description": "Values for templates/trend-analysis-report.md.j2 and templates/trend-analysis-report.html.j2. Generated by tpl-jinja from trend-analysis-report.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "title": "Action",
      "description": "1. From section 'Next Steps'."
    },
    "category": {
      "type": "string",
      "title": "Category",
      "description": "The category used under 'Summary'.",
      "enum": [
        "Fad",
        "Trend",
        "Megatrend",
        "Shift"
      ]
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "(). From section 'STEEP Analysis'."
    },
    "index": {
      "type": "string",
      "title": "Index",
      "description": "Google Trends. From section 'Evidence'."
    },
    "jurisdiction": {
      "type": "string",
      "title": "Jurisdiction",
      "description": "The jurisdiction used under 'STEEP Analysis'."
    },
    "market_size": {
      "type": "integer",
      "title": "Market size",
      "description": "The market size used under 'Evidence'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "The name used under 'Competitive Landscape'."
    },
    "recommendation": {
      "type": "string",
      "title": "Recommendation",
      "description": "The recommendation used under 'Summary'.",
      "enum": [
        "Pursue now",
        "Monitor 6 months",
        "Not a fit"
      ]
    },
    "rule_id": {
      "type": "string",
      "title": "Rule id",
      "description": "The rule id used under 'STEEP Analysis'."
    },
    "stage": {
      "type": "string",
      "title": "Stage",
      "description": "The stage used under 'Summary'.",
      "enum": [
        "Innovator",
        "Early Adopter",
        "Early Mainstream",
        "Late Mainstream",
        "Decline"
      ]
    },
    "trend_name": {
      "type": "string",
      "title": "Trend name",
      "description": "Trend Analysis."
    },
    "url": {
      "type": "string",
      "title": "Url",
      "description": "Market size. From section 'Evidence'."
    },
    "weighted_total": {
      "type": "string",
      "title": "Weighted total",
      "description": "Trend strength score. From section 'Opportunity Assessment'."
    },
    "yes_no_partial": {
      "type": "string",
      "title": "Yes no partial",
      "description": "Skills match. From section 'Opportunity Assessment'."
    }
  },
  "required": [
    "action",
    "category",
    "date",
    "index",
    "jurisdiction",
    "market_size",
    "name",
    "recommendation",
    "rule_id",
    "stage",
    "trend_name",
    "url",
    "weighted_total",
    "yes_no_partial"
  ],
  "x-faion-dictionary-refs": 0
}
