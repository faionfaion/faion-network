{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/research/trend-analysis/trend-report.vars.schema.json",
  "title": "trend-report template variables",
  "description": "Values for templates/trend-report.md.j2 and templates/trend-report.html.j2. Generated by tpl-jinja from trend-report.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "behavior_value_change": {
      "type": "string",
      "title": "Behavior value change",
      "description": "Social. From section 'STEEP Analysis'."
    },
    "category": {
      "type": "string",
      "title": "Category",
      "description": "The category used under 'Summary'.",
      "enum": [
        "Fad",
        "Trend",
        "Megatrend",
        "Shift"
      ]
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "Trend. From section 'Summary'."
    },
    "early_mainstream": {
      "type": "string",
      "title": "Early mainstream",
      "description": "The early mainstream used under 'Competitive Landscape'."
    },
    "environmental": {
      "type": "string",
      "title": "Environmental",
      "description": "The environmental used under 'STEEP Analysis'.",
      "enum": [
        "n",
        "a",
        "sustainability factors"
      ]
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "The name used under 'Competitive Landscape'."
    },
    "opportunity_window": {
      "type": "string",
      "title": "Opportunity window",
      "description": "The opportunity window used under 'Summary'.",
      "enum": [
        "Timeframe",
        "milestone"
      ]
    },
    "regulatory_landscape": {
      "type": "string",
      "title": "Regulatory landscape",
      "description": "Political. From section 'STEEP Analysis'."
    },
    "stage": {
      "type": "string",
      "title": "Stage",
      "description": "The stage used under 'Summary'.",
      "enum": [
        "Innovator",
        "Early",
        "Mainstream",
        "Decline"
      ]
    },
    "strength_weakness": {
      "type": "string",
      "title": "Strength weakness",
      "description": "$X. From section 'Competitive Landscape'."
    },
    "trend_name": {
      "type": "string",
      "title": "Trend name",
      "description": "Trend Analysis."
    }
  },
  "required": [
    "behavior_value_change",
    "category",
    "description",
    "early_mainstream",
    "environmental",
    "name",
    "opportunity_window",
    "regulatory_landscape",
    "stage",
    "strength_weakness",
    "trend_name"
  ],
  "x-faion-dictionary-refs": 0
}
