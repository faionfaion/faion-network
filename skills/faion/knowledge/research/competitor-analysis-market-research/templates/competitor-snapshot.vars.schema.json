{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/research/competitor-analysis-market-research/competitor-snapshot.vars.schema.json",
  "title": "competitor-snapshot template variables",
  "description": "Values for templates/competitor-snapshot.md.j2 and templates/competitor-snapshot.html.j2. Generated by tpl-jinja from competitor-snapshot.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "type": "string",
      "title": "Confidence",
      "description": "The confidence used under 'Pricing'.",
      "enum": [
        "high = official source",
        "med = proxy-triangulated",
        "low = inferred"
      ]
    },
    "headcount_source": {
      "type": "string",
      "title": "Headcount source",
      "description": "~% (est.) of — proxies. From section 'Market Share (est.)'."
    },
    "review_quote_url": {
      "type": "string",
      "title": "Review quote url",
      "description": "Weakness. From section 'SWOT'."
    },
    "tam_source": {
      "type": "string",
      "title": "Tam source",
      "description": "~% (est.) of. From section 'Market Share (est.)'."
    },
    "traffic_source": {
      "type": "string",
      "title": "Traffic source",
      "description": "~% (est.) of — proxies. From section 'Market Share (est.)'."
    },
    "year": {
      "type": "string",
      "title": "Year",
      "description": "Website. From section 'Snapshot'."
    }
  },
  "required": [
    "confidence",
    "headcount_source",
    "review_quote_url",
    "tam_source",
    "traffic_source",
    "year"
  ],
  "x-faion-dictionary-refs": 0
}
