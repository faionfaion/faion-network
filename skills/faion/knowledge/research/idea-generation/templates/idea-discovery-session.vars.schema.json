{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/research/idea-generation/idea-discovery-session.vars.schema.json",
  "title": "idea-discovery-session template variables",
  "description": "Values for templates/idea-discovery-session.md.j2 and templates/idea-discovery-session.html.j2. Generated by tpl-jinja from idea-discovery-session.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "title": "Date",
      "description": "Idea Discovery Session."
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "Problem solved. From section 'Idea 1'."
    },
    "framework_name": {
      "type": "string",
      "title": "Framework name",
      "description": "Source framework. From section 'Idea 1'."
    },
    "how": {
      "type": "string",
      "title": "How",
      "description": "Rough solution. From section 'Idea 1'."
    },
    "notes": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/notes"
    },
    "score": {
      "type": "string",
      "title": "Score",
      "description": "Market Size (1-5). From section 'Idea 1'."
    },
    "total_ideas_generated": {
      "type": "integer",
      "title": "Total ideas generated",
      "description": "The total ideas generated used under 'Session Metadata'."
    },
    "who": {
      "type": "string",
      "title": "Who",
      "description": "Target audience. From section 'Idea 1'."
    }
  },
  "required": [
    "date",
    "description",
    "framework_name",
    "how",
    "score",
    "total_ideas_generated",
    "who"
  ],
  "x-faion-dictionary-refs": 1
}
