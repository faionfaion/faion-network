{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/research/niche-evaluation-market-research/niche-scorecard.vars.schema.json",
  "title": "niche-scorecard template variables",
  "description": "Values for templates/niche-scorecard.md.j2 and templates/niche-scorecard.html.j2. Generated by tpl-jinja from niche-scorecard.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ahrefs_trends": {
      "type": "string",
      "title": "Ahrefs trends",
      "description": "Keyword volume (primary terms). From section 'Market Size (Weight'."
    },
    "areas": {
      "type": "string",
      "title": "Areas",
      "description": "Decision. From section 'Final Calculation'."
    },
    "growing_stable_declining": {
      "type": "string",
      "title": "Growing stable declining",
      "description": "Google Trends direction. From section 'Market Size (Weight'."
    },
    "list": {
      "type": "string",
      "title": "List",
      "description": "Long-tail competitors (IH/Etsy/Discord). From section 'Competition (Weight'."
    },
    "matrix_position": {
      "type": "string",
      "title": "Matrix position",
      "description": "The matrix position used under 'Competition (Weight'.",
      "enum": [
        "Opportunity Zone",
        "Premium Crowded",
        "Race to Bottom"
      ]
    },
    "n_shows": {
      "type": "string",
      "title": "N shows",
      "description": "Podcasts. From section 'Audience Accessibility (Weight'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Niche. From section 'Niche Evaluation Scorecard'."
    },
    "product_type": {
      "type": "string",
      "title": "Product type",
      "description": "One-sentence definition. From section 'Niche'."
    },
    "reddit_community_url": {
      "type": "string",
      "title": "Reddit community url",
      "description": "Community 30-day post velocity. From section 'Market Size (Weight'."
    },
    "required": {
      "type": "string",
      "title": "Required",
      "description": "SAM. From section 'Market Size (Weight'."
    },
    "specific_audience": {
      "type": "string",
      "title": "Specific audience",
      "description": "One-sentence definition. From section 'Niche'."
    },
    "specific_problem": {
      "type": "string",
      "title": "Specific problem",
      "description": "One-sentence definition. From section 'Niche'."
    },
    "x_budget_authority": {
      "type": "string",
      "title": "X budget authority",
      "description": "Purchasing power. From section 'Audience Accessibility (Weight'."
    },
    "x_posts_day": {
      "type": "string",
      "title": "X posts day",
      "description": "Community 30-day post velocity. From section 'Market Size (Weight'."
    },
    "x_searches_month": {
      "type": "string",
      "title": "X searches month",
      "description": "Keyword volume (primary terms). From section 'Market Size (Weight'."
    }
  },
  "required": [
    "ahrefs_trends",
    "areas",
    "growing_stable_declining",
    "list",
    "matrix_position",
    "n_shows",
    "name",
    "product_type",
    "reddit_community_url",
    "required",
    "specific_audience",
    "specific_problem",
    "x_budget_authority",
    "x_posts_day",
    "x_searches_month"
  ],
  "x-faion-dictionary-refs": 0
}
