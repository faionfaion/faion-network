    "last_validated": {
      "type": "string",
      "title": "Last validated",
      "description": "The last validated used under 'Data Sources'."
    },
    "level": {
      "type": "string",
      "title": "Level",
      "description": "Education. From section 'Demographics'."
    },
    "light_heavy": {
      "type": "string",
