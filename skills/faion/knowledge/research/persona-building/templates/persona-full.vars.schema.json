      "description": "Why us over alternatives. From section 'How We Help'."
    },
    "core_tasks": {
      "type": "string",
      "title": "Core tasks",
      "description": "Workday. From section 'Day in the Life'."
    },
    "days_weeks_months": {
      "type": "string",
      "title": "Days weeks months",
      "description": "Decision time. From section 'Buying Behavior'."
    },
    "interviews_conducted": {
      "type": "integer",
      "title": "Interviews conducted",
      "description": "The interviews conducted used under 'Data Sources'."
