{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/research/business-model-research/business-model-report.vars.schema.json",
  "title": "business-model-report template variables",
  "description": "Values for templates/business-model-report.md.j2 and templates/business-model-report.html.j2. Generated by tpl-jinja from business-model-report.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "product_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/product_name"
    },
    "result": {
      "type": "string",
      "title": "Result",
      "description": "The result used under 'Verdict (P10-based)'.",
      "enum": [
        "viable",
        "viable-with-fixes",
        "not-viable"
      ]
    }
  },
  "required": [
    "product_name",
    "result"
  ],
  "x-faion-dictionary-refs": 1
}
