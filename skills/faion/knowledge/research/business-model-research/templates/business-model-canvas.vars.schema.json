{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/research/business-model-research/business-model-canvas.vars.schema.json",
  "title": "business-model-canvas template variables",
  "description": "Values for templates/business-model-canvas.md.j2 and templates/business-model-canvas.html.j2. Generated by tpl-jinja from business-model-canvas.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "assets": {
      "type": "string",
      "title": "Assets",
      "description": "Physical. From section 'Key Resources'."
    },
    "capital_needed": {
      "type": "string",
      "title": "Capital needed",
      "description": "Financial. From section 'Key Resources'."
    },
    "cost_1": {
      "type": "string",
      "title": "Cost 1",
      "description": "The cost 1 used under 'Cost Structure'."
    },
    "cost_2": {
      "type": "string",
      "title": "Cost 2",
      "description": "The cost 2 used under 'Cost Structure'."
    },
    "critical_activity_1": {
      "type": "string",
      "title": "Critical activity 1",
      "description": "1. From section 'Key Activities'."
    },
    "critical_activity_2": {
      "type": "string",
      "title": "Critical activity 2",
      "description": "2. From section 'Key Activities'."
    },
    "critical_activity_3": {
      "type": "string",
      "title": "Critical activity 3",
      "description": "3. From section 'Key Activities'."
    },
    "how_they_buy": {
      "type": "string",
      "title": "How they buy",
      "description": "Purchase. From section 'Channels'."
    },
    "how_they_evaluate": {
      "type": "string",
      "title": "How they evaluate",
      "description": "Evaluation. From section 'Channels'."
    },
    "how_we_support": {
      "type": "string",
      "title": "How we support",
      "description": "After-sales. From section 'Channels'."
    },
    "key_roles": {
      "type": "string",
      "title": "Key roles",
      "description": "Human. From section 'Key Resources'."
    },
    "partner": {
      "type": "string",
      "title": "Partner",
      "description": "The partner used under 'Key Partners'."
    },
    "product_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/product_name"
    },
    "stream_1": {
      "type": "string",
      "title": "Stream 1",
      "description": "The stream 1 used under 'Revenue Streams'."
    },
    "type": {
      "type": "string",
      "title": "Type",
      "description": "The type used under 'Customer Relationships'.",
      "enum": [
        "Self-serve",
        "Assisted",
        "Automated"
      ]
    },
    "value": {
      "type": "string",
      "title": "Value",
      "description": "The value used under 'Key Partners'."
    },
    "value_delivered": {
      "type": "string",
      "title": "Value delivered",
      "description": "For. From section 'Value Propositions'."
    }
  },
  "required": [
    "assets",
    "capital_needed",
    "cost_1",
    "cost_2",
    "critical_activity_1",
    "critical_activity_2",
    "critical_activity_3",
    "how_they_buy",
    "how_they_evaluate",
    "how_we_support",
    "key_roles",
    "partner",
    "product_name",
    "stream_1",
    "type",
    "value",
    "value_delivered"
  ],
  "x-faion-dictionary-refs": 1
}
