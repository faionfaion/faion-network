    "main_barrier_type": {
      "type": "string",
      "title": "Main barrier type",
      "description": "Barriers. From section 'Niche'."
    },
    "relevant_skills_audience": {
      "type": "string",
      "title": "Relevant skills audience",
      "description": "Your Fit. From section 'Niche'."
    },
    "specific_action": {
      "type": "string",
      "title": "Specific action",
      "description": "Weakest criterion. From section 'Niche'."
    }
  },
  "required": [
    "decision",
    "main_barrier_type",
    "relevant_skills_audience",
    "specific_action"
  ],
  "x-faion-dictionary-refs": 0
}
