{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/research/use-case-mapping/use-case-mapping.vars.schema.json",
  "title": "use-case-mapping template variables",
  "description": "Values for templates/use-case-mapping.md.j2 and templates/use-case-mapping.html.j2. Generated by tpl-jinja from use-case-mapping.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "active_verb_statement": {
      "type": "string",
      "title": "Active verb statement",
      "description": "Goal (string). From section 'Use Case Mapping'."
    },
    "artefact_id": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/artefact_id"
        }
      ],
      "description": "Use Case Mapping."
    },
    "document_version": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/document_version"
        }
      ],
      "description": "Version (string). From section 'Use Case Mapping'."
    },
    "last_reviewed_date": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/last_reviewed_date"
        }
      ],
      "description": "Last reviewed (date). From section 'Use Case Mapping'."
    },
    "named_role": {
      "type": "string",
      "title": "Named role",
      "description": "Primary actor (string). From section 'Use Case Mapping'."
    },
    "numbered_steps": {
      "type": "string",
      "title": "Numbered steps",
      "description": "Main flow (array). From section 'Use Case Mapping'."
    },
    "observable_end_state": {
      "type": "string",
      "title": "Observable end state",
      "description": "Postcondition (string). From section 'Use Case Mapping'."
    },
    "owner_full_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_full_name"
        }
      ],
      "description": "Owner (string). From section 'Use Case Mapping'."
    }
  },
  "required": [
    "active_verb_statement",
    "artefact_id",
    "document_version",
    "last_reviewed_date",
    "named_role",
    "numbered_steps",
    "observable_end_state",
    "owner_full_name"
  ],
  "x-faion-dictionary-refs": 4
}
