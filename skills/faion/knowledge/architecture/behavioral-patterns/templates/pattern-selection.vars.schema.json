  "properties": {
    "owner_email": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_email"
        }
      ],
      "description": "Owner."
    },
    "owner_full_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_full_name"
        }
      ],
      "description": "Owner."
    },
    "selection": {
      "type": "string",
      "title": "Selection",
      "description": "The selection used under 'Refactor sketch'.",
      "enum": [
        "factory",
        "DI container",
        "config"
      ]
    },
    "system": {
      "type": "string",
      "title": "System",
      "description": "Artefact id."
    }
  },
  "required": [
    "owner_email",
    "owner_full_name",
    "selection",
    "system"
  ],
  "x-faion-dictionary-refs": 2
