{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/architecture/architect-pr-review-checklist/pr-review-report.vars.schema.json",
  "title": "pr-review-report template variables",
  "description": "Values for templates/pr-review-report.md.j2 and templates/pr-review-report.html.j2. Generated by tpl-jinja from pr-review-report.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "minutes": {
      "type": "string",
      "title": "Minutes",
      "description": "The minutes used under 'Time spent'."
    },
    "owner_email": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_email"
    },
    "owner_full_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_full_name"
        }
      ],
      "description": "Owner."
    },
    "pr_num": {
      "type": "string",
      "title": "Pr num",
      "description": "Artefact id."
    },
    "repo": {
      "type": "string",
      "title": "Repo",
      "description": "Artefact id."
    },
    "ship_block_escalate": {
      "type": "string",
      "title": "Ship block escalate",
      "description": "Verdict."
    },
    "url": {
      "type": "string",
      "title": "Url",
      "description": "Pr url."
    },
    "yes_no": {
      "type": "boolean",
      "title": "Yes no",
      "description": "Public API shape changes documented?. From section 'Contract'."
    }
  },
  "required": [
    "minutes",
    "pr_num",
    "repo",
    "ship_block_escalate",
    "url",
    "yes_no"
  ],
  "x-faion-dictionary-refs": 2
}
