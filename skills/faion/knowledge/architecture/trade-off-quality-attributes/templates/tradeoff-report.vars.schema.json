{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/architecture/trade-off-quality-attributes/tradeoff-report.vars.schema.json",
  "title": "tradeoff-report template variables",
  "description": "Values for templates/tradeoff-report.md.j2 and templates/tradeoff-report.html.j2. Generated by tpl-jinja from tradeoff-report.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "attribute_pair": {
      "type": "string",
      "title": "Attribute pair",
      "description": "The attribute pair used under 'Non-risks'."
    },
    "control": {
      "type": "string",
      "title": "Control",
      "description": "Mitigated by. From section 'Risks'."
    },
    "risk": {
      "type": "string",
      "title": "Risk",
      "description": "The risk used under 'Risks'."
    }
  },
  "required": [
    "attribute_pair",
    "control",
    "risk"
  ],
  "x-faion-dictionary-refs": 0
}
