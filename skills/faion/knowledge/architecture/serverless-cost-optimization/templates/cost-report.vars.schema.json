{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/architecture/serverless-cost-optimization/cost-report.vars.schema.json",
  "title": "cost-report template variables",
  "description": "Values for templates/cost-report.md.j2 and templates/cost-report.html.j2. Generated by tpl-jinja from cost-report.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "change": {
      "type": "string",
      "title": "Change",
      "description": "The change used under 'Actions'."
    },
    "issue": {
      "type": "string",
      "title": "Issue",
      "description": "The issue used under 'Findings'."
    }
  },
  "required": [
    "change",
    "issue"
  ],
  "x-faion-dictionary-refs": 0
}
