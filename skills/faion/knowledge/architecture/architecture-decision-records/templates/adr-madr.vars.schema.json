{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/architecture/architecture-decision-records/adr-madr.vars.schema.json",
  "title": "adr-madr template variables",
  "description": "Values for templates/adr-madr.md.j2 and templates/adr-madr.html.j2. Generated by tpl-jinja from adr-madr.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decision_title": {
      "type": "string",
      "title": "Decision title",
      "description": "Title."
    },
    "driver_1": {
      "type": "string",
      "title": "Driver 1",
      "description": "The driver 1 used under 'Decision Drivers'."
    },
    "driver_2": {
      "type": "string",
      "title": "Driver 2",
      "description": "The driver 2 used under 'Decision Drivers'."
    },
    "negative": {
      "type": "string",
      "title": "Negative",
      "description": "The negative used under 'Negative Consequences'."
    },
    "option": {
      "type": "string",
      "title": "Option",
      "description": "Chosen option. From section 'Decision Outcome'."
    },
    "option_1": {
      "type": "string",
      "title": "Option 1",
      "description": "The option 1 used under 'Considered Options'."
    },
    "option_2": {
      "type": "string",
      "title": "Option 2",
      "description": "The option 2 used under 'Considered Options'."
    },
    "option_3": {
      "type": "string",
      "title": "Option 3",
      "description": "The option 3 used under 'Considered Options'."
    },
    "owner_email": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_email"
        }
      ],
      "description": "Owner."
    },
    "owner_full_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_full_name"
        }
      ],
      "description": "Owner."
    },
    "positive": {
      "type": "string",
      "title": "Positive",
      "description": "The positive used under 'Positive Consequences'."
    },
    "problem_framing": {
      "type": "string",
      "title": "Problem framing",
      "description": "The problem framing used under 'Context and Problem Statement'."
    },
    "reason": {
      "type": "string",
      "title": "Reason",
      "description": "Chosen option. From section 'Decision Outcome'."
    },
    "short_slug": {
      "type": "string",
      "title": "Short slug",
      "description": "Artefact id."
    }
  },
  "required": [
    "decision_title",
    "driver_1",
    "driver_2",
    "negative",
    "option",
    "option_1",
    "option_2",
    "option_3",
    "owner_email",
    "owner_full_name",
    "positive",
    "problem_framing",
    "reason",
    "short_slug"
  ],
  "x-faion-dictionary-refs": 2
}
