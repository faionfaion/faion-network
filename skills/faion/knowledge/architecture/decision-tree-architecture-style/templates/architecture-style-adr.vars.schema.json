{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/architecture/decision-tree-architecture-style/architecture-style-adr.vars.schema.json",
  "title": "architecture-style-adr template variables",
  "description": "Values for templates/architecture-style-adr.md.j2 and templates/architecture-style-adr.html.j2. Generated by tpl-jinja from architecture-style-adr.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "choice": {
      "type": "string",
      "title": "Choice",
      "description": "The choice used under 'Decision'."
    },
    "deploy_frequency_target": {
      "type": "string",
      "title": "Deploy frequency target",
      "description": "The deploy frequency target used under 'Context'.",
      "enum": [
        "K",
        "day",
        "week"
      ]
    },
    "eng_weeks_dollars": {
      "type": "string",
      "title": "Eng weeks dollars",
      "description": "Rollback path. From section 'Reversibility'."
    },
    "m": {
      "type": "string",
      "title": "M",
      "description": "Team size. From section 'Context'."
    },
    "owner_email": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_email"
        }
      ],
      "description": "Owner."
    },
    "owner_full_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_full_name"
        }
      ],
      "description": "Owner."
    },
    "reason": {
      "type": "string",
      "title": "Reason",
      "description": "1. From section 'Decision'."
    },
    "regulatory_regime": {
      "type": "string",
      "title": "Regulatory regime",
      "description": "The regulatory regime used under 'Context'.",
      "enum": [
        "none",
        "GDPR",
        "HIPAA",
        "PCI-DSS",
        "SOC2"
      ]
    },
    "system": {
      "type": "string",
      "title": "System",
      "description": "Artefact id."
    },
    "team_size": {
      "type": "integer",
      "title": "Team size",
      "description": "The team size used under 'Context'."
    },
    "tight_loose": {
      "type": "string",
      "title": "Tight loose",
      "description": "Domain coupling. From section 'Context'."
    }
  },
  "required": [
    "choice",
    "deploy_frequency_target",
    "eng_weeks_dollars",
    "m",
    "owner_email",
    "owner_full_name",
    "reason",
    "regulatory_regime",
    "system",
    "team_size",
    "tight_loose"
  ],
  "x-faion-dictionary-refs": 2
}
