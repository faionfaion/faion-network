{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/architecture/trade-off-decision-matrix/decision-matrix.vars.schema.json",
  "title": "decision-matrix template variables",
  "description": "Values for templates/decision-matrix.md.j2 and templates/decision-matrix.html.j2. Generated by tpl-jinja from decision-matrix.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "chosen": {
      "type": "string",
      "title": "Chosen",
      "description": "The chosen used under 'Recommendation'."
    },
    "criterion": {
      "type": "string",
      "title": "Criterion",
      "description": "Option A /. From section 'Evidence per Score'."
    },
    "criterion_1": {
      "type": "string",
      "title": "Criterion 1",
      "description": "The criterion 1 used under 'Criteria + Weights (sum = 100%)'."
    },
    "criterion_2": {
      "type": "string",
      "title": "Criterion 2",
      "description": "The criterion 2 used under 'Criteria + Weights (sum = 100%)'."
    },
    "criterion_3": {
      "type": "string",
      "title": "Criterion 3",
      "description": "The criterion 3 used under 'Criteria + Weights (sum = 100%)'."
    },
    "criterion_4": {
      "type": "string",
      "title": "Criterion 4",
      "description": "The criterion 4 used under 'Criteria + Weights (sum = 100%)'."
    },
    "criterion_5": {
      "type": "string",
      "title": "Criterion 5",
      "description": "The criterion 5 used under 'Criteria + Weights (sum = 100%)'."
    },
    "criterion_x": {
      "type": "string",
      "title": "Criterion x",
      "description": "The criterion x used under 'Identified Conflicts'."
    },
    "criterion_y": {
      "type": "string",
      "title": "Criterion y",
      "description": "Vs. From section 'Identified Conflicts'."
    },
    "question": {
      "type": "string",
      "title": "Question",
      "description": "Decision Matrix."
    },
    "resolution": {
      "type": "string",
      "title": "Resolution",
      "description": "Vs. From section 'Identified Conflicts'."
    },
    "value": {
      "type": "string",
      "title": "Value",
      "description": "Weighted total. From section 'Recommendation'."
    }
  },
  "required": [
    "chosen",
    "criterion",
    "criterion_1",
    "criterion_2",
    "criterion_3",
    "criterion_4",
    "criterion_5",
    "criterion_x",
    "criterion_y",
    "question",
    "resolution",
    "value"
  ],
  "x-faion-dictionary-refs": 0
}
