<?xml version="1.0" encoding="UTF-8"?>
<text id="02-output-contract" title="Multi-Agent Design Patterns — Output Contract" version="1.0.0" est_tokens="800" depth="essential">
  <summary>JSON Schema for the `decision-record` artefact this methodology produces, with one valid and one invalid worked example.</summary>

  <section title="Schema">
    <reference path="scripts/validate-multi-agent-design-patterns.py">Mechanical validator wired to this schema.</reference>
    <code lang="json"><![CDATA[
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faion.net/schemas/multi-agent-design-patterns.json",
  "type": "object",
  "required": [
    "slug",
    "version",
    "date",
    "produces",
    "signature",
    "payload",
    "forbidden_seen"
  ],
  "properties": {
    "slug": {
      "const": "multi-agent-design-patterns"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "produces": {
      "const": "decision-record"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "payload": {
      "type": "object",
      "required": [
        "criteria",
        "scores",
        "recommendation"
      ],
      "properties": {
        "criteria": {
          "type": "array"
        },
        "scores": {
          "type": "object"
        },
        "recommendation": {
          "type": "string"
        },
        "pattern": {
          "type": "string",
          "enum": [
            "sequential",
            "parallel_fanout",
            "hierarchical",
            "generator_critic",
            "loop",
            "human_in_loop",
            "router",
            "blackboard"
          ]
        },
        "alternatives_considered": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["pattern", "why_rejected"],
            "properties": {
              "pattern": {"type": "string"},
              "why_rejected": {"type": "string", "minLength": 16}
            }
          }
        },
        "tradeoffs": {
          "type": "object",
          "required": ["latency", "cost", "audit", "parallelism"]
        },
        "downstream_methodology": {"type": "string"},
        "hitl_gates": {"type": "array", "items": {"type": "string"}},
        "concurrency_plan": {"type": "string"},
        "classifier_accuracy": {"type": "number", "minimum": 0.85}
      },
      "allOf": [
        {"if": {"properties": {"pattern": {"const": "blackboard"}}}, "then": {"required": ["concurrency_plan"]}},
        {"if": {"properties": {"pattern": {"const": "router"}}}, "then": {"required": ["classifier_accuracy"]}}
      ]
    },
    "forbidden_seen": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
]]></code>
  </section>

  <section title="Valid example">
    <example type="good">
      <code lang="json"><![CDATA[
{
  "slug": "multi-agent-design-patterns",
  "version": "1.0.0",
  "date": "2026-05-22",
  "produces": "decision-record",
  "signature": "b677c7cc1c524cc0",
  "payload": {
    "criteria": [
      "accuracy",
      "latency",
      "cost"
    ],
    "scores": {
      "a": 3,
      "b": 5
    },
    "recommendation": "Pick option B."
  },
  "forbidden_seen": []
}
]]></code>
    </example>
  </section>

  <section title="Invalid example">
    <example type="bad">
      <code lang="json"><![CDATA[
{
  "slug": "multi-agent-design-patterns",
  "version": "v1",
  "date": "today",
  "produces": "decision-record",
  "signature": "tooshort",
  "payload": {
    "TBD": true
  },
  "forbidden_seen": [
    "empty_intent"
  ]
}
]]></code>
      <note>Fails validation: missing required fields and contains forbidden patterns.</note>
    </example>
  </section>

  <section title="Self-check checklist">
    <list>
      <item>Required keys present and typed correctly.</item>
      <item>`forbidden_seen` array empty.</item>
      <item>`signature` matches sha1(slug + version + ISO date)[:16].</item>
      <item>`date` is ISO 8601 (YYYY-MM-DD).</item>
      <item>`payload.pattern` is one of the 8 canonical names exactly — never a stack such as "hierarchical + loop".</item>
      <item>At least 2 `alternatives_considered`, each carrying `why_rejected`.</item>
      <item>Every irreversible action in the design is listed in `hitl_gates`.</item>
      <item>If `pattern == blackboard`, `concurrency_plan` is present; if `pattern == router`, `classifier_accuracy >= 0.85`.</item>
    </list>
  </section>
</text>
