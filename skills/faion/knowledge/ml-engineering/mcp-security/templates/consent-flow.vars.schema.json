{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ml-engineering/mcp-security/consent-flow.vars.schema.json",
  "title": "consent-flow template variables",
  "description": "Values for templates/consent-flow.md.j2 and templates/consent-flow.html.j2. Generated by tpl-jinja from consent-flow.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "modal": {
      "type": "string",
      "title": "Modal",
      "description": "Surface. From section '(server asks the host to call the model)'."
    },
    "public_internal_pii": {
      "type": "string",
      "title": "Public internal pii",
      "description": "Shows. From section 'Resources (read-only data)'."
    },
    "rubric_name": {
      "type": "string",
      "title": "Rubric name",
      "description": "Consent Flow."
    },
    "surface": {
      "type": "string",
      "title": "Surface",
      "description": "The surface used under 'Tools (actions)'.",
      "enum": [
        "modal",
        "side panel",
        "inline card"
      ]
    }
  },
  "required": [
    "modal",
    "public_internal_pii",
    "rubric_name",
    "surface"
  ],
  "x-faion-dictionary-refs": 0
}
