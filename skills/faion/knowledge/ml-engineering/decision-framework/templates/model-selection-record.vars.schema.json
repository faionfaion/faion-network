{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ml-engineering/decision-framework/model-selection-record.vars.schema.json",
  "title": "model-selection-record template variables",
  "description": "Values for templates/model-selection-record.md.j2 and templates/model-selection-record.html.j2. Generated by tpl-jinja from model-selection-record.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "accuracy_quality_level": {
      "type": "string",
      "title": "Accuracy quality level",
      "description": "Quality threshold. From section 'Requirements'."
    },
    "application_name": {
      "type": "string",
      "title": "Application name",
      "description": "Model Selection Decision."
    },
    "monthly_cap": {
      "type": "string",
      "title": "Monthly cap",
      "description": "Budget. From section 'Requirements'."
    },
    "option": {
      "type": "string",
      "title": "Option",
      "description": "Selected. From section 'Decision'."
    },
    "requests_month": {
      "type": "string",
      "title": "Requests month",
      "description": "Volume. From section 'Requirements'."
    }
  },
  "required": [
    "accuracy_quality_level",
    "application_name",
    "monthly_cap",
    "option",
    "requests_month"
  ],
  "x-faion-dictionary-refs": 0
}
