{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ml-engineering/mcp-architecture/mcp-spec.vars.schema.json",
  "title": "mcp-spec template variables",
  "description": "Values for templates/mcp-spec.md.j2 and templates/mcp-spec.html.j2. Generated by tpl-jinja from mcp-spec.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "authorization_server": {
      "type": "string",
      "title": "Authorization server",
      "description": "The authorization server used under 'Auth (rule r4)'.",
      "enum": [
        "issuer URL",
        "n",
        "a"
      ]
    },
    "mutates_computes": {
      "type": "string",
      "title": "Mutates computes",
      "description": "Tool. From section 'Primitives (rule r2)'."
    },
    "prompts": {
      "type": "string",
      "title": "Prompts",
      "description": "Prompt. From section 'Primitives (rule r2)'."
    },
    "resources": {
      "type": "string",
      "title": "Resources",
      "description": "Resource. From section 'Primitives (rule r2)'."
    },
    "scope": {
      "type": "string",
      "title": "Scope",
      "description": "The scope used under 'Transport (rule r3)'.",
      "enum": [
        "local desktop",
        "remote single-tenant",
        "remote multi-tenant"
      ]
    },
    "scopes": {
      "type": "string",
      "title": "Scopes",
      "description": "The scopes used under 'Auth (rule r4)'.",
      "enum": [
        "list",
        "n",
        "a"
      ]
    },
    "spec_name": {
      "type": "string",
      "title": "Spec name",
      "description": "MCP Architecture Spec."
    },
    "template_intent": {
      "type": "string",
      "title": "Template intent",
      "description": "Prompt. From section 'Primitives (rule r2)'."
    },
    "tools": {
      "type": "string",
      "title": "Tools",
      "description": "Tool. From section 'Primitives (rule r2)'."
    },
    "undeclared_methods": {
      "type": "string",
      "title": "Undeclared methods",
      "description": "The undeclared methods used under 'Capability attestation (rule r6)'.",
      "enum": [
        "error code",
        "log line"
      ]
    }
  },
  "required": [
    "authorization_server",
    "mutates_computes",
    "prompts",
    "resources",
    "scope",
    "scopes",
    "spec_name",
    "template_intent",
    "tools",
    "undeclared_methods"
  ],
  "x-faion-dictionary-refs": 0
}
