{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ml-engineering/sota-onboarding-1day-runbook/decision-record.vars.schema.json",
  "title": "decision-record template variables",
  "description": "Values for templates/decision-record.md.j2 and templates/decision-record.html.j2. Generated by tpl-jinja from decision-record.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "title": "Id",
      "description": "Flag. From section 'Decision'."
    },
    "model": {
      "type": "string",
      "title": "Model",
      "description": "SOTA Onboarding Decision."
    },
    "owner_full_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_full_name"
        }
      ],
      "description": "Owner. From section 'SOTA Onboarding Decision'."
    },
    "pct": {
      "type": "string",
      "title": "Pct",
      "description": "Rollout. From section 'Decision'."
    },
    "y": {
      "type": "string",
      "title": "Y",
      "description": "Eval-set (n=). From section 'Results'."
    }
  },
  "required": [
    "id",
    "model",
    "pct",
    "y"
  ],
  "x-faion-dictionary-refs": 1
}
