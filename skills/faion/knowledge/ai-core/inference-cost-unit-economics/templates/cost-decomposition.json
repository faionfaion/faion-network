{
  "__faion_header__": {
    "purpose": "Unit-economics report skeleton: same field names and required set as content/02-output-contract.xml",
    "consumes": "Per-call usage log, pinned price sheet, success events, revenue attribution (AGENTS.md Prerequisites)",
    "produces": "artefact validating against content/02-output-contract.xml for produces=report",
    "depends-on": "content/01-core-rules.xml",
    "token-budget-impact": "~600 tokens when loaded as context"
  },
  "report_id": "<feature-or-product>-unit-economics-<yyyyqN>",
  "as_of": "<YYYY-MM-DD>",
  "author": "<named person or team mailbox>",
  "window": {"start": "<YYYY-MM-DD>", "end": "<YYYY-MM-DD>", "days": 7},
  "token_source": "provider_usage",
  "headline_metric": "cost_per_successful_outcome",
  "price_sheet": [
    {
      "provider": "<anthropic|openai|google|...>",
      "model_id": "<exact model id with dated snapshot>",
      "sheet_date": "<YYYY-MM-DD>",
      "sheet_url": "<pricing page URL>",
      "input_price_per_1m": 0.0,
      "output_price_per_1m": 0.0,
      "cached_input_price_per_1m": 0.0,
      "discount_pct": 0,
      "discount_kind": "none"
    }
  ],
  "features": [
    {
      "feature_id": "<kebab-case feature id>",
      "success_definition": "<observable outcome with a time bound and the event it is counted from>",
      "successful_outcomes": 1,
      "cost_lines": {"input_tokens": 0.0, "output_tokens": 0.0, "cached_input_tokens": 0.0, "retrieval": 0.0, "tools": 0.0},
      "cost_per_call": 0.0,
      "cost_per_outcome": {"p50": 0.0, "p95": 0.0, "mean": 0.0},
      "retry_share_pct": 0,
      "retry_cause": "<required when retry_share_pct > 15>",
      "first_action": "none",
      "revenue_basis": {"kind": "attributed_revenue", "allocation_key": "<required for allocation_rule>", "derivation": "<required for value_proxy>"},
      "revenue_per_outcome": 0.0,
      "gross_margin_pct": 0.0,
      "target_gross_margin_pct": 0,
      "cost_ceiling_per_outcome": 0.0,
      "tail_dominated": false,
      "tail_driver": "<required when tail_dominated: long_context|agent_loops|tool_retries|large_model_fallback|other>",
      "daily_spend_alert": {"threshold_kind": "pct_over_trailing_7d", "threshold": 30, "wired_to": "<alert rule location>"}
    }
  ],
  "over_ceiling": [
    {"feature_id": "<feature over its ceiling>", "gap_per_outcome": 0.01, "action_owner": "<named owner>"}
  ]
}
