{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ba/solution-assessment/post-implementation-review.vars.schema.json",
  "title": "post-implementation-review template variables",
  "description": "Values for templates/post-implementation-review.md.j2 and templates/post-implementation-review.html.j2. Generated by tpl-jinja from post-implementation-review.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "core_features_used": {
      "type": "string",
      "title": "Core features used",
      "description": "Feature usage rate. From section 'Adoption Metrics'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "Go-Live Date. From section 'Post-Implementation Review'."
    },
    "duration": {
      "type": "string",
      "title": "Duration",
      "description": "The duration used under 'Issues Encountered'."
    },
    "how_resolved": {
      "type": "string",
      "title": "How resolved",
      "description": "The how resolved used under 'Issues Encountered'."
    },
    "improvement": {
      "type": "string",
      "title": "Improvement",
      "description": "1. From section 'Process Improvements'."
    },
    "issue": {
      "type": "string",
      "title": "Issue",
      "description": "The issue used under 'Issues Encountered'."
    },
    "opportunity": {
      "type": "string",
      "title": "Opportunity",
      "description": "1. From section 'Enhancement Opportunities'."
    },
    "solution_name": {
      "type": "string",
      "title": "Solution name",
      "description": "Post-Implementation Review."
    },
    "timeframe": {
      "type": "string",
      "title": "Timeframe",
      "description": "Or. From section 'Original Business Case'."
    },
    "user_adoption_rate": {
      "type": "string",
      "title": "User adoption rate",
      "description": "The user adoption rate used under 'Adoption Metrics'.",
      "enum": [
        "Active users",
        "total licensed"
      ]
    }
  },
  "required": [
    "core_features_used",
    "date",
    "duration",
    "how_resolved",
    "improvement",
    "issue",
    "opportunity",
    "solution_name",
    "timeframe",
    "user_adoption_rate"
  ],
  "x-faion-dictionary-refs": 0
}
