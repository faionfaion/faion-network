{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ba/agile-ba-frameworks-ba-core/framework-fit.vars.schema.json",
  "title": "framework-fit template variables",
  "description": "Values for templates/framework-fit.md.j2 and templates/framework-fit.html.j2. Generated by tpl-jinja from framework-fit.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "dev_ops_maturity": {
      "type": "string",
      "title": "Dev ops maturity",
      "description": "DevOps maturity. From section 'Context'.",
      "enum": [
        "manual",
        "CI",
        "CD",
        "continuous-deployment"
      ]
    },
    "discovery_maturity": {
      "type": "string",
      "title": "Discovery maturity",
      "description": "The discovery maturity used under 'Context'.",
      "enum": [
        "pre",
        "in-flight",
        "post"
      ]
    },
    "framework": {
      "type": "string",
      "title": "Framework",
      "description": "Primary. From section 'Recommendation'."
    },
    "project": {
      "type": "string",
      "title": "Project",
      "description": "Framework Fit Report."
    },
    "regulatory_profile": {
      "type": "string",
      "title": "Regulatory profile",
      "description": "The regulatory profile used under 'Context'.",
      "enum": [
        "none",
        "GDPR",
        "HIPAA",
        "SOC2",
        "FDA"
      ]
    },
    "scaling": {
      "type": "string",
      "title": "Scaling",
      "description": "The scaling used under 'Context'.",
      "enum": [
        "single team",
        "2-10 teams",
        "10+ teams",
        "portfolio"
      ]
    },
    "team_size": {
      "type": "integer",
      "title": "Team size",
      "description": "The team size used under 'Context'."
    }
  },
  "required": [
    "dev_ops_maturity",
    "discovery_maturity",
    "framework",
    "project",
    "regulatory_profile",
    "scaling",
    "team_size"
  ],
  "x-faion-dictionary-refs": 0
}
