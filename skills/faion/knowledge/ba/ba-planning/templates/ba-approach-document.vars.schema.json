{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ba/ba-planning/ba-approach-document.vars.schema.json",
  "title": "ba-approach-document template variables",
  "description": "Values for templates/ba-approach-document.md.j2 and templates/ba-approach-document.html.j2. Generated by tpl-jinja from ba-approach-document.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "title": "Action",
      "description": "H/M/L. From section 'Risks and Constraints'."
    },
    "activity": {
      "type": "string",
      "title": "Activity",
      "description": "The activity used under 'Elicitation Plan'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Business Analysis Approach'."
    },
    "initiative_name": {
      "type": "string",
      "title": "Initiative name",
      "description": "Business Analysis Approach."
    },
    "item": {
      "type": "string",
      "title": "Item",
      "description": "The item used under 'Risks and Constraints'."
    },
    "output": {
      "type": "string",
      "title": "Output",
      "description": "Interview/Workshop/Survey/Observation/Doc Analysis. From section 'Elicitation Plan'."
    },
    "selected_approach": {
      "type": "string",
      "title": "Selected approach",
      "description": "The selected approach used under 'Analysis Approach'.",
      "enum": [
        "Plan-Driven",
        "Change-Driven",
        "Hybrid"
      ]
    },
    "who": {
      "type": "string",
      "title": "Who",
      "description": "Interview/Workshop/Survey/Observation/Doc Analysis. From section 'Elicitation Plan'."
    }
  },
  "required": [
    "action",
    "activity",
    "date",
    "initiative_name",
    "item",
    "output",
    "selected_approach",
    "who"
  ],
  "x-faion-dictionary-refs": 0
}
