{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ba/user-story-mapping/story-map.vars.schema.json",
  "title": "story-map template variables",
  "description": "Values for templates/story-map.md.j2 and templates/story-map.html.j2. Generated by tpl-jinja from story-map.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "activity_1": {
      "type": "string",
      "title": "Activity 1",
      "description": "The activity 1 used under 'Backbone (Activities)'."
    },
    "activity_2": {
      "type": "string",
      "title": "Activity 2",
      "description": "The activity 2 used under 'Backbone (Activities)'."
    },
    "activity_3": {
      "type": "string",
      "title": "Activity 3",
      "description": "The activity 3 used under 'Backbone (Activities)'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'User Story Map'."
    },
    "enhancement_delivered": {
      "type": "string",
      "title": "Enhancement delivered",
      "description": "Goal. From section 'Release 2'."
    },
    "exception_scenario_1": {
      "type": "string",
      "title": "Exception scenario 1",
      "description": "The exception scenario 1 used under 'Activity 1'."
    },
    "exception_scenario_2": {
      "type": "string",
      "title": "Exception scenario 2",
      "description": "The exception scenario 2 used under 'Activity 1'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Product Owner. From section 'User Story Map'."
    },
    "nfr": {
      "type": "string",
      "title": "Nfr",
      "description": "The nfr used under 'NFR Register (linked, not mapped)'."
    },
    "owner": {
      "type": "string",
      "title": "Owner",
      "description": "Perf/sec/a11y/audit. From section 'NFR Register (linked, not mapped)'."
    },
    "persona_1": {
      "type": "string",
      "title": "Persona 1",
      "description": "The persona 1 used under 'Personas'."
    },
    "persona_2": {
      "type": "string",
      "title": "Persona 2",
      "description": "The persona 2 used under 'Personas'."
    },
    "product_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/product_name"
        }
      ],
      "description": "User Story Map."
    },
    "release_activity": {
      "type": "string",
      "title": "Release activity",
      "description": "Perf/sec/a11y/audit. From section 'NFR Register (linked, not mapped)'."
    },
    "theme": {
      "type": "string",
      "title": "Theme",
      "description": "Release 2. From section 'Release 1'."
    }
  },
  "required": [
    "activity_1",
    "activity_2",
    "activity_3",
    "date",
    "enhancement_delivered",
    "exception_scenario_1",
    "exception_scenario_2",
    "name",
    "nfr",
    "owner",
    "persona_1",
    "persona_2",
    "product_name",
    "release_activity",
    "theme"
  ],
  "x-faion-dictionary-refs": 1
}
