{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ba/user-story-mapping/user-story.vars.schema.json",
  "title": "user-story template variables",
  "description": "Values for templates/user-story.md.j2 and templates/user-story.html.j2. Generated by tpl-jinja from user-story.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "title": "Action",
      "description": "When. From section 'Acceptance Criteria'."
    },
    "alternative_path": {
      "type": "string",
      "title": "Alternative path",
      "description": "Scenario 2. From section 'Acceptance Criteria'."
    },
    "benefit_value": {
      "type": "string",
      "title": "Benefit value",
      "description": "So that. From section 'Story'."
    },
    "context": {
      "type": "string",
      "title": "Context",
      "description": "Given. From section 'Acceptance Criteria'."
    },
    "error_exception_path": {
      "type": "string",
      "title": "Error exception path",
      "description": "Scenario 3. From section 'Acceptance Criteria'."
    },
    "expected_result": {
      "type": "string",
      "title": "Expected result",
      "description": "Then. From section 'Acceptance Criteria'."
    },
    "goal_desire": {
      "type": "string",
      "title": "Goal desire",
      "description": "I want. From section 'Story'."
    },
    "happy_path": {
      "type": "string",
      "title": "Happy path",
      "description": "Scenario 1. From section 'Acceptance Criteria'."
    },
    "id": {
      "type": "string",
      "title": "Id",
      "description": "User Story."
    },
    "parent_epic": {
      "type": "string",
      "title": "Parent epic",
      "description": "Epic. From section 'User Story'."
    },
    "r1_r2_r3": {
      "type": "string",
      "title": "R1 r2 r3",
      "description": "Release. From section 'Details'."
    },
    "related_story_ids": {
      "type": "string",
      "title": "Related story ids",
      "description": "Dependencies. From section 'Details'."
    },
    "short_descriptive_title": {
      "type": "string",
      "title": "Short descriptive title",
      "description": "Title. From section 'User Story'."
    },
    "size": {
      "type": "string",
      "title": "Size",
      "description": "The size used under 'Details'.",
      "enum": [
        "Story points",
        "T-shirt"
      ]
    },
    "user_type_persona": {
      "type": "string",
      "title": "User type persona",
      "description": "As a. From section 'Story'."
    }
  },
  "required": [
    "action",
    "alternative_path",
    "benefit_value",
    "context",
    "error_exception_path",
    "expected_result",
    "goal_desire",
    "happy_path",
    "id",
    "parent_epic",
    "r1_r2_r3",
    "related_story_ids",
    "short_descriptive_title",
    "size",
    "user_type_persona"
  ],
  "x-faion-dictionary-refs": 0
}
