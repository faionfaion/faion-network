{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ba/interface-analysis-ba-modeling/interface-catalog.vars.schema.json",
  "title": "interface-catalog template variables",
  "description": "Values for templates/interface-catalog.md.j2 and templates/interface-catalog.html.j2. Generated by tpl-jinja from interface-catalog.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "data_dictionary": {
      "type": "string",
      "title": "Data dictionary",
      "description": "IF-002. From section 'Spec Links'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Interface Catalog'."
    },
    "open_api_url": {
      "type": "string",
      "title": "Open api url",
      "description": "IF-001. From section 'Spec Links'."
    },
    "system_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/system_name"
    }
  },
  "required": [
    "data_dictionary",
    "date",
    "open_api_url",
    "system_name"
  ],
  "x-faion-dictionary-refs": 1
}
