{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ba/stakeholder-analysis/stakeholder-profile.vars.schema.json",
  "title": "stakeholder-profile template variables",
  "description": "Values for templates/stakeholder-profile.md.j2 and templates/stakeholder-profile.html.j2. Generated by tpl-jinja from stakeholder-profile.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "title": "Action",
      "description": "Interview / Workshop / Email. From section 'Engagement History'."
    },
    "attitude_evidence": {
      "type": "string",
      "title": "Attitude evidence",
      "description": "The attitude evidence used under 'Characteristics'.",
      "enum": [
        "Verbatim quote",
        "behavioral signal"
      ]
    },
    "basis": {
      "type": "string",
      "title": "Basis",
      "description": "Power. From section 'Salience Overlay (for high-stakes initiatives)'."
    },
    "brief_summary": {
      "type": "string",
      "title": "Brief summary",
      "description": "Interview / Workshop / Email. From section 'Engagement History'."
    },
    "concern_2": {
      "type": "string",
      "title": "Concern 2",
      "description": "The concern 2 used under 'Concerns'."
    },
    "constraints": {
      "type": "string",
      "title": "Constraints",
      "description": "Timezone/Availability. From section 'Communication Preferences'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Engagement History'."
    },
    "dept": {
      "type": "string",
      "title": "Dept",
      "description": "Department. From section 'Basic Information'."
    },
    "domain_expertise": {
      "type": "string",
      "title": "Domain expertise",
      "description": "Knowledge Area. From section 'Characteristics'."
    },
    "email": {
      "type": "string",
      "title": "Email",
      "description": "Contact. From section 'Basic Information'."
    },
    "last_reviewed_date": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/last_reviewed_date"
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Initiative. From section 'Stakeholder Profile'."
    },
    "name_role": {
      "type": "string",
      "title": "Name role",
      "description": "Stakeholder Profile."
    },
    "need_2": {
      "type": "string",
      "title": "Need 2",
      "description": "The need 2 used under 'Needs and Expectations'."
    },
    "stakeholder_id": {
      "type": "integer",
      "title": "Stakeholder id",
      "description": "The stakeholder id used under 'Stakeholder Profile'."
    },
    "title": {
      "type": "string",
      "title": "Title",
      "description": "The title used under 'Basic Information'."
    }
  },
  "required": [
    "action",
    "attitude_evidence",
    "basis",
    "brief_summary",
    "concern_2",
    "constraints",
    "date",
    "dept",
    "domain_expertise",
    "email",
    "last_reviewed_date",
    "name",
    "name_role",
    "need_2",
    "stakeholder_id",
    "title"
  ],
  "x-faion-dictionary-refs": 1
}
