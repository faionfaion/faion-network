{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ba/business-process-analysis-ba-modeling/process-analysis.vars.schema.json",
  "title": "process-analysis template variables",
  "description": "Values for templates/process-analysis.md.j2 and templates/process-analysis.html.j2. Generated by tpl-jinja from process-analysis.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "activity": {
      "type": "string",
      "title": "Activity",
      "description": "The activity used under 'Value Classification'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Process Analysis'."
    },
    "frequency": {
      "type": "string",
      "title": "Frequency",
      "description": "The frequency used under 'Pain Points'."
    },
    "issue": {
      "type": "string",
      "title": "Issue",
      "description": "The issue used under 'Pain Points'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Analyst. From section 'Process Analysis'."
    },
    "opportunity": {
      "type": "string",
      "title": "Opportunity",
      "description": "The opportunity used under 'Improvement Opportunities (max 5, ranked by effort/benefit)'."
    },
    "process_name": {
      "type": "string",
      "title": "Process name",
      "description": "Process Analysis."
    },
    "score": {
      "type": "string",
      "title": "Score",
      "description": "Eliminate/automate/simplify/integrate/parallelize. From section 'Improvement Opportunities (max 5, ranked by effort/benefit)'."
    },
    "time": {
      "type": "string",
      "title": "Time",
      "description": "The time used under 'Bottlenecks'."
    },
    "value_source": {
      "type": "string",
      "title": "Value source",
      "description": "1 VA/BN/NVA. From section 'Value Classification'."
    },
    "x": {
      "type": "string",
      "title": "X",
      "description": "Value-Adding. From section 'Value Classification'."
    }
  },
  "required": [
    "activity",
    "date",
    "frequency",
    "issue",
    "name",
    "opportunity",
    "process_name",
    "score",
    "time",
    "value_source",
    "x"
  ],
  "x-faion-dictionary-refs": 0
}
