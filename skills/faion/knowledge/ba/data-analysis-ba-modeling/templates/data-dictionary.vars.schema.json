{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ba/data-analysis-ba-modeling/data-dictionary.vars.schema.json",
  "title": "data-dictionary template variables",
  "description": "Values for templates/data-dictionary.md.j2 and templates/data-dictionary.html.j2. Generated by tpl-jinja from data-dictionary.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "attr_1": {
      "type": "string",
      "title": "Attr 1",
      "description": "The attr 1 used under 'Example Records'."
    },
    "attr_2": {
      "type": "string",
      "title": "Attr 2",
      "description": "The attr 2 used under 'Example Records'."
    },
    "attr_3": {
      "type": "string",
      "title": "Attr 3",
      "description": "The attr 3 used under 'Example Records'."
    },
    "author_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/author_name"
        }
      ],
      "description": "Author. From section 'Data Dictionary'."
    },
    "business_meaning": {
      "type": "string",
      "title": "Business meaning",
      "description": "The business meaning used under 'Attributes'."
    },
    "cross_field_constraint": {
      "type": "string",
      "title": "Cross field constraint",
      "description": "DR-04. From section 'Business Rules'."
    },
    "entity": {
      "type": "string",
      "title": "Entity",
      "description": "The entity used under 'Relationships'."
    },
    "entity_name": {
      "type": "string",
      "title": "Entity name",
      "description": "Entity. From section 'Data Dictionary'."
    },
    "format_spec": {
      "type": "string",
      "title": "Format spec",
      "description": "The format spec used under 'Attributes'."
    },
    "formula": {
      "type": "string",
      "title": "Formula",
      "description": "DR-02. From section 'Business Rules'."
    },
    "key_definition": {
      "type": "string",
      "title": "Key definition",
      "description": "DR-05. From section 'Business Rules'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "The name used under 'Attributes'."
    },
    "owner": {
      "type": "string",
      "title": "Owner",
      "description": "The owner used under 'Entity'.",
      "enum": [
        "Data owner — team",
        "role"
      ]
    },
    "rule": {
      "type": "string",
      "title": "Rule",
      "description": "DR-01. From section 'Business Rules'."
    },
    "rule_ids": {
      "type": "string",
      "title": "Rule ids",
      "description": "Y/N. From section 'Attributes'."
    },
    "system_domain_name": {
      "type": "string",
      "title": "System domain name",
      "description": "Data Dictionary."
    },
    "type": {
      "type": "string",
      "title": "Type",
      "description": "The type used under 'Attributes'."
    },
    "value": {
      "type": "string",
      "title": "Value",
      "description": "The value used under 'Example Records'."
    },
    "where_data_originates": {
      "type": "string",
      "title": "Where data originates",
      "description": "Source. From section 'Entity'."
    },
    "y_n": {
      "type": "string",
      "title": "Y n",
      "description": "Y/N. From section 'Attributes'.",
      "enum": [
        "Values",
        "range"
      ]
    }
  },
  "required": [
    "attr_1",
    "attr_2",
    "attr_3",
    "author_name",
    "business_meaning",
    "cross_field_constraint",
    "entity",
    "entity_name",
    "format_spec",
    "formula",
    "key_definition",
    "name",
    "owner",
    "rule",
    "rule_ids",
    "system_domain_name",
    "type",
    "value",
    "where_data_originates",
    "y_n"
  ],
  "x-faion-dictionary-refs": 1
}
