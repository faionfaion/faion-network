{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ba/data-analysis-ba-modeling/data-quality-assessment.vars.schema.json",
  "title": "data-quality-assessment template variables",
  "description": "Values for templates/data-quality-assessment.md.j2 and templates/data-quality-assessment.html.j2. Generated by tpl-jinja from data-quality-assessment.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "title": "Action",
      "description": "The action used under 'Recommendations'."
    },
    "data_domain": {
      "type": "string",
      "title": "Data domain",
      "description": "Data Quality Assessment."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "Assessment Date. From section 'Data Quality Assessment'."
    },
    "field_x": {
      "type": "string",
      "title": "Field x",
      "description": "Finding. From section 'Completeness'."
    },
    "issue": {
      "type": "string",
      "title": "Issue",
      "description": "The issue used under 'Recommendations'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Assessor. From section 'Data Quality Assessment'."
    },
    "sample_size": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/sample_size"
    },
    "source_system": {
      "type": "string",
      "title": "Source system",
      "description": "Data Source. From section 'Data Quality Assessment'."
    },
    "x": {
      "type": "string",
      "title": "X",
      "description": "Finding. From section 'Accuracy'."
    },
    "x_hours_days": {
      "type": "string",
      "title": "X hours days",
      "description": "Finding. From section 'Timeliness'."
    },
    "y": {
      "type": "string",
      "title": "Y",
      "description": "Finding. From section 'Completeness'."
    }
  },
  "required": [
    "action",
    "data_domain",
    "date",
    "field_x",
    "issue",
    "name",
    "sample_size",
    "source_system",
    "x",
    "x_hours_days",
    "y"
  ],
  "x-faion-dictionary-refs": 1
}
