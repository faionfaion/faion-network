{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ba/use-case-modeling/uc-spec.vars.schema.json",
  "title": "uc-spec template variables",
  "description": "Values for templates/uc-spec.md.j2 and templates/uc-spec.html.j2. Generated by tpl-jinja from uc-spec.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "title": "Action",
      "description": "The action used under 'AF-1'."
    },
    "another_precondition": {
      "type": "string",
      "title": "Another precondition",
      "description": "The another precondition used under 'Preconditions'."
    },
    "condition": {
      "type": "string",
      "title": "Condition",
      "description": "Trigger. From section 'AF-1'."
    },
    "draft_review_approved": {
      "type": "string",
      "title": "Draft review approved",
      "description": "Status. From section 'Use Case'."
    },
    "error_condition": {
      "type": "string",
      "title": "Error condition",
      "description": "Trigger. From section 'EX-1'."
    },
    "includes_extends_generalization": {
      "type": "string",
      "title": "Includes extends generalization",
      "description": "The includes extends generalization used under 'Related Use Cases'."
    },
    "response": {
      "type": "string",
      "title": "Response",
      "description": "The response used under 'AF-1'."
    },
    "return": {
      "type": "integer",
      "title": "Return",
      "description": "The return used under 'AF-1'."
    }
  },
  "required": [
    "action",
    "another_precondition",
    "condition",
    "draft_review_approved",
    "error_condition",
    "includes_extends_generalization",
    "response",
    "return"
  ],
  "x-faion-dictionary-refs": 0
}
