{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ba/decision-analysis-ba-modeling/decision-analysis.vars.schema.json",
  "title": "decision-analysis template variables",
  "description": "Values for templates/decision-analysis.md.j2 and templates/decision-analysis.html.j2. Generated by tpl-jinja from decision-analysis.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "constraint_1": {
      "type": "string",
      "title": "Constraint 1",
      "description": "The constraint 1 used under 'Decision Context'."
    },
    "crit_1": {
      "type": "string",
      "title": "Crit 1",
      "description": "The crit 1 used under 'Evaluation Matrix'."
    },
    "criterion": {
      "type": "string",
      "title": "Criterion",
      "description": "The criterion used under 'Criteria and Weights (lock before scoring)'."
    },
    "date_criteria_locked": {
      "type": "string",
      "title": "Date criteria locked",
      "description": "Date. From section 'Decision Analysis'."
    },
    "decision_topic": {
      "type": "string",
      "title": "Decision topic",
      "description": "Decision Analysis."
    },
    "objective_1": {
      "type": "string",
      "title": "Objective 1",
      "description": "The objective 1 used under 'Decision Context'."
    },
    "option_1": {
      "type": "string",
      "title": "Option 1",
      "description": "The option 1 used under 'Sensitivity Analysis'."
    },
    "option_x": {
      "type": "string",
      "title": "Option x",
      "description": "Recommended Option. From section 'Recommendation'."
    },
    "plan": {
      "type": "string",
      "title": "Plan",
      "description": "Mitigation. From section 'Recommendation'."
    },
    "pre_mortem_finding": {
      "type": "string",
      "title": "Pre mortem finding",
      "description": "The pre mortem finding used under 'Recommendation'."
    },
    "risk": {
      "type": "string",
      "title": "Risk",
      "description": "1. From section 'Recommendation'."
    },
    "score": {
      "type": "string",
      "title": "Score",
      "description": "X%. From section 'Evaluation Matrix'."
    },
    "verifiable_benefits": {
      "type": "string",
      "title": "Verifiable benefits",
      "description": "Pros. From section 'Option 1'."
    },
    "verifiable_drawbacks": {
      "type": "string",
      "title": "Verifiable drawbacks",
      "description": "Cons. From section 'Option 1'."
    },
    "what_was_decided": {
      "type": "string",
      "title": "What was decided",
      "description": "Final Decision. From section 'Approval'."
    }
  },
  "required": [
    "constraint_1",
    "crit_1",
    "criterion",
    "date_criteria_locked",
    "decision_topic",
    "objective_1",
    "option_1",
    "option_x",
    "plan",
    "pre_mortem_finding",
    "risk",
    "score",
    "verifiable_benefits",
    "verifiable_drawbacks",
    "what_was_decided"
  ],
  "x-faion-dictionary-refs": 0
}
