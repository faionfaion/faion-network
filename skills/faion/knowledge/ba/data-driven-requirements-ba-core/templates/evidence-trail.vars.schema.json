      "description": "The current numeric used under 'Baseline'."
    },
    "data_source_window": {
      "type": "string",
      "title": "Data source window",
      "description": "Signal. From section 'Evidence Trail'."
    },
    "numeric": {
      "type": "string",
      "title": "Numeric",
      "description": "Metric. From section 'Evidence Trail'."
    },
    "req_id": {
      "type": "string",
      "title": "Req id",
      "description": "Evidence Trail."
    },
    "target_numeric_date": {
      "type": "string",
      "title": "Target numeric date",
      "description": "The target numeric date used under 'Target'."
    }
  },
  "required": [
    "current_numeric",
    "data_source_window",
    "numeric",
    "req_id",
    "target_numeric_date"
  ],
  "x-faion-dictionary-refs": 0
