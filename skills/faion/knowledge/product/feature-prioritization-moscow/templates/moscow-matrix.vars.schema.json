    },
    "person_days_weeks": {
      "type": "string",
      "title": "Person days weeks",
      "description": "Capacity. From section 'Context'."
    },
    "person_group": {
      "type": "string",
      "title": "Person group",
      "description": "Decided by. From section 'Sign-off'."
    },
    "project_release": {
      "type": "string",
      "title": "Project release",
      "description": "MoSCoW."
