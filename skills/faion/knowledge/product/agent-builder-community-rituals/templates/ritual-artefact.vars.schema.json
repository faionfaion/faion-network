{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/product/agent-builder-community-rituals/ritual-artefact.vars.schema.json",
  "title": "ritual-artefact template variables",
  "description": "Values for templates/ritual-artefact.md.j2 and templates/ritual-artefact.html.j2. Generated by tpl-jinja from ritual-artefact.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "iso_date": {
      "type": "string",
      "title": "Iso date",
      "description": "Session date."
    },
    "number": {
      "type": "string",
      "title": "Number",
      "description": "90-day retention pct. From section 'Retention update'."
    },
    "person": {
      "type": "string",
      "title": "Person",
      "description": "Host.",
      "x-faion-sensitive": true,
      "x-faion-placeholder": "<PERSON>"
    },
    "type": {
      "type": "string",
      "title": "Type",
      "description": "The type used under 'Artefact produced'.",
      "enum": [
        "eval-row",
        "prompt-diff",
        "runbook-update"
      ]
    },
    "url": {
      "type": "string",
      "title": "Url",
      "description": "Link. From section 'Artefact produced'."
    }
  },
  "required": [
    "iso_date",
    "number",
    "type",
    "url"
  ],
  "x-faion-dictionary-refs": 0
}
