{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/product/okr-setting/okr-setting.vars.schema.json",
  "title": "okr-setting template variables",
  "description": "Values for templates/okr-setting.md.j2 and templates/okr-setting.html.j2. Generated by tpl-jinja from okr-setting.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artefact_id": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/artefact_id"
        }
      ],
      "description": "OKR Setting."
    },
    "document_version": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/document_version"
        }
      ],
      "description": "Version (string). From section 'OKR Setting'."
    },
    "iso_start_end": {
      "type": "string",
      "title": "Iso start end",
      "description": "Quarter dates (object). From section 'OKR Setting'."
    },
    "last_reviewed_date": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/last_reviewed_date"
        }
      ],
      "description": "Last reviewed (date). From section 'OKR Setting'."
    },
    "yyyy_qn": {
      "type": "string",
      "title": "Yyyy qn",
      "description": "Quarter (string). From section 'OKR Setting'."
    }
  },
  "required": [
    "artefact_id",
    "iso_start_end",
    "last_reviewed_date",
    "yyyy_qn"
  ],
  "x-faion-dictionary-refs": 3
}
