{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/product/mvp-scoping/mvp-scoping.vars.schema.json",
  "title": "mvp-scoping template variables",
  "description": "Values for templates/mvp-scoping.md.j2 and templates/mvp-scoping.html.j2. Generated by tpl-jinja from mvp-scoping.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artefact_id": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/artefact_id"
        }
      ],
      "description": "MVP Scoping."
    },
    "document_version": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/document_version"
    },
    "last_reviewed_date": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/last_reviewed_date"
    },
    "named_product": {
      "type": "string",
      "title": "Named product",
      "description": "Product name (string). From section 'MVP Scoping'."
    },
    "ordered_step_list": {
      "type": "string",
      "title": "Ordered step list",
      "description": "Must have journey (array). From section 'MVP Scoping'."
    },
    "owner_full_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_full_name"
    },
    "single_moment_statement": {
      "type": "string",
      "title": "Single moment statement",
      "description": "Aha moment (string). From section 'MVP Scoping'."
    }
  },
  "required": [
    "artefact_id",
    "last_reviewed_date",
    "named_product",
    "ordered_step_list",
    "single_moment_statement"
  ],
  "x-faion-dictionary-refs": 4
}
