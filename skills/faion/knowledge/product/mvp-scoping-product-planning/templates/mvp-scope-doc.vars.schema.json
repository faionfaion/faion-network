{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/product/mvp-scoping-product-planning/mvp-scope-doc.vars.schema.json",
  "title": "mvp-scope-doc template variables",
  "description": "Values for templates/mvp-scope-doc.md.j2 and templates/mvp-scope-doc.html.j2. Generated by tpl-jinja from mvp-scope-doc.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "baseline": {
      "type": "string",
      "title": "Baseline",
      "description": "Performance. From section 'Non-Functional Requirements'."
    },
    "current_needs_only": {
      "type": "string",
      "title": "Current needs only",
      "description": "Scalability. From section 'Non-Functional Requirements'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "If < by. From section 'Kill Criterion'."
    },
    "days": {
      "type": "string",
      "title": "Days",
      "description": "The days used under 'Must Have (MVP)'."
    },
    "hypothesis": {
      "type": "string",
      "title": "Hypothesis",
      "description": "Our MVP proves. From section 'Problem Statement'."
    },
    "job": {
      "type": "string",
      "title": "Job",
      "description": "Primary job to be done. From section 'Core Value'."
    },
    "metric": {
      "type": "string",
      "title": "Metric",
      "description": "If. From section 'Kill Criterion'."
    },
    "metric_1": {
      "type": "string",
      "title": "Metric 1",
      "description": "The metric 1 used under 'Learning Goals'."
    },
    "metric_2": {
      "type": "string",
      "title": "Metric 2",
      "description": "The metric 2 used under 'Learning Goals'."
    },
    "minimum": {
      "type": "string",
      "title": "Minimum",
      "description": "Security. From section 'Non-Functional Requirements'."
    },
    "next_action": {
      "type": "string",
      "title": "Next action",
      "description": "If validated →. From section 'Next Steps After MVP'."
    },
    "outcome": {
      "type": "string",
      "title": "Outcome",
      "description": "By delivering. From section 'Problem Statement'."
    },
    "pivot_plan": {
      "type": "string",
      "title": "Pivot plan",
      "description": "If not validated →. From section 'Next Steps After MVP'."
    },
    "problem": {
      "type": "string",
      "title": "Problem",
      "description": "Who. From section 'Problem Statement'."
    },
    "product_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/product_name"
    },
    "question_1": {
      "type": "string",
      "title": "Question 1",
      "description": "1. From section 'Learning Goals'."
    },
    "question_2": {
      "type": "string",
      "title": "Question 2",
      "description": "2. From section 'Learning Goals'."
    },
    "reason": {
      "type": "string",
      "title": "Reason",
      "description": "The reason used under 'Should Have (Post-MVP)'."
    },
    "resources_available": {
      "type": "string",
      "title": "Resources available",
      "description": "Team. From section 'Constraints'."
    },
    "target_user": {
      "type": "string",
      "title": "Target user",
      "description": "For. From section 'Problem Statement'."
    },
    "why_explicitly_excluded": {
      "type": "string",
      "title": "Why explicitly excluded",
      "description": "The why explicitly excluded used under 'Won't Have (Out of Scope)'."
    }
  },
  "required": [
    "baseline",
    "current_needs_only",
    "date",
    "days",
    "hypothesis",
    "job",
    "metric",
    "metric_1",
    "metric_2",
    "minimum",
    "next_action",
    "outcome",
    "pivot_plan",
    "problem",
    "product_name",
    "question_1",
    "question_2",
    "reason",
    "resources_available",
    "target_user",
    "why_explicitly_excluded"
  ],
  "x-faion-dictionary-refs": 1
}
