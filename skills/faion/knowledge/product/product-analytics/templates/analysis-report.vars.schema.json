{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/product/product-analytics/analysis-report.vars.schema.json",
  "title": "analysis-report template variables",
  "description": "Values for templates/analysis-report.md.j2 and templates/analysis-report.html.j2. Generated by tpl-jinja from analysis-report.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "concrete_action": {
      "type": "string",
      "title": "Concrete action",
      "description": "2. From section 'Recommendations'."
    },
    "data": {
      "type": "string",
      "title": "Data",
      "description": "The data used under 'Key Insight 2'."
    },
    "data_source": {
      "type": "string",
      "title": "Data source",
      "description": "The data source used under 'Methodology'.",
      "enum": [
        "PostHog",
        "Amplitude",
        "warehouse",
        "export file"
      ]
    },
    "end_date": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/end_date"
    },
    "n_required_field": {
      "type": "string",
      "title": "N required field",
      "description": "Sample size (n users). From section 'Methodology'."
    },
    "start_date": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/start_date"
    },
    "topic": {
      "type": "string",
      "title": "Topic",
      "description": "Analytics."
    }
  },
  "required": [
    "concrete_action",
    "data",
    "data_source",
    "end_date",
    "n_required_field",
    "start_date",
    "topic"
  ],
  "x-faion-dictionary-refs": 2
}
