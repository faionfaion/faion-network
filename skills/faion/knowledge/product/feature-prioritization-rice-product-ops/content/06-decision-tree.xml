<?xml version="1.0" encoding="UTF-8"?>
<text id="06-decision-tree" title="Feature Prioritisation — RICE Decision Tree" version="1.0.1" est_tokens="400" depth="essential">
  <summary>Routing tree mapping observable inputs to a rule from `01-core-rules.xml`. MANDATORY for every methodology — even flat ones — per F-066 DoD.</summary>

  <decision-tree>
    <root-question id="q-root">Do all Applies-If preconditions hold AND no Skip-If disqualifier is true?</root-question>
    <branch when="preconditions_satisfied == true">
      <question id="q-sub">Are required inputs present AND aligned with the rubric?</question>
      <branch when="required_inputs_present == true AND reach_units_mixed == true">
        <conclusion ref="r6-reach-unit-consistent"/>
      </branch>
      <branch when="required_inputs_present == true AND items_without_evidence_scored_above_50 &gt; 0">
        <conclusion ref="r8-confidence-cap-without-evidence"/>
      </branch>
      <branch when="required_inputs_present == true AND r1_rice_formula_check == true">
        <conclusion ref="r3-effort-ceiling"/>
      </branch>
      <branch when="NOT (required_inputs_present == true AND r1_rice_formula_check == true)">
        <conclusion ref="r1-rice-formula"/>
      </branch>
    </branch>
    <branch when="NOT (preconditions_satisfied == true)">
      <conclusion ref="skip-this-methodology"/>
    </branch>
  </decision-tree>

  <example trace="apply-path">
    All preconditions satisfied → conclusion r3-effort-ceiling.
  </example>
</text>
