{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/product/spec-writing/prd.vars.schema.json",
  "title": "prd template variables",
  "description": "Values for templates/prd.md.j2 and templates/prd.html.j2. Generated by tpl-jinja from prd.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "title": "Action",
      "description": "US-1. From section 'Primary User'."
    },
    "answer": {
      "type": "string",
      "title": "Answer",
      "description": "Resolved. From section 'Open Questions'."
    },
    "context": {
      "type": "string",
      "title": "Context",
      "description": "Given. From section 'FR-1'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "Created. From section 'Metadata'."
    },
    "feature": {
      "type": "string",
      "title": "Feature",
      "description": "The feature used under 'Out of Scope'."
    },
    "goal_2": {
      "type": "string",
      "title": "Goal 2",
      "description": "2. From section 'Goals'."
    },
    "link": {
      "type": "string",
      "title": "Link",
      "description": "Design doc. From section 'Related Documents'."
    },
    "measurable_benefit": {
      "type": "string",
      "title": "Measurable benefit",
      "description": "US-1. From section 'Primary User'."
    },
    "metric_1": {
      "type": "string",
      "title": "Metric 1",
      "description": "The metric 1 used under 'Success Metrics'."
    },
    "metric_2": {
      "type": "string",
      "title": "Metric 2",
      "description": "The metric 2 used under 'Success Metrics'."
    },
    "observable_result": {
      "type": "string",
      "title": "Observable result",
      "description": "Given , when , then. From section 'FR-1'."
    },
    "persona": {
      "type": "string",
      "title": "Persona",
      "description": "US-1. From section 'Primary User'."
    },
    "persona_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/persona_name"
        }
      ],
      "description": "Primary User. From section 'User Stories'."
    },
    "question_1": {
      "type": "string",
      "title": "Question 1",
      "description": "The question 1 used under 'Open Questions'."
    },
    "question_2": {
      "type": "string",
      "title": "Question 2",
      "description": "The question 2 used under 'Open Questions'."
    },
    "specific_pain_2": {
      "type": "string",
      "title": "Specific pain 2",
      "description": "2. From section 'Pain Points'."
    },
    "specific_pain_3": {
      "type": "string",
      "title": "Specific pain 3",
      "description": "3. From section 'Pain Points'."
    },
    "specific_requirement_source": {
      "type": "string",
      "title": "Specific requirement source",
      "description": "NFR-2. From section 'Non-Functional Requirements'."
    }
  },
  "required": [
    "action",
    "answer",
    "context",
    "date",
    "feature",
    "goal_2",
    "link",
    "measurable_benefit",
    "metric_1",
    "metric_2",
    "observable_result",
    "persona",
    "persona_name",
    "question_1",
    "question_2",
    "specific_pain_2",
    "specific_pain_3",
    "specific_requirement_source"
  ],
  "x-faion-dictionary-refs": 1
}
