{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/product/micro-mvps/micro-mvps.vars.schema.json",
  "title": "micro-mvps template variables",
  "description": "Values for templates/micro-mvps.md.j2 and templates/micro-mvps.html.j2. Generated by tpl-jinja from micro-mvps.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artefact_id": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/artefact_id"
        }
      ],
      "description": "Micro MVPs."
    },
    "document_version": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/document_version"
    },
    "go_kill_iterate": {
      "type": "string",
      "title": "Go kill iterate",
      "description": "Decision (string). From section 'Micro MVPs'."
    },
    "last_reviewed_date": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/last_reviewed_date"
    },
    "named_gate": {
      "type": "string",
      "title": "Named gate",
      "description": "Gate event (string). From section 'Micro MVPs'."
    },
    "numeric_gate": {
      "type": "string",
      "title": "Numeric gate",
      "description": "Gate threshold (number). From section 'Micro MVPs'."
    },
    "owner_full_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_full_name"
    }
  },
  "required": [
    "artefact_id",
    "go_kill_iterate",
    "last_reviewed_date",
    "named_gate",
    "numeric_gate"
  ],
  "x-faion-dictionary-refs": 4
}
