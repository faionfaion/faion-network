{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/product/agent-pricing-and-unit-economics/cap-policy.vars.schema.json",
  "title": "cap-policy template variables",
  "description": "Values for templates/cap-policy.md.j2 and templates/cap-policy.html.j2. Generated by tpl-jinja from cap-policy.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "n_tasks": {
      "type": "string",
      "title": "N tasks",
      "description": "Monthly cap. From section 'Threshold'."
    },
    "support_channel": {
      "type": "string",
      "title": "Support channel",
      "description": "Contact. From section 'Appeal / override'."
    },
    "tier": {
      "type": "string",
      "title": "Tier",
      "description": "Fair-use cap policy."
    },
    "when_where": {
      "type": "string",
      "title": "When where",
      "description": "Notification. From section 'What happens at the cap'."
    }
  },
  "required": [
    "n_tasks",
    "support_channel",
    "tier",
    "when_where"
  ],
  "x-faion-dictionary-refs": 0
}
