<?xml version="1.0" encoding="UTF-8"?>
<text id="06-decision-tree" title="Roadmap Design Decision Tree" version="1.0.1" est_tokens="700" depth="essential">
  <summary>Routing tree mapping observable inputs to a rule from `01-core-rules.xml`. MANDATORY for every methodology — even flat ones — per F-066 DoD.</summary>

  <decision-tree>
    <root-question id="q-root">Do all Applies-If preconditions hold AND no Skip-If disqualifier is true?</root-question>
    <branch when="preconditions_satisfied == true">
      <question id="q-format">Has the format been selected from the uncertainty level rather than from audience preference?</question>
      <branch when="format_selected_from_uncertainty == false">
        <conclusion ref="r6-format-by-uncertainty"/>
      </branch>
      <branch when="format_selected_from_uncertainty == true">
        <question id="q-audience">Does the roadmap leave the team — is there an external audience?</question>
        <branch when="external_audience == true AND external_view_derived == false">
          <conclusion ref="r7-one-source-many-views"/>
        </branch>
        <branch when="external_audience == true AND external_view_carries_targets == true">
          <conclusion ref="r8-no-external-metric-targets"/>
        </branch>
        <branch when="external_audience == true AND external_view_human_reviewed == false">
          <conclusion ref="r18-human-review-external"/>
        </branch>
        <branch when="not_doing_list_present == false">
          <conclusion ref="r10-not-doing-list"/>
        </branch>
        <branch when="orphaned_initiatives == true">
          <conclusion ref="r16-objective-link"/>
        </branch>
        <branch when="now_initiative_count &gt; 5">
          <conclusion ref="r14-now-cap-five"/>
        </branch>
        <branch when="theme_count &lt; 3 OR theme_count &gt; 5">
          <conclusion ref="r12-three-to-five-themes"/>
        </branch>
        <branch when="NOT (required_inputs_present == true AND r1_outcome_not_feature_check == true)">
          <conclusion ref="r1-outcome-not-feature"/>
        </branch>
        <branch when="required_inputs_present == true AND r1_outcome_not_feature_check == true">
          <conclusion ref="r3-confidence-labels"/>
        </branch>
      </branch>
    </branch>
    <branch when="NOT (preconditions_satisfied == true)">
      <conclusion ref="skip-this-methodology"/>
    </branch>
  </decision-tree>

  <example trace="apply-path">
    All preconditions satisfied, format derived from uncertainty, external view derived, stripped and human-reviewed, not-doing list present, every initiative linked to an objective, Now ≤ 5, 3–5 themes → conclusion r3-confidence-labels.
  </example>
</text>
