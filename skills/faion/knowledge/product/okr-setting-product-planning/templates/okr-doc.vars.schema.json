{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/product/okr-setting-product-planning/okr-doc.vars.schema.json",
  "title": "okr-doc template variables",
  "description": "Values for templates/okr-doc.md.j2 and templates/okr-doc.html.j2. Generated by tpl-jinja from okr-doc.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "inspiring_goal_statement": {
      "type": "string",
      "title": "Inspiring goal statement",
      "description": "Objective 1. From section 'OKRs'."
    },
    "last_reviewed_date": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/last_reviewed_date"
    },
    "owner_full_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_full_name"
    },
    "quarter_year": {
      "type": "string",
      "title": "Quarter year",
      "description": "OKRs."
    },
    "strategic_connection": {
      "type": "string",
      "title": "Strategic connection",
      "description": "Why this matters. From section 'Objective 2'."
    },
    "team_product": {
      "type": "string",
      "title": "Team product",
      "description": "OKRs."
    }
  },
  "required": [
    "inspiring_goal_statement",
    "last_reviewed_date",
    "quarter_year",
    "strategic_connection",
    "team_product"
  ],
  "x-faion-dictionary-refs": 2
}
