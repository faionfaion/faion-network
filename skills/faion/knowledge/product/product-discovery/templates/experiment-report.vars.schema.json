  "required": [
    "assumption",
    "key_insight_1",
    "kill_threshold",
    "metric",
    "metric_1",
    "metric_2",
    "name",
    "observation_1",
    "observation_2",
    "specific_metric_threshold",
    "threshold",
    "x_days"
