{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/product/product-discovery/experiment-report.vars.schema.json",
  "title": "experiment-report template variables",
  "description": "Values for templates/experiment-report.md.j2 and templates/experiment-report.html.j2. Generated by tpl-jinja from experiment-report.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "assumption": {
      "type": "string",
      "title": "Assumption",
      "description": "We believe. From section 'Hypothesis'."
    },
    "key_insight_1": {
      "type": "string",
      "title": "Key insight 1",
      "description": "The key insight 1 used under 'Learnings'."
    },
    "kill_threshold": {
      "type": "string",
      "title": "Kill threshold",
      "description": "Kill. From section 'Thresholds'."
    },
    "metric": {
      "type": "string",
      "title": "Metric",
      "description": "Success. From section 'Thresholds'."
    },
    "metric_1": {
      "type": "string",
      "title": "Metric 1",
      "description": "The metric 1 used under 'Results'."
    },
    "metric_2": {
      "type": "string",
      "title": "Metric 2",
      "description": "The metric 2 used under 'Results'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Experiment."
    },
    "observation_1": {
      "type": "string",
      "title": "Observation 1",
      "description": "The observation 1 used under 'Observations'."
    },
    "observation_2": {
      "type": "string",
      "title": "Observation 2",
      "description": "The observation 2 used under 'Observations'."
    },
    "specific_metric_threshold": {
      "type": "string",
      "title": "Specific metric threshold",
      "description": "We will know we're right when. From section 'Hypothesis'."
    },
    "threshold": {
      "type": "string",
      "title": "Threshold",
      "description": "Success. From section 'Thresholds'."
    },
    "x_days": {
      "type": "string",
      "title": "X days",
      "description": "Duration. From section 'Setup'."
    }
