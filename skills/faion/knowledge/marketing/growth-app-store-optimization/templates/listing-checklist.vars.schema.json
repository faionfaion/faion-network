  "additionalProperties": false,
  "properties": {
    "added": {
      "type": "string",
      "title": "Added",
      "description": "Tags. From section 'Store Settings'."
    },
    "brand_primary_keyword": {
      "type": "string",
      "title": "Brand primary keyword",
      "description": "Title (50 chars max). From section 'Metadata'."
    },
    "selected": {
      "type": "string",
      "title": "Selected",
      "description": "Category. From section 'Store Settings'."
    },
    "set": {
      "type": "string",
      "title": "Set",
      "description": "Contact email. From section 'Store Settings'."
    }
  },
  "required": [
    "added",
    "brand_primary_keyword",
    "selected",
    "set"
  ],
  "x-faion-dictionary-refs": 0
