{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/marketing/ops-subscription-models/subscription-model-doc.vars.schema.json",
  "title": "subscription-model-doc template variables",
  "description": "Values for templates/subscription-model-doc.md.j2 and templates/subscription-model-doc.html.j2. Generated by tpl-jinja from subscription-model-doc.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "limit": {
      "type": "string",
      "title": "Limit",
      "description": "Free. From section 'Tiers'."
    },
    "product_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/product_name"
    },
    "usage_component": {
      "type": "string",
      "title": "Usage component",
      "description": "The usage component used under 'Billing'.",
      "enum": [
        "Yes — $X per unit",
        "No"
      ]
    }
  },
  "required": [
    "limit",
    "product_name",
    "usage_component"
  ],
  "x-faion-dictionary-refs": 1
}
