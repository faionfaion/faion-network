{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/marketing/ads-linkedin-ads/campaign-checklist.vars.schema.json",
  "title": "campaign-checklist template variables",
  "description": "Values for templates/campaign-checklist.md.j2 and templates/campaign-checklist.html.j2. Generated by tpl-jinja from campaign-checklist.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "campaign_name": {
      "type": "string",
      "title": "Campaign name",
      "description": "LinkedIn Campaign Checklist."
    },
    "cta_selected": {
      "type": "string",
      "title": "Cta selected",
      "description": "The cta selected used under 'Creative'.",
      "enum": [
        "Learn More",
        "Download",
        "Sign Up",
        "Request Demo"
      ]
    },
    "end_date": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/end_date"
    },
    "estimated_audience_size": {
      "type": "integer",
      "title": "Estimated audience size",
      "description": "The estimated audience size used under 'Targeting'."
    },
    "format": {
      "type": "string",
      "title": "Format",
      "description": "The format used under 'Creative'.",
      "enum": [
        "Single Image",
        "Carousel",
        "Video",
        "LGF"
      ]
    },
    "list": {
      "type": "string",
      "title": "List",
      "description": "Location. From section 'Targeting'."
    },
    "range": {
      "type": "string",
      "title": "Range",
      "description": "Company size. From section 'Targeting'."
    },
    "start_date": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/start_date"
    }
  },
  "required": [
    "campaign_name",
    "cta_selected",
    "end_date",
    "estimated_audience_size",
    "format",
    "list",
    "range",
    "start_date"
  ],
  "x-faion-dictionary-refs": 2
}
