      "description": "Contractor Review."
    },
    "next_review_date": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/next_review_date"
    }
  },
  "required": [
    "describe",
    "name",
    "next_review_date"
  ],
  "x-faion-dictionary-refs": 1
}
