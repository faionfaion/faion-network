{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/marketing/proposal-from-discovery-template/skeleton.vars.schema.json",
  "title": "skeleton template variables",
  "description": "Values for templates/skeleton.md.j2 and templates/skeleton.html.j2. Generated by tpl-jinja from skeleton.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "title": "Action",
      "description": "The action used under 'Actions'."
    },
    "amount": {
      "type": "string",
      "title": "Amount",
      "description": "Price. From section 'Option 1 — Light (fixed)'."
    },
    "base": {
      "type": "string",
      "title": "Base",
      "description": "Price. From section 'Option 3 — Outcome-based'."
    },
    "client": {
      "type": "string",
      "title": "Client",
      "description": "Title."
    },
    "client_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/client_name"
    },
    "duration": {
      "type": "integer",
      "title": "Duration",
      "description": "The duration used under 'Option 1 — Light (fixed)'."
    },
    "evidence_url_1": {
      "type": "string",
      "title": "Evidence url 1",
      "description": "The evidence url 1 used under 'Evidence'."
    },
    "evidence_url_2": {
      "type": "string",
      "title": "Evidence url 2",
      "description": "The evidence url 2 used under 'Evidence'."
    },
    "full_scope": {
      "type": "string",
      "title": "Full scope",
      "description": "Scope. From section 'Option 2 — Standard (fixed)'."
    },
    "metric_threshold": {
      "type": "string",
      "title": "Metric threshold",
      "description": "Price. From section 'Option 3 — Outcome-based'."
    },
    "next_action_owner": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/next_action_owner"
    },
    "owner_full_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_full_name"
        }
      ],
      "description": "Owner."
    },
    "success_fee": {
      "type": "string",
      "title": "Success fee",
      "description": "Price. From section 'Option 3 — Outcome-based'."
    }
  },
  "required": [
    "action",
    "amount",
    "base",
    "client",
    "client_name",
    "duration",
    "evidence_url_1",
    "evidence_url_2",
    "full_scope",
    "metric_threshold",
    "success_fee"
  ],
  "x-faion-dictionary-refs": 3
}
