{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/marketing/ops-annual-planning-templates/quarterly-review.vars.schema.json",
  "title": "quarterly-review template variables",
  "description": "Values for templates/quarterly-review.md.j2 and templates/quarterly-review.html.j2. Generated by tpl-jinja from quarterly-review.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "goal_1": {
      "type": "string",
      "title": "Goal 1",
      "description": "The goal 1 used under 'Results vs Goals'."
    },
    "goal_2": {
      "type": "string",
      "title": "Goal 2",
      "description": "The goal 2 used under 'Results vs Goals'."
    },
    "goal_3": {
      "type": "string",
      "title": "Goal 3",
      "description": "The goal 3 used under 'Results vs Goals'."
    },
    "miss_1": {
      "type": "string",
      "title": "Miss 1",
      "description": "1. From section 'Misses'."
    },
    "miss_2": {
      "type": "string",
      "title": "Miss 2",
      "description": "2. From section 'Misses'."
    },
    "structural_cause": {
      "type": "string",
      "title": "Structural cause",
      "description": "The structural cause used under 'Misses'.",
      "enum": [
        "what we under-resourced",
        "deprioritized"
      ]
    },
    "theme": {
      "type": "string",
      "title": "Theme",
      "description": "The theme used under 'Q Focus'.",
      "enum": [
        "one word",
        "phrase"
      ]
    },
    "win_1": {
      "type": "string",
      "title": "Win 1",
      "description": "1. From section 'Wins'."
    },
    "win_2": {
      "type": "string",
      "title": "Win 2",
      "description": "2. From section 'Wins'."
    },
    "win_3": {
      "type": "string",
      "title": "Win 3",
      "description": "3. From section 'Wins'."
    },
    "x_1": {
      "type": "string",
      "title": "X 1",
      "description": "[Learning 1 — actionable for Q. From section 'Key Learnings'."
    },
    "year": {
      "type": "string",
      "title": "Year",
      "description": "Q Review."
    }
  },
  "required": [
    "goal_1",
    "goal_2",
    "goal_3",
    "miss_1",
    "miss_2",
    "structural_cause",
    "theme",
    "win_1",
    "win_2",
    "win_3",
    "x_1",
    "year"
  ],
  "x-faion-dictionary-refs": 0
}
