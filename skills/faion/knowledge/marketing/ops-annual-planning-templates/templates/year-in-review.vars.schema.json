{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/marketing/ops-annual-planning-templates/year-in-review.vars.schema.json",
  "title": "year-in-review template variables",
  "description": "Values for templates/year-in-review.md.j2 and templates/year-in-review.html.j2. Generated by tpl-jinja from year-in-review.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "challenge_1": {
      "type": "string",
      "title": "Challenge 1",
      "description": "The challenge 1 used under 'Challenges'."
    },
    "challenge_2": {
      "type": "string",
      "title": "Challenge 2",
      "description": "The challenge 2 used under 'Challenges'."
    },
    "honest_assessment": {
      "type": "string",
      "title": "Honest assessment",
      "description": "Energy and satisfaction. From section 'Personal Growth'."
    },
    "lesson": {
      "type": "string",
      "title": "Lesson",
      "description": "What I learned. From section 'Challenges'."
    },
    "list": {
      "type": "string",
      "title": "List",
      "description": "Skills learned. From section 'Personal Growth'."
    },
    "measurable_outcome": {
      "type": "string",
      "title": "Measurable outcome",
      "description": "Impact. From section 'Wins'."
    },
    "response": {
      "type": "string",
      "title": "Response",
      "description": "How I handled it. From section 'Challenges'."
    },
    "significance": {
      "type": "string",
      "title": "Significance",
      "description": "Why it mattered. From section 'Wins'."
    },
    "specific_change_2": {
      "type": "string",
      "title": "Specific change 2",
      "description": "The specific change 2 used under 'What I Would Do Differently'."
    },
    "specific_change_3": {
      "type": "string",
      "title": "Specific change 3",
      "description": "The specific change 3 used under 'What I Would Do Differently'."
    },
    "structural_cause": {
      "type": "string",
      "title": "Structural cause",
      "description": "The structural cause used under 'Challenges'.",
      "enum": [
        "internal decision",
        "resource gap"
      ]
    },
    "win_1": {
      "type": "string",
      "title": "Win 1",
      "description": "The win 1 used under 'Wins'."
    },
    "win_2": {
      "type": "string",
      "title": "Win 2",
      "description": "The win 2 used under 'Wins'."
    },
    "win_3": {
      "type": "string",
      "title": "Win 3",
      "description": "The win 3 used under 'Wins'."
    }
  },
  "required": [
    "challenge_1",
    "challenge_2",
    "honest_assessment",
    "lesson",
    "list",
    "measurable_outcome",
    "response",
    "significance",
    "specific_change_2",
    "specific_change_3",
    "structural_cause",
    "win_1",
    "win_2",
    "win_3"
  ],
  "x-faion-dictionary-refs": 0
}
