{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/marketing/ops-partnership-strategy/tracker.vars.schema.json",
  "title": "tracker template variables",
  "description": "Values for templates/tracker.md.j2 and templates/tracker.html.j2. Generated by tpl-jinja from tracker.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "affiliate": {
      "type": "integer",
      "title": "Affiliate",
      "description": "The affiliate used under 'In Discussion'."
    },
    "co_marketing": {
      "type": "integer",
      "title": "Co marketing",
      "description": "Co-marketing. From section 'In Discussion'."
    },
    "declined": {
      "type": "string",
      "title": "Declined",
      "description": "The declined used under 'Closed / Declined'.",
      "enum": [
        "Yes in 6mo",
        "No"
      ]
    },
    "quarter_year": {
      "type": "string",
      "title": "Quarter year",
      "description": "Partnership Pipeline Tracker."
    },
    "reason": {
      "type": "string",
      "title": "Reason",
      "description": "Declined. From section 'Closed / Declined'."
    },
    "type": {
      "type": "string",
      "title": "Type",
      "description": "The type used under 'Closed / Declined'."
    }
  },
  "required": [
    "affiliate",
    "co_marketing",
    "declined",
    "quarter_year",
    "reason",
    "type"
  ],
  "x-faion-dictionary-refs": 0
}
