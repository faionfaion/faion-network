{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/marketing/ops-partnership-strategy/one-pager.vars.schema.json",
  "title": "one-pager template variables",
  "description": "Values for templates/one-pager.md.j2 and templates/one-pager.html.j2. Generated by tpl-jinja from one-pager.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "calendar_link": {
      "type": "string",
      "title": "Calendar link",
      "description": "Contact. From section 'Next Steps'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Partnership Proposal'."
    },
    "email": {
      "type": "string",
      "title": "Email",
      "description": "Contact. From section 'Next Steps'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Contact. From section 'Next Steps'."
    },
    "proposal_type": {
      "type": "string",
      "title": "Proposal type",
      "description": "The proposal type used under 'Partnership Proposal'.",
      "enum": [
        "Affiliate",
        "Co-marketing",
        "Integration",
        "Reseller"
      ]
    },
    "topic": {
      "type": "string",
      "title": "Topic",
      "description": "Format it takes, and the timeframe. Be concrete. From section 'The Opportunity'."
    }
  },
  "required": [
    "calendar_link",
    "date",
    "email",
    "name",
    "proposal_type",
    "topic"
  ],
  "x-faion-dictionary-refs": 0
}
