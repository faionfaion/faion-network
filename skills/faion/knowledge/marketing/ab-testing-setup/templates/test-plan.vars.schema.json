{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/marketing/ab-testing-setup/test-plan.vars.schema.json",
  "title": "test-plan template variables",
  "description": "Values for templates/test-plan.md.j2 and templates/test-plan.html.j2. Generated by tpl-jinja from test-plan.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "changed_state": {
      "type": "string",
      "title": "Changed state",
      "description": "B (Treatment). From section 'Variants'."
    },
    "current_state": {
      "type": "string",
      "title": "Current state",
      "description": "A (Control). From section 'Variants'."
    },
    "metric": {
      "type": "string",
      "title": "Metric",
      "description": "THEN. From section 'Hypothesis'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "A/B Test Plan."
    },
    "reasoning_evidence": {
      "type": "string",
      "title": "Reasoning evidence",
      "description": "BECAUSE. From section 'Hypothesis'."
    },
    "specific_change": {
      "type": "string",
      "title": "Specific change",
      "description": "IF we. From section 'Hypothesis'."
    },
    "x_relative": {
      "type": "string",
      "title": "X relative",
      "description": "THEN will improve by. From section 'Hypothesis'."
    }
  },
  "required": [
    "changed_state",
    "current_state",
    "metric",
    "name",
    "reasoning_evidence",
    "specific_change",
    "x_relative"
  ],
  "x-faion-dictionary-refs": 0
}
