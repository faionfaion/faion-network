{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/marketing/growth-seo-link-building/campaign-tracker.vars.schema.json",
  "title": "campaign-tracker template variables",
  "description": "Values for templates/campaign-tracker.md.j2 and templates/campaign-tracker.html.j2. Generated by tpl-jinja from campaign-tracker.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "content_asset_name": {
      "type": "string",
      "title": "Content asset name",
      "description": "Campaign. From section 'Link Building Campaign Tracker'."
    },
    "first_line_approach": {
      "type": "string",
      "title": "First line approach",
      "description": "Personalization. From section 'Outreach'."
    },
    "link": {
      "type": "string",
      "title": "Link",
      "description": "URL. From section 'Asset Details'."
    },
    "list": {
      "type": "string",
      "title": "List",
      "description": "Target keywords. From section 'Asset Details'."
    },
    "method": {
      "type": "string",
      "title": "Method",
      "description": "The method used under 'Prospecting'.",
      "enum": [
        "competitor analysis",
        "resource pages",
        "broken links",
        "HARO"
      ]
    },
    "number": {
      "type": "string",
      "title": "Number",
      "description": "Target sites. From section 'Prospecting'."
    },
    "template": {
      "type": "string",
      "title": "Template",
      "description": "The template used under 'Outreach'.",
      "enum": [
        "resource-page",
        "broken-link",
        "guest-post"
      ]
    },
    "type": {
      "type": "string",
      "title": "Type",
      "description": "The type used under 'Asset Details'.",
      "enum": [
        "guide",
        "tool",
        "research",
        "infographic"
      ]
    }
  },
  "required": [
    "content_asset_name",
    "first_line_approach",
    "link",
    "list",
    "method",
    "number",
    "template",
    "type"
  ],
  "x-faion-dictionary-refs": 0
}
