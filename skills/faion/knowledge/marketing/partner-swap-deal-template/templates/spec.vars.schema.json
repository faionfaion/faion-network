{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/marketing/partner-swap-deal-template/spec.vars.schema.json",
  "title": "spec template variables",
  "description": "Values for templates/spec.md.j2 and templates/spec.html.j2. Generated by tpl-jinja from spec.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "title": "Action",
      "description": "Label. From section 'Next action'."
    },
    "evidence_quote": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/evidence_quote"
    },
    "named": {
      "type": "string",
      "title": "Named",
      "description": "Owner. From section 'Next action'."
    },
    "source": {
      "type": "string",
      "title": "Source",
      "description": "The source used under 'Evidence'.",
      "enum": [
        "URL",
        "transcript_id",
        "ticket",
        "dashboard"
      ]
    },
    "yyyy_www": {
      "type": "string",
      "title": "Yyyy www",
      "description": "Due cycle. From section 'Next action'."
    }
  },
  "required": [
    "action",
    "evidence_quote",
    "named",
    "source",
    "yyyy_www"
  ],
  "x-faion-dictionary-refs": 1
}
