{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/marketing/programmatic-seo-patterns/program-plan.vars.schema.json",
  "title": "program-plan template variables",
  "description": "Values for templates/program-plan.md.j2 and templates/program-plan.html.j2. Generated by tpl-jinja from program-plan.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "days": {
      "type": "string",
      "title": "Days",
      "description": "Refresh cadence. From section 'Data source'."
    },
    "email": {
      "type": "string",
      "title": "Email",
      "description": "The email used under 'Owner'."
    },
    "provider": {
      "type": "string",
      "title": "Provider",
      "description": "The provider used under 'Data source'.",
      "enum": [
        "internal_db",
        "API",
        "feed"
      ]
    }
  },
  "required": [
    "days",
    "email",
    "provider"
  ],
  "x-faion-dictionary-refs": 0
}
