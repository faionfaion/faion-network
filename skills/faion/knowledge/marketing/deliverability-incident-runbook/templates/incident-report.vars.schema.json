{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/marketing/deliverability-incident-runbook/incident-report.vars.schema.json",
  "title": "incident-report template variables",
  "description": "Values for templates/incident-report.md.j2 and templates/incident-report.html.j2. Generated by tpl-jinja from incident-report.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "title": "Action",
      "description": "The action used under 'Containment'.",
      "enum": [
        "throttle",
        "pause-segment",
        "suppress-list",
        "escalate"
      ]
    },
    "dashboard_url": {
      "type": "string",
      "title": "Dashboard url",
      "description": "ESP reputation. From section 'Diagnostics'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "Re-warm completed at. From section 'Follow-ups'."
    },
    "esp_query_url": {
      "type": "string",
      "title": "Esp query url",
      "description": "Complaint sample. From section 'Diagnostics'."
    },
    "score": {
      "type": "string",
      "title": "Score",
      "description": "ESP reputation. From section 'Diagnostics'."
    }
  },
  "required": [
    "action",
    "dashboard_url",
    "date",
    "esp_query_url",
    "score"
  ],
  "x-faion-dictionary-refs": 0
}
