{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/marketing/creative-brief-template/creative-brief.vars.schema.json",
  "title": "creative-brief template variables",
  "description": "Values for templates/creative-brief.md.j2 and templates/creative-brief.html.j2. Generated by tpl-jinja from creative-brief.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action_verb_noun": {
      "type": "string",
      "title": "Action verb noun",
      "description": "Primary. From section 'CTA'."
    },
    "campaign_name": {
      "type": "string",
      "title": "Campaign name",
      "description": "Creative Brief."
    },
    "claim_1": {
      "type": "string",
      "title": "Claim 1",
      "description": "The claim 1 used under 'Proof'."
    },
    "claim_2": {
      "type": "string",
      "title": "Claim 2",
      "description": "The claim 2 used under 'Proof'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "Owner sign-off. From section 'Notes'."
    },
    "handle": {
      "type": "string",
      "title": "Handle",
      "description": "Owner sign-off. From section 'Notes'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "The name used under 'Campaign'."
    },
    "opening_line": {
      "type": "string",
      "title": "Opening line",
      "description": "Text. From section 'Hook'."
    },
    "segment_description": {
      "type": "string",
      "title": "Segment description",
      "description": "Definition. From section 'Audience'."
    },
    "soft_cta": {
      "type": "string",
      "title": "Soft cta",
      "description": "Secondary. From section 'CTA'."
    }
  },
  "required": [
    "action_verb_noun",
    "campaign_name",
    "claim_1",
    "claim_2",
    "date",
    "handle",
    "name",
    "opening_line",
    "segment_description",
    "soft_cta"
  ],
  "x-faion-dictionary-refs": 0
}
