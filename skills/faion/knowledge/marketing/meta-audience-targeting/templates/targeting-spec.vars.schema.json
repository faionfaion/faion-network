{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/marketing/meta-audience-targeting/targeting-spec.vars.schema.json",
  "title": "targeting-spec template variables",
  "description": "Values for templates/targeting-spec.md.j2 and templates/targeting-spec.html.j2. Generated by tpl-jinja from targeting-spec.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "broad_niche": {
      "type": "string",
      "title": "Broad niche",
      "description": "Rationale. From section 'Advantage+ Audience'."
    },
    "enabled": {
      "type": "string",
      "title": "Enabled",
      "description": "The enabled used under 'Dynamic creative'.",
      "enum": [
        "yes",
        "no — only on broad",
        "Advantage+"
      ]
    },
    "yes_no": {
      "type": "boolean",
      "title": "Yes no",
      "description": "Enabled. From section 'Advantage+ Audience'."
    }
  },
  "required": [
    "broad_niche",
    "enabled",
    "yes_no"
  ],
  "x-faion-dictionary-refs": 0
}
