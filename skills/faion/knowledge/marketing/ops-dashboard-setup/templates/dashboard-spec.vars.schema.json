{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/marketing/ops-dashboard-setup/dashboard-spec.vars.schema.json",
  "title": "dashboard-spec template variables",
  "description": "Values for templates/dashboard-spec.md.j2 and templates/dashboard-spec.html.j2. Generated by tpl-jinja from dashboard-spec.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "chart_1": {
      "type": "string",
      "title": "Chart 1",
      "description": "The chart 1 used under 'Visualizations'."
    },
    "chart_2": {
      "type": "string",
      "title": "Chart 2",
      "description": "The chart 2 used under 'Visualizations'."
    },
    "location": {
      "type": "string",
      "title": "Location",
      "description": "The location used under 'Access'.",
      "enum": [
        "URL",
        "tool"
      ]
    },
    "metric": {
      "type": "string",
      "title": "Metric",
      "description": "Alert when. From section 'Alert Rules'."
    },
    "metric_1": {
      "type": "string",
      "title": "Metric 1",
      "description": "The metric 1 used under 'Metrics'."
    },
    "metric_2": {
      "type": "string",
      "title": "Metric 2",
      "description": "The metric 2 used under 'Metrics'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Dashboard Spec."
    },
    "permissions": {
      "type": "string",
      "title": "Permissions",
      "description": "The permissions used under 'Access'.",
      "enum": [
        "who can view",
        "edit"
      ]
    },
    "type": {
      "type": "string",
      "title": "Type",
      "description": "The type used under 'Visualizations'."
    }
  },
  "required": [
    "chart_1",
    "chart_2",
    "location",
    "metric",
    "metric_1",
    "metric_2",
    "name",
    "permissions",
    "type"
  ],
  "x-faion-dictionary-refs": 0
}
