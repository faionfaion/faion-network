{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/marketing/ads-ab-testing-ads/test-brief.vars.schema.json",
  "title": "test-brief template variables",
  "description": "Values for templates/test-brief.md.j2 and templates/test-brief.html.j2. Generated by tpl-jinja from test-brief.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "control_description": {
      "type": "string",
      "title": "Control description",
      "description": "We believe will outperform. From section 'Hypothesis'."
    },
    "ctr_conversions_cpa": {
      "type": "string",
      "title": "Ctr conversions cpa",
      "description": "Primary metric. From section 'Test Parameters'."
    },
    "current": {
      "type": "string",
      "title": "Current",
      "description": "Changed element. From section 'Variables'."
    },
    "expected_outcome": {
      "type": "string",
      "title": "Expected outcome",
      "description": "The expected outcome used under 'Baseline'.",
      "enum": [
        "Variant wins",
        "Unsure",
        "Directional only"
      ]
    },
    "new": {
      "type": "string",
      "title": "New",
      "description": "Changed element. From section 'Variables'."
    },
    "platform": {
      "type": "string",
      "title": "Platform",
      "description": "The platform used under 'Test Parameters'.",
      "enum": [
        "Meta Experiments",
        "Google Ads Experiments",
        "Manual"
      ]
    },
    "primary_metric": {
      "type": "string",
      "title": "Primary metric",
      "description": "Current. From section 'Baseline'."
    },
    "same": {
      "type": "string",
      "title": "Same",
      "description": "Held constant. From section 'Variables'."
    },
    "test_name": {
      "type": "string",
      "title": "Test name",
      "description": "A/B Test Brief."
    },
    "variant_description": {
      "type": "string",
      "title": "Variant description",
      "description": "We believe. From section 'Hypothesis'."
    },
    "x_x": {
      "type": "string",
      "title": "X x",
      "description": "Current. From section 'Baseline'."
    },
    "y": {
      "type": "string",
      "title": "Y",
      "description": "Minimum detectable effect. From section 'Baseline'."
    }
  },
  "required": [
    "control_description",
    "ctr_conversions_cpa",
    "current",
    "expected_outcome",
    "new",
    "platform",
    "primary_metric",
    "same",
    "test_name",
    "variant_description",
    "x_x",
    "y"
  ],
  "x-faion-dictionary-refs": 0
}
