<h2>By Campaign Type</h2>
<table><thead><tr><th>Type</th><th>Allocation</th><th>%</th></tr></thead><tbody><tr><td>Prospecting</td><td>$X</td><td>X%</td></tr><tr><td>Retargeting</td><td>$X</td><td>X%</td></tr><tr><td>Brand</td><td>$X</td><td>X%</td></tr></tbody></table>
<h2>Rationale</h2>
<ul><li>Increasing Meta because {{ reason }}</li><li>Decreasing LinkedIn because {{ reason }}</li></ul>
<h2>Targets</h2>
<ul><li>Target CPA: $X</li><li>Expected conversions: X</li><li>Target ROAS: X:1</li></ul>
</body></html>
