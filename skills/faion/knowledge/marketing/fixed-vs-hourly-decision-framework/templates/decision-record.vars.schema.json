{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/marketing/fixed-vs-hourly-decision-framework/decision-record.vars.schema.json",
  "title": "decision-record template variables",
  "description": "Values for templates/decision-record.md.j2 and templates/decision-record.html.j2. Generated by tpl-jinja from decision-record.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fixed": {
      "type": "string",
      "title": "Fixed",
      "description": "The fixed used under 'Options considered'.",
      "enum": [
        "kept",
        "rejected with reason"
      ]
    },
    "hourly": {
      "type": "string",
      "title": "Hourly",
      "description": "The hourly used under 'Options considered'.",
      "enum": [
        "kept",
        "rejected with reason"
      ]
    },
    "hybrid": {
      "type": "string",
      "title": "Hybrid",
      "description": "The hybrid used under 'Options considered'.",
      "enum": [
        "kept",
        "rejected with reason"
      ]
    },
    "numeric_threshold": {
      "type": "string",
      "title": "Numeric threshold",
      "description": "Hourly. From section 'Kill criteria (per option)'."
    }
  },
  "required": [
    "fixed",
    "hourly",
    "hybrid",
    "numeric_threshold"
  ],
  "x-faion-dictionary-refs": 0
}
