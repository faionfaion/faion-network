{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/marketing/founder-led-qualification-rubric/rubric-card.vars.schema.json",
  "title": "rubric-card template variables",
  "description": "Values for templates/rubric-card.md.j2 and templates/rubric-card.html.j2. Generated by tpl-jinja from rubric-card.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "icp_match_note": {
      "type": "string",
      "title": "Icp match note",
      "description": "Fit. From section 'Qualification'."
    },
    "named_contact": {
      "type": "string",
      "title": "Named contact",
      "description": "Authority. From section 'Qualification'."
    },
    "quote_number": {
      "type": "integer",
      "title": "Quote number",
      "description": "Budget. From section 'Qualification'."
    },
    "specific_pain": {
      "type": "string",
      "title": "Specific pain",
      "description": "Need. From section 'Qualification'."
    },
    "timeline": {
      "type": "string",
      "title": "Timeline",
      "description": "The timeline used under 'Qualification'.",
      "enum": [
        "date",
        "window"
      ]
    }
  },
  "required": [
    "icp_match_note",
    "named_contact",
    "quote_number",
    "specific_pain",
    "timeline"
  ],
  "x-faion-dictionary-refs": 0
}
