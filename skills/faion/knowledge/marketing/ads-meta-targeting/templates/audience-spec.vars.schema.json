{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/marketing/ads-meta-targeting/audience-spec.vars.schema.json",
  "title": "audience-spec template variables",
  "description": "Values for templates/audience-spec.md.j2 and templates/audience-spec.html.j2. Generated by tpl-jinja from audience-spec.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "allowed_disabled": {
      "type": "string",
      "title": "Allowed disabled",
      "description": "The allowed disabled used under 'Advantage+ Audience?'."
    },
    "campaign": {
      "type": "string",
      "title": "Campaign",
      "description": "Meta Audience Spec."
    },
    "list": {
      "type": "string",
      "title": "List",
      "description": "Interests. From section 'Core (cold)'."
    },
    "pct": {
      "type": "string",
      "title": "Pct",
      "description": "The pct used under 'Lookalike (scale)'.",
      "enum": [
        "1%",
        "2-3%",
        "5-10%"
      ]
    },
    "source": {
      "type": "string",
      "title": "Source",
      "description": "The source used under 'Lookalike (scale)'.",
      "enum": [
        "purchasers_180d",
        "signups_90d"
      ]
    }
  },
  "required": [
    "allowed_disabled",
    "campaign",
    "list",
    "pct",
    "source"
  ],
  "x-faion-dictionary-refs": 0
}
