{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/marketing/ads-twitter-ads/campaign-spec.vars.schema.json",
  "title": "campaign-spec template variables",
  "description": "Values for templates/campaign-spec.md.j2 and templates/campaign-spec.html.j2. Generated by tpl-jinja from campaign-spec.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "type": "string",
      "title": "Mode",
      "description": "The mode used under 'Audience'.",
      "enum": [
        "follower_lal",
        "keyword",
        "conversation",
        "interest"
      ]
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "X / Twitter Campaign."
    }
  },
  "required": [
    "mode",
    "name"
  ],
  "x-faion-dictionary-refs": 0
}
