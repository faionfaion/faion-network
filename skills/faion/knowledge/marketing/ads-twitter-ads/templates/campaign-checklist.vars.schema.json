{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/marketing/ads-twitter-ads/campaign-checklist.vars.schema.json",
  "title": "campaign-checklist template variables",
  "description": "Values for templates/campaign-checklist.md.j2 and templates/campaign-checklist.html.j2. Generated by tpl-jinja from campaign-checklist.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "countries_cities": {
      "type": "string",
      "title": "Countries cities",
      "description": "Location. From section 'Targeting'."
    },
    "event_name": {
      "type": "string",
      "title": "Event name",
      "description": "Conversion event configured. From section 'Objective'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Campaign. From section 'Twitter/X Campaign Launch Checklist'."
    },
    "schedule": {
      "type": "string",
      "title": "Schedule",
      "description": "The schedule used under 'Budget'."
    },
    "start_date": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/start_date"
        }
      ],
      "description": "Schedule. From section 'Budget'."
    },
    "tailored_audiences": {
      "type": "string",
      "title": "Tailored audiences",
      "description": "The tailored audiences used under 'Targeting'."
    }
  },
  "required": [
    "countries_cities",
    "event_name",
    "name",
    "schedule",
    "start_date",
    "tailored_audiences"
  ],
  "x-faion-dictionary-refs": 1
}
