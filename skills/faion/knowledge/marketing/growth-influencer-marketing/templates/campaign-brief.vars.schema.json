{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/marketing/growth-influencer-marketing/campaign-brief.vars.schema.json",
  "title": "campaign-brief template variables",
  "description": "Values for templates/campaign-brief.md.j2 and templates/campaign-brief.html.j2. Generated by tpl-jinja from campaign-brief.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "amount": {
      "type": "string",
      "title": "Amount",
      "description": "Fee. From section 'Compensation'."
    },
    "campaign_name": {
      "type": "string",
      "title": "Campaign name",
      "description": "Campaign Brief."
    },
    "count": {
      "type": "integer",
      "title": "Count",
      "description": "The count used under 'Deliverables'."
    },
    "email": {
      "type": "string",
      "title": "Email",
      "description": "Report metrics to. From section 'Tracking'."
    },
    "email_slack_channel": {
      "type": "string",
      "title": "Email slack channel",
      "description": "Creator submits draft content to. From section 'Approval Process'."
    },
    "end_date": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/end_date"
    },
    "guideline_2": {
      "type": "string",
      "title": "Guideline 2",
      "description": "The guideline 2 used under 'Creative Guidelines'."
    },
    "guideline_3": {
      "type": "string",
      "title": "Guideline 3",
      "description": "The guideline 3 used under 'Creative Guidelines'."
    },
    "payment_terms": {
      "type": "string",
      "title": "Payment terms",
      "description": "The payment terms used under 'Compensation'.",
      "enum": [
        "Net 7",
        "Net 14"
      ]
    },
    "platform": {
      "type": "string",
      "title": "Platform",
      "description": "The platform used under 'Deliverables'."
    },
    "product": {
      "type": "string",
      "title": "Product",
      "description": "Campaign objective: [One sentence. From section 'Campaign Brief'."
    },
    "product_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/product_name"
    },
    "restriction_2": {
      "type": "string",
      "title": "Restriction 2",
      "description": "The restriction 2 used under 'Creative Guidelines'."
    },
    "start_date": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/start_date"
    },
    "total": {
      "type": "string",
      "title": "Total",
      "description": "Budget. From section 'Campaign Brief'."
    },
    "yourbrand": {
      "type": "string",
      "title": "Yourbrand",
      "description": "Tags. From section 'Creative Guidelines'."
    }
  },
  "required": [
    "amount",
    "campaign_name",
    "count",
    "email",
    "email_slack_channel",
    "end_date",
    "guideline_2",
    "guideline_3",
    "payment_terms",
    "platform",
    "product",
    "product_name",
    "restriction_2",
    "start_date",
    "total",
    "yourbrand"
  ],
  "x-faion-dictionary-refs": 3
}
