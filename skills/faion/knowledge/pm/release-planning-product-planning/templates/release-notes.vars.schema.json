{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/release-planning-product-planning/release-notes.vars.schema.json",
  "title": "release-notes template variables",
  "description": "Values for templates/release-notes.md.j2 and templates/release-notes.html.j2. Generated by tpl-jinja from release-notes.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "brief_instructions": {
      "type": "string",
      "title": "Brief instructions",
      "description": "How to use."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "Released. From section 'Release Notes'."
    },
    "feature_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/feature_name"
        }
      ],
      "description": "The feature name used under 'New Features'."
    },
    "improvement_1": {
      "type": "string",
      "title": "Improvement 1",
      "description": "The improvement 1 used under 'Improvements'."
    },
    "improvement_2": {
      "type": "string",
      "title": "Improvement 2",
      "description": "The improvement 2 used under 'Improvements'."
    },
    "issue_1": {
      "type": "string",
      "title": "Issue 1",
      "description": "The issue 1 used under 'Known Issues'."
    },
    "issue_description": {
      "type": "string",
      "title": "Issue description",
      "description": "Fixed. From section 'Bug Fixes'."
    },
    "solution": {
      "type": "string",
      "title": "Solution",
      "description": "Workaround. From section 'Known Issues'."
    }
  },
  "required": [
    "brief_instructions",
    "date",
    "feature_name",
    "improvement_1",
    "improvement_2",
    "issue_1",
    "issue_description",
    "solution"
  ],
  "x-faion-dictionary-refs": 1
}
