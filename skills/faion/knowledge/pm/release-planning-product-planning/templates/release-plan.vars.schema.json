{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/release-planning-product-planning/release-plan.vars.schema.json",
  "title": "release-plan template variables",
  "description": "Values for templates/release-plan.md.j2 and templates/release-plan.html.j2. Generated by tpl-jinja from release-plan.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bug_1": {
      "type": "string",
      "title": "Bug 1",
      "description": "The bug 1 used under 'Bug Fixes'."
    },
    "config_change": {
      "type": "string",
      "title": "Config change",
      "description": "The config change used under 'Other Changes'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "Release Date. From section 'Metadata'."
    },
    "dependency_1_resolved": {
      "type": "string",
      "title": "Dependency 1 resolved",
      "description": "The dependency 1 resolved used under 'Dependencies'."
    },
    "dependency_2_resolved": {
      "type": "string",
      "title": "Dependency 2 resolved",
      "description": "The dependency 2 resolved used under 'Dependencies'."
    },
    "dependency_update": {
      "type": "string",
      "title": "Dependency update",
      "description": "The dependency update used under 'Other Changes'."
    },
    "feature": {
      "type": "string",
      "title": "Feature",
      "description": "The feature used under 'Excluded (Next Release)'."
    },
    "feature_1": {
      "type": "string",
      "title": "Feature 1",
      "description": "The feature 1 used under 'Features'."
    },
    "feature_2": {
      "type": "string",
      "title": "Feature 2",
      "description": "The feature 2 used under 'Features'."
    },
    "how": {
      "type": "string",
      "title": "How",
      "description": "The how used under 'Success Metrics'."
    },
    "metric": {
      "type": "string",
      "title": "Metric",
      "description": "The metric used under 'Success Metrics'."
    },
    "risk_1": {
      "type": "string",
      "title": "Risk 1",
      "description": "The risk 1 used under 'Risks'."
    },
    "specific_plan": {
      "type": "string",
      "title": "Specific plan",
      "description": "The specific plan used under 'Risks'."
    },
    "specific_reason": {
      "type": "string",
      "title": "Specific reason",
      "description": "Not ready. From section 'Excluded (Next Release)'."
    },
    "type": {
      "type": "string",
      "title": "Type",
      "description": "The type used under 'Metadata'.",
      "enum": [
        "Major",
        "Minor",
        "Patch",
        "Hotfix"
      ]
    },
    "y": {
      "type": "string",
      "title": "Y",
      "description": "The y used under 'Success Metrics'."
    }
  },
  "required": [
    "bug_1",
    "config_change",
    "date",
    "dependency_1_resolved",
    "dependency_2_resolved",
    "dependency_update",
    "feature",
    "feature_1",
    "feature_2",
    "how",
    "metric",
    "risk_1",
    "specific_plan",
    "specific_reason",
    "type",
    "y"
  ],
  "x-faion-dictionary-refs": 0
}
