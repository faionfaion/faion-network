{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/azure-devops-boards/user-story.vars.schema.json",
  "title": "user-story template variables",
  "description": "Values for templates/user-story.md.j2 and templates/user-story.html.j2. Generated by tpl-jinja from user-story.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "benefit": {
      "type": "string",
      "title": "Benefit",
      "description": "So that. From section 'User Story'."
    },
    "blocks": {
      "type": "string",
      "title": "Blocks",
      "description": "The blocks used under 'Dependencies'.",
      "enum": [
        "#WBS-ID",
        "Story ID"
      ]
    },
    "capability": {
      "type": "string",
      "title": "Capability",
      "description": "I want. From section 'User Story'."
    },
    "implementation_considerations_optional": {
      "type": "string",
      "title": "Implementation considerations optional",
      "description": "The implementation considerations optional used under 'Technical Notes'."
    },
    "persona": {
      "type": "string",
      "title": "Persona",
      "description": "As a. From section 'User Story'."
    },
    "title": {
      "type": "string",
      "title": "Title",
      "description": "User Story."
    }
  },
  "required": [
    "benefit",
    "blocks",
    "capability",
    "persona",
    "title"
  ],
  "x-faion-dictionary-refs": 0
}
