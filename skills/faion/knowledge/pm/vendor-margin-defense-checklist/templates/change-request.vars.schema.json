{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/vendor-margin-defense-checklist/change-request.vars.schema.json",
  "title": "change-request template variables",
  "description": "Values for templates/change-request.md.j2 and templates/change-request.html.j2. Generated by tpl-jinja from change-request.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "client_name_channel": {
      "type": "string",
      "title": "Client name channel",
      "description": "Requested by. From section 'Change Order'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Change Order'."
    },
    "deliverable": {
      "type": "string",
      "title": "Deliverable",
      "description": "The deliverable used under 'Scope delta'."
    },
    "estimated_hours": {
      "type": "integer",
      "title": "Estimated hours",
      "description": "The estimated hours used under 'Price delta'."
    },
    "new_deliverable_date": {
      "type": "string",
      "title": "New deliverable date",
      "description": "The new deliverable date used under 'Schedule delta'."
    },
    "original": {
      "type": "string",
      "title": "Original",
      "description": "The original used under 'Scope delta'."
    },
    "project_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/project_name"
        }
      ],
      "description": "Change Order."
    },
    "reference_sow": {
      "type": "string",
      "title": "Reference sow",
      "description": "The reference sow used under 'Change Order'.",
      "enum": [
        "SOW id",
        "signed date"
      ]
    },
    "updated": {
      "type": "string",
      "title": "Updated",
      "description": "The updated used under 'Scope delta'."
    },
    "vendor_name": {
      "type": "string",
      "title": "Vendor name",
      "description": "Drafted by. From section 'Change Order'."
    },
    "x_hr": {
      "type": "string",
      "title": "X hr",
      "description": "Rate. From section 'Price delta'."
    },
    "y": {
      "type": "string",
      "title": "Y",
      "description": "Subtotal. From section 'Price delta'."
    },
    "yyyymmdd_n": {
      "type": "string",
      "title": "Yyyymmdd n",
      "description": "CR id. From section 'Change Order'."
    }
  },
  "required": [
    "client_name_channel",
    "date",
    "deliverable",
    "estimated_hours",
    "new_deliverable_date",
    "original",
    "project_name",
    "reference_sow",
    "updated",
    "vendor_name",
    "x_hr",
    "y",
    "yyyymmdd_n"
  ],
  "x-faion-dictionary-refs": 1
}
