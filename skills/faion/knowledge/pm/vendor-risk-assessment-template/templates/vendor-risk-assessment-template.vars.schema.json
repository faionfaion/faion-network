{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/vendor-risk-assessment-template/vendor-risk-assessment-template.vars.schema.json",
  "title": "vendor-risk-assessment-template template variables",
  "description": "Values for templates/vendor-risk-assessment-template.md.j2 and templates/vendor-risk-assessment-template.html.j2. Generated by tpl-jinja from vendor-risk-assessment-template.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decision_1": {
      "type": "string",
      "title": "Decision 1",
      "description": "The decision 1 used under 'Decisions / Actions / Next review'."
    },
    "iso_date": {
      "type": "string",
      "title": "Iso date",
      "description": "Last reviewed. From section 'DPA reference'."
    },
    "link": {
      "type": "string",
      "title": "Link",
      "description": "URL. From section 'DPA reference'."
    },
    "owner_full_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_full_name"
        }
      ],
      "description": "Owner."
    },
    "vendor": {
      "type": "string",
      "title": "Vendor",
      "description": "Vendor Risk Assessment."
    },
    "vendor_dpa_url": {
      "type": "string",
      "title": "Vendor dpa url",
      "description": "Source."
    },
    "vendor_slug": {
      "type": "string",
      "title": "Vendor slug",
      "description": "Artefact id."
    },
    "vendor_subprocessor_url": {
      "type": "string",
      "title": "Vendor subprocessor url",
      "description": "Source."
    }
  },
  "required": [
    "decision_1",
    "iso_date",
    "link",
    "vendor",
    "vendor_dpa_url",
    "vendor_slug",
    "vendor_subprocessor_url"
  ],
  "x-faion-dictionary-refs": 1
}
