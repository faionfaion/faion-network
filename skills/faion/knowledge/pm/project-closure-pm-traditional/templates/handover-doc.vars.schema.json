{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/project-closure-pm-traditional/handover-doc.vars.schema.json",
  "title": "handover-doc template variables",
  "description": "Values for templates/handover-doc.md.j2 and templates/handover-doc.html.j2. Generated by tpl-jinja from handover-doc.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "title": "Date",
      "description": "Effective Date. From section 'Operations Handover'."
    },
    "date_status": {
      "type": "string",
      "title": "Date status",
      "description": "The date status used under 'Known Issues'."
    },
    "high_level_overview": {
      "type": "string",
      "title": "High level overview",
      "description": "Architecture. From section 'Technical Details'."
    },
    "issue": {
      "type": "string",
      "title": "Issue",
      "description": "The issue used under 'Known Issues'."
    },
    "metric": {
      "type": "string",
      "title": "Metric",
      "description": "The metric used under 'Monitoring'."
    },
    "ops_manager": {
      "type": "string",
      "title": "Ops manager",
      "description": "Accepted By. From section 'Operations Handover'."
    },
    "pm_name": {
      "type": "string",
      "title": "Pm name",
      "description": "Prepared By. From section 'Operations Handover'."
    },
    "production_url_location": {
      "type": "string",
      "title": "Production url location",
      "description": "Environment. From section 'Technical Details'."
    },
    "project_system_name": {
      "type": "string",
      "title": "Project system name",
      "description": "Operations Handover."
    },
    "threshold": {
      "type": "string",
      "title": "Threshold",
      "description": "The threshold used under 'Monitoring'."
    },
    "tool": {
      "type": "string",
      "title": "Tool",
      "description": "The tool used under 'Monitoring'."
    },
    "workaround": {
      "type": "string",
      "title": "Workaround",
      "description": "The workaround used under 'Known Issues'."
    }
  },
  "required": [
    "date",
    "date_status",
    "high_level_overview",
    "issue",
    "metric",
    "ops_manager",
    "pm_name",
    "production_url_location",
    "project_system_name",
    "threshold",
    "tool",
    "workaround"
  ],
  "x-faion-dictionary-refs": 0
}
