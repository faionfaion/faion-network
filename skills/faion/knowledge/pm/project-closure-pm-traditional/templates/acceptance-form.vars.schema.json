{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/project-closure-pm-traditional/acceptance-form.vars.schema.json",
  "title": "acceptance-form template variables",
  "description": "Values for templates/acceptance-form.md.j2 and templates/acceptance-form.html.j2. Generated by tpl-jinja from acceptance-form.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "criterion_1": {
      "type": "string",
      "title": "Criterion 1",
      "description": "The criterion 1 used under 'Acceptance Criteria'."
    },
    "criterion_2": {
      "type": "string",
      "title": "Criterion 2",
      "description": "The criterion 2 used under 'Acceptance Criteria'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Deliverable Acceptance Form'."
    },
    "item": {
      "type": "string",
      "title": "Item",
      "description": "The item used under 'Outstanding Items'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Project. From section 'Deliverable Acceptance Form'."
    },
    "plan": {
      "type": "string",
      "title": "Plan",
      "description": "H/M/L. From section 'Outstanding Items'."
    },
    "what_was_delivered": {
      "type": "string",
      "title": "What was delivered",
      "description": "The what was delivered used under 'Description'."
    }
  },
  "required": [
    "criterion_1",
    "criterion_2",
    "date",
    "item",
    "name",
    "plan",
    "what_was_delivered"
  ],
  "x-faion-dictionary-refs": 0
}
