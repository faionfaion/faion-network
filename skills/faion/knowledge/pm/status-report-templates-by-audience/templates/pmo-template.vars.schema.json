{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/status-report-templates-by-audience/pmo-template.vars.schema.json",
  "title": "pmo-template template variables",
  "description": "Values for templates/pmo-template.md.j2 and templates/pmo-template.html.j2. Generated by tpl-jinja from pmo-template.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "string",
      "title": "Project",
      "description": "PMO Weekly Status."
    },
    "ws1": {
      "type": "string",
      "title": "Ws1",
      "description": "The ws1 used under 'RAG'."
    },
    "ws3": {
      "type": "string",
      "title": "Ws3",
      "description": "The ws3 used under 'RAG'."
    }
  },
  "required": [
    "project",
    "ws1",
    "ws3"
  ],
  "x-faion-dictionary-refs": 0
}
