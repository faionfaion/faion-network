{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/pm-tool-selection/adr.vars.schema.json",
  "title": "adr template variables",
  "description": "Values for templates/adr.md.j2 and templates/adr.html.j2. Generated by tpl-jinja from adr.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "benefit_1": {
      "type": "string",
      "title": "Benefit 1",
      "description": "The benefit 1 used under 'Positive'."
    },
    "benefit_2": {
      "type": "string",
      "title": "Benefit 2",
      "description": "The benefit 2 used under 'Positive'."
    },
    "duration": {
      "type": "string",
      "title": "Duration",
      "description": "Phase 1. From section 'Migration Plan'."
    },
    "factor_1": {
      "type": "string",
      "title": "Factor 1",
      "description": "The factor 1 used under 'Key Factors'."
    },
    "factor_2": {
      "type": "string",
      "title": "Factor 2",
      "description": "The factor 2 used under 'Key Factors'."
    },
    "factor_3": {
      "type": "string",
      "title": "Factor 3",
      "description": "The factor 3 used under 'Key Factors'."
    },
    "team": {
      "type": "string",
      "title": "Team",
      "description": "Phase 1. From section 'Migration Plan'."
    },
    "tool_b": {
      "type": "string",
      "title": "Tool b",
      "description": "The tool b used under 'Evaluation Summary'."
    },
    "tool_c": {
      "type": "string",
      "title": "Tool c",
      "description": "The tool c used under 'Evaluation Summary'."
    },
    "tool_name": {
      "type": "string",
      "title": "Tool name",
      "description": "We will. From section 'Decision'."
    },
    "trade_off_1": {
      "type": "string",
      "title": "Trade off 1",
      "description": "The trade off 1 used under 'Negative'."
    },
    "trade_off_2": {
      "type": "string",
      "title": "Trade off 2",
      "description": "The trade off 2 used under 'Negative'."
    },
    "we_will": {
      "type": "string",
      "title": "We will",
      "description": "The we will used under 'Decision'.",
      "enum": [
        "adopt",
        "migrate to"
      ]
    }
  },
  "required": [
    "benefit_1",
    "benefit_2",
    "duration",
    "factor_1",
    "factor_2",
    "factor_3",
    "team",
    "tool_b",
    "tool_c",
    "tool_name",
    "trade_off_1",
    "trade_off_2",
    "we_will"
  ],
  "x-faion-dictionary-refs": 0
}
