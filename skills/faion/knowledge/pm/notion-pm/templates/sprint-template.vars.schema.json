{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/notion-pm/sprint-template.vars.schema.json",
  "title": "sprint-template template variables",
  "description": "Values for templates/sprint-template.md.j2 and templates/sprint-template.html.j2. Generated by tpl-jinja from sprint-template.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action_owner": {
      "type": "string",
      "title": "Action owner",
      "description": "The action owner used under 'Action items'."
    },
    "end_date": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/end_date"
        }
      ],
      "description": "Duration. From section 'Sprint'."
    },
    "number": {
      "type": "string",
      "title": "Number",
      "description": "Sprint."
    },
    "start_date": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/start_date"
        }
      ],
      "description": "Duration. From section 'Sprint'."
    }
  },
  "required": [
    "action_owner",
    "end_date",
    "number",
    "start_date"
  ],
  "x-faion-dictionary-refs": 2
}
