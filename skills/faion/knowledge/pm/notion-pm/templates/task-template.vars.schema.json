      "type": "string",
      "title": "Criterion 2",
      "description": "The criterion 2 used under 'Acceptance Criteria'."
    },
    "criterion_3": {
      "type": "string",
      "title": "Criterion 3",
      "description": "The criterion 3 used under 'Acceptance Criteria'."
    },
    "link_description": {
      "type": "string",
      "title": "Link description",
