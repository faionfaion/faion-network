    },
    "sub_task_1": {
      "type": "string",
      "title": "Sub task 1",
      "description": "The sub task 1 used under 'Sub-tasks'."
    },
    "sub_task_2": {
      "type": "string",
      "title": "Sub task 2",
      "description": "The sub task 2 used under 'Sub-tasks'."
