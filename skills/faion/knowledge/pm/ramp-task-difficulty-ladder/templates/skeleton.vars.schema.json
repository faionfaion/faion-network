    "team_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/team_name"
        }
      ],
      "description": "Ramp Task Difficulty Ladder."
    }
  },
  "required": [
    "decision_1",
    "iso_date",
    "next_review_date",
    "team_name"
