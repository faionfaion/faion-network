{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/scope-management-pm-traditional/scope-statement.vars.schema.json",
  "title": "scope-statement template variables",
  "description": "Values for templates/scope-statement.md.j2 and templates/scope-statement.html.j2. Generated by tpl-jinja from scope-statement.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bullet": {
      "type": "string",
      "title": "Bullet",
      "description": "The bullet used under 'In scope'."
    },
    "criterion": {
      "type": "string",
      "title": "Criterion",
      "description": "AC-001. From section 'Acceptance criteria (testable)'."
    },
    "project": {
      "type": "string",
      "title": "Project",
      "description": "Scope Statement."
    }
  },
  "required": [
    "bullet",
    "criterion",
    "project"
  ],
  "x-faion-dictionary-refs": 0
}
