{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/minimum-product-frameworks/framework-choice.vars.schema.json",
  "title": "framework-choice template variables",
  "description": "Values for templates/framework-choice.md.j2 and templates/framework-choice.html.j2. Generated by tpl-jinja from framework-choice.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "disqualifying_condition": {
      "type": "string",
      "title": "Disqualifying condition",
      "description": "Kill criterion. From section 'Exit Criteria'."
    },
    "framework": {
      "type": "string",
      "title": "Framework",
      "description": "Initial pick. From section 'History'."
    },
    "metric": {
      "type": "string",
      "title": "Metric",
      "description": "Quantitative. From section 'Exit Criteria'."
    },
    "others": {
      "type": "string",
      "title": "Others",
      "description": "The others used under 'Framework Scores'."
    },
    "threshold": {
      "type": "string",
      "title": "Threshold",
      "description": "Quantitative. From section 'Exit Criteria'."
    },
    "window": {
      "type": "string",
      "title": "Window",
      "description": "Quantitative. From section 'Exit Criteria'."
    }
  },
  "required": [
    "disqualifying_condition",
    "framework",
    "metric",
    "others",
    "threshold",
    "window"
  ],
  "x-faion-dictionary-refs": 0
}
