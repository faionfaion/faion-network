{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/project-closure/handover.vars.schema.json",
  "title": "handover template variables",
  "description": "Values for templates/handover.md.j2 and templates/handover.html.j2. Generated by tpl-jinja from handover.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Next Action'."
    },
    "imperative_sentence": {
      "type": "string",
      "title": "Imperative sentence",
      "description": "The imperative sentence used under 'Next Action'."
    },
    "iso_date": {
      "type": "string",
      "title": "Iso date",
      "description": "Date. From section 'Operations handover'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "The name used under 'Data'."
    },
    "next_action_owner": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/next_action_owner"
        }
      ],
      "description": "The owner used under 'Next Action'."
    },
    "owner_role": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_role"
        }
      ],
      "description": "Date. From section 'Operations handover'."
    },
    "t": {
      "type": "string",
      "title": "T",
      "description": "The t used under 'Data'."
    }
  },
  "required": [
    "date",
    "imperative_sentence",
    "iso_date",
    "name",
    "owner_role",
    "t"
  ],
  "x-faion-dictionary-refs": 2
}
