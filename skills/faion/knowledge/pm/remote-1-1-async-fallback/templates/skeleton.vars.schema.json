{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/remote-1-1-async-fallback/skeleton.vars.schema.json",
  "title": "skeleton template variables",
  "description": "Values for templates/skeleton.md.j2 and templates/skeleton.html.j2. Generated by tpl-jinja from skeleton.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owner_full_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_full_name"
        }
      ],
      "description": "Owner. From section 'Async 1'."
    },
    "pair_id": {
      "type": "string",
      "title": "Pair id",
      "description": "Async 1."
    },
    "pm_role": {
      "type": "string",
      "title": "Pm role",
      "description": "Owner. From section 'Async 1'."
    }
  },
  "required": [
    "owner_full_name",
    "pair_id",
    "pm_role"
  ],
  "x-faion-dictionary-refs": 1
}
