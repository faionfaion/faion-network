{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/earned-value-management-pm-traditional/evm-report.vars.schema.json",
  "title": "evm-report template variables",
  "description": "Values for templates/evm-report.md.j2 and templates/evm-report.html.j2. Generated by tpl-jinja from evm-report.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "explicit_rationale_required": {
      "type": "string",
      "title": "Explicit rationale required",
      "description": "Sponsor override note (if softening RED). From section 'Overall RAG'."
    },
    "green_yellow_red": {
      "type": "string",
      "title": "Green yellow red",
      "description": "Overall RAG. From section 'Forecasts'."
    },
    "period_end": {
      "type": "string",
      "title": "Period end",
      "description": "EVM Report."
    },
    "project_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/project_name"
    },
    "team_endorsed_scenario": {
      "type": "string",
      "title": "Team endorsed scenario",
      "description": "Team-endorsed scenario. From section 'Forecasts'.",
      "enum": [
        "CPI-only",
        "CPI x SPI",
        "Bottom-up"
      ]
    }
  },
  "required": [
    "explicit_rationale_required",
    "green_yellow_red",
    "period_end",
    "project_name",
    "team_endorsed_scenario"
  ],
  "x-faion-dictionary-refs": 1
}
