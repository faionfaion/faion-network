  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'RACI Matrix'."
    },
    "project_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/project_name"
    },
    "role": {
      "type": "string",
      "title": "Role",
      "description": "Owner (Accountable for this matrix). From section 'RACI Matrix'."
    },
    "role_1": {
      "type": "string",
      "title": "Role 1",
      "description": "The role 1 used under 'Role-to-Person Mapping'."
    },
    "role_2": {
      "type": "string",
      "title": "Role 2",
      "description": "The role 2 used under 'Role-to-Person Mapping'."
    },
    "role_3": {
      "type": "string",
      "title": "Role 3",
      "description": "The role 3 used under 'Role-to-Person Mapping'."
    },
    "role_4": {
      "type": "string",
      "title": "Role 4",
      "description": "Task / Deliverable. From section 'Matrix'."
    },
    "role_5": {
      "type": "string",
      "title": "Role 5",
      "description": "Task / Deliverable. From section 'Matrix'."
    },
    "role_person": {
      "type": "string",
      "title": "Role person",
