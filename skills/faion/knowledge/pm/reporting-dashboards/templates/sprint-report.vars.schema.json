{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/reporting-dashboards/sprint-report.vars.schema.json",
  "title": "sprint-report template variables",
  "description": "Values for templates/sprint-report.md.j2 and templates/sprint-report.html.j2. Generated by tpl-jinja from sprint-report.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "title": "Action",
      "description": "The action used under 'Action Items'."
    },
    "bugs_found": {
      "type": "integer",
      "title": "Bugs found",
      "description": "The bugs found used under 'Quality Metrics'."
    },
    "end": {
      "type": "string",
      "title": "End",
      "description": "Duration. From section 'Sprint Overview'."
    },
    "goal": {
      "type": "string",
      "title": "Goal",
      "description": "Sprint Goal. From section 'Sprint Overview'."
    },
    "item": {
      "type": "string",
      "title": "Item",
      "description": "Continue. From section 'Retrospective Highlights'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "The name used under 'Action Items'."
    },
    "scope_added": {
      "type": "integer",
      "title": "Scope added",
      "description": "The scope added used under 'Delivery Summary'."
    },
    "start": {
      "type": "string",
      "title": "Start",
      "description": "Duration. From section 'Sprint Overview'."
    },
    "team_size": {
      "type": "integer",
      "title": "Team size",
      "description": "The team size used under 'Sprint Overview'."
    }
  },
  "required": [
    "action",
    "bugs_found",
    "end",
    "goal",
    "item",
    "name",
    "scope_added",
    "start",
    "team_size"
  ],
  "x-faion-dictionary-refs": 0
}
