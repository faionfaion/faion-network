{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/mlp-planning/mlp-plan.vars.schema.json",
  "title": "mlp-plan template variables",
  "description": "Values for templates/mlp-plan.md.j2 and templates/mlp-plan.html.j2. Generated by tpl-jinja from mlp-plan.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action_name": {
      "type": "string",
      "title": "Action name",
      "description": "Core Action. From section 'First Impression (Onboarding)'."
    },
    "core_1": {
      "type": "string",
      "title": "Core 1",
      "description": "The core 1 used under 'Feature Audit'."
    },
    "core_2": {
      "type": "string",
      "title": "Core 2",
      "description": "The core 2 used under 'Feature Audit'."
    },
    "count": {
      "type": "integer",
      "title": "Count",
      "description": "Users. From section 'Current State (MVP)'."
    },
    "current": {
      "type": "string",
      "title": "Current",
      "description": "Version. From section 'Current State (MVP)'."
    },
    "product_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/product_name"
    },
    "score": {
      "type": "string",
      "title": "Score",
      "description": "NPS. From section 'Current State (MVP)'."
    },
    "specific_tasks": {
      "type": "string",
      "title": "Specific tasks",
      "description": "Tasks. From section 'First Impression (Onboarding)'."
    },
    "task_1": {
      "type": "string",
      "title": "Task 1",
      "description": "The task 1 used under 'Polish Backlog'."
    },
    "task_2": {
      "type": "string",
      "title": "Task 2",
      "description": "The task 2 used under 'Polish Backlog'."
    },
    "what_happens_now": {
      "type": "string",
      "title": "What happens now",
      "description": "Current. From section 'First Impression (Onboarding)'."
    }
  },
  "required": [
    "action_name",
    "core_1",
    "core_2",
    "count",
    "current",
    "product_name",
    "score",
    "specific_tasks",
    "task_1",
    "task_2",
    "what_happens_now"
  ],
  "x-faion-dictionary-refs": 1
}
