{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/stakeholder-engagement-advanced-pm-traditional/engagement-plan.vars.schema.json",
  "title": "engagement-plan template variables",
  "description": "Values for templates/engagement-plan.md.j2 and templates/engagement-plan.html.j2. Generated by tpl-jinja from engagement-plan.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "current_engagement": {
      "type": "string",
      "title": "Current engagement",
      "description": "The current engagement used under 'Engagement Plan'.",
      "enum": [
        "unaware",
        "resistant",
        "neutral",
        "supportive",
        "leading"
      ]
    },
    "indicator": {
      "type": "string",
      "title": "Indicator",
      "description": "The indicator used under 'Engagement Plan'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Stakeholder. From section 'Engagement Plan'."
    },
    "source": {
      "type": "string",
      "title": "Source",
      "description": "Baseline=, target=, evidence. From section 'Engagement Plan'."
    },
    "stakeholder": {
      "type": "string",
      "title": "Stakeholder",
      "description": "Engagement Plan."
    },
    "v": {
      "type": "string",
      "title": "V",
      "description": "Baseline. From section 'Engagement Plan'."
    },
    "weekly_biweekly_monthly": {
      "type": "string",
      "title": "Weekly biweekly monthly",
      "description": "Review cadence. From section 'Engagement Plan'."
    }
  },
  "required": [
    "current_engagement",
    "indicator",
    "name",
    "source",
    "stakeholder",
    "v",
    "weekly_biweekly_monthly"
  ],
  "x-faion-dictionary-refs": 0
}
