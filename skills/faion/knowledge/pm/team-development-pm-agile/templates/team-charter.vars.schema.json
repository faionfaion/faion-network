{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/team-development-pm-agile/team-charter.vars.schema.json",
  "title": "team-charter template variables",
  "description": "Values for templates/team-charter.md.j2 and templates/team-charter.html.j2. Generated by tpl-jinja from team-charter.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "area": {
      "type": "string",
      "title": "Area",
      "description": "The area used under 'Members'."
    },
    "domain": {
      "type": "string",
      "title": "Domain",
      "description": "Decisions. From section 'Working Agreements'."
    },
    "email_handle": {
      "type": "string",
      "title": "Email handle",
      "description": "The email handle used under 'Members'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "The name used under 'Members'."
    },
    "team_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/team_name"
    }
  },
  "required": [
    "area",
    "domain",
    "email_handle",
    "name",
    "team_name"
  ],
  "x-faion-dictionary-refs": 1
}
