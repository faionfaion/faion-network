{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/work-breakdown-structure/wbs-dict-entry.vars.schema.json",
  "title": "wbs-dict-entry template variables",
  "description": "Values for templates/wbs-dict-entry.md.j2 and templates/wbs-dict-entry.html.j2. Generated by tpl-jinja from wbs-dict-entry.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "predecessor_wbs_ids": {
      "type": "string",
      "title": "Predecessor wbs ids",
      "description": "Dependencies. From section 'WBS'."
    },
    "tangible_output_produced": {
      "type": "string",
      "title": "Tangible output produced",
      "description": "Deliverable. From section 'WBS'."
    },
    "work_package_name": {
      "type": "string",
      "title": "Work package name",
      "description": "WBS. From section 'WBS Dictionary Entry'."
    }
  },
  "required": [
    "predecessor_wbs_ids",
    "tangible_output_produced",
    "work_package_name"
  ],
  "x-faion-dictionary-refs": 0
}
