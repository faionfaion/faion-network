{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/project-integration/charter.vars.schema.json",
  "title": "charter template variables",
  "description": "Values for templates/charter.md.j2 and templates/charter.html.j2. Generated by tpl-jinja from charter.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "title": "Date",
      "description": "D1. From section 'Deliverables'."
    },
    "exclusion": {
      "type": "string",
      "title": "Exclusion",
      "description": "The exclusion used under 'Out of Scope'."
    },
    "fmt": {
      "type": "string",
      "title": "Fmt",
      "description": "D1. From section 'Deliverables'."
    },
    "item": {
      "type": "string",
      "title": "Item",
      "description": "The item used under 'In Scope'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "D1. From section 'Deliverables'."
    }
  },
  "required": [
    "date",
    "exclusion",
    "fmt",
    "item",
    "name"
  ],
  "x-faion-dictionary-refs": 0
}
