{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/stakeholder-sentiment-tracker/skeleton.vars.schema.json",
  "title": "skeleton template variables",
  "description": "Values for templates/skeleton.md.j2 and templates/skeleton.html.j2. Generated by tpl-jinja from skeleton.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "comma_separated_markers": {
      "type": "string",
      "title": "Comma separated markers",
      "description": "Markers hit. From section 'Stakeholder'."
    },
    "intervention": {
      "type": "string",
      "title": "Intervention",
      "description": "The intervention used under 'ALARM (only if fired)'.",
      "enum": [
        "call",
        "meeting",
        "written response"
      ]
    },
    "list": {
      "type": "string",
      "title": "List",
      "description": "Trend (last 6 weeks). From section 'Stakeholder'."
    },
    "owner_full_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_full_name"
    },
    "role": {
      "type": "string",
      "title": "Role",
      "description": "Stakeholder. From section 'Sentiment run'."
    }
  },
  "required": [
    "comma_separated_markers",
    "intervention",
    "list",
    "role"
  ],
  "x-faion-dictionary-refs": 1
}
