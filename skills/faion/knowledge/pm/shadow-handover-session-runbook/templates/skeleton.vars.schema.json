{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/shadow-handover-session-runbook/skeleton.vars.schema.json",
  "title": "skeleton template variables",
  "description": "Values for templates/skeleton.md.j2 and templates/skeleton.html.j2. Generated by tpl-jinja from skeleton.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "document_version": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/document_version"
        }
      ],
      "description": "Version. From section 'Shadow Handover Session'."
    },
    "handle": {
      "type": "string",
      "title": "Handle",
      "description": "Outgoing engineer. From section 'Shadow Handover Session'."
    },
    "outgoing_handle": {
      "type": "string",
      "title": "Outgoing handle",
      "description": "Outgoing signed by. From section 'Sign-off'."
    },
    "owner_full_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_full_name"
        }
      ],
      "description": "Owner. From section 'Shadow Handover Session'."
    },
    "pm_role": {
      "type": "string",
      "title": "Pm role",
      "description": "Owner. From section 'Shadow Handover Session'."
    },
    "receiver_handle": {
      "type": "string",
      "title": "Receiver handle",
      "description": "Receiver signed by. From section 'Sign-off'."
    },
    "session_id": {
      "type": "string",
      "title": "Session id",
      "description": "Shadow Handover Session."
    }
  },
  "required": [
    "document_version",
    "handle",
    "outgoing_handle",
    "owner_full_name",
    "pm_role",
    "receiver_handle",
    "session_id"
  ],
  "x-faion-dictionary-refs": 2
}
