{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/change-control-pm-traditional/change-request-form.vars.schema.json",
  "title": "change-request-form template variables",
  "description": "Values for templates/change-request-form.md.j2 and templates/change-request-form.html.j2. Generated by tpl-jinja from change-request-form.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "alternative": {
      "type": "string",
      "title": "Alternative",
      "description": "The alternative used under 'Options'."
    },
    "cr_id": {
      "type": "integer",
      "title": "Cr id",
      "description": "The cr id used under 'Change Request Form'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Change Request Form'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Requester. From section 'Change Request Form'."
    },
    "new_risks_introduced": {
      "type": "string",
      "title": "New risks introduced",
      "description": "Risk. From section 'Impact Analysis'."
    },
    "opportunity_cost": {
      "type": "string",
      "title": "Opportunity cost",
      "description": "Resources. From section 'Impact Analysis'."
    },
    "quality": {
      "type": "string",
      "title": "Quality",
      "description": "The quality used under 'Impact Analysis'.",
      "enum": [
        "None",
        "Low",
        "Medium",
        "High"
      ]
    },
    "recommended": {
      "type": "string",
      "title": "Recommended",
      "description": "The recommended used under 'Options'."
    },
    "regression_integration_scope": {
      "type": "string",
      "title": "Regression integration scope",
      "description": "Test impact. From section 'Impact Analysis'."
    },
    "role": {
      "type": "string",
      "title": "Role",
      "description": "Requester. From section 'Change Request Form'."
    },
    "wbs_ids_affected": {
      "type": "string",
      "title": "Wbs ids affected",
      "description": "Scope. From section 'Impact Analysis'."
    },
    "which_budget_lines": {
      "type": "string",
      "title": "Which budget lines",
      "description": "Cost. From section 'Impact Analysis'."
    },
    "which_milestones_move": {
      "type": "string",
      "title": "Which milestones move",
      "description": "Schedule. From section 'Impact Analysis'."
    },
    "yyyy": {
      "type": "string",
      "title": "Yyyy",
      "description": "CR ID. From section 'Change Request Form'."
    }
  },
  "required": [
    "alternative",
    "cr_id",
    "date",
    "name",
    "new_risks_introduced",
    "opportunity_cost",
    "quality",
    "recommended",
    "regression_integration_scope",
    "role",
    "wbs_ids_affected",
    "which_budget_lines",
    "which_milestones_move",
    "yyyy"
  ],
  "x-faion-dictionary-refs": 0
}
