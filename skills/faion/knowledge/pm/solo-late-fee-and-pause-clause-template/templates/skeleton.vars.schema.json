{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/solo-late-fee-and-pause-clause-template/skeleton.vars.schema.json",
  "title": "skeleton template variables",
  "description": "Values for templates/skeleton.md.j2 and templates/skeleton.html.j2. Generated by tpl-jinja from skeleton.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "document_version": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/document_version"
    },
    "effective_date": {
      "type": "string",
      "title": "Effective date",
      "description": "> Applies to invoices issued on or after. From section 'Clause text (paste into SOW)'."
    },
    "freelancer_role": {
      "type": "string",
      "title": "Freelancer role",
      "description": "Owner. From section 'Late-Fee & Pause Clause'."
    },
    "jurisdiction": {
      "type": "string",
      "title": "Jurisdiction",
      "description": "Late-Fee & Pause Clause."
    },
    "owner_full_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_full_name"
    }
  },
  "required": [
    "effective_date",
    "freelancer_role",
    "jurisdiction"
  ],
  "x-faion-dictionary-refs": 2
}
