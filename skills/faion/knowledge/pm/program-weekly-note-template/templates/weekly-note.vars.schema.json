{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/program-weekly-note-template/weekly-note.vars.schema.json",
  "title": "weekly-note template variables",
  "description": "Values for templates/weekly-note.md.j2 and templates/weekly-note.html.j2. Generated by tpl-jinja from weekly-note.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ask": {
      "type": "string",
      "title": "Ask",
      "description": "1. From section 'Asks for sponsors (numbered, decision-shaped)'."
    },
    "decision": {
      "type": "string",
      "title": "Decision",
      "description": "The decision used under 'Decisions taken'."
    },
    "discovery_delivery_warranty": {
      "type": "string",
      "title": "Discovery delivery warranty",
      "description": "Stage. From section 'Program — Week'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Program."
    },
    "new_score_reason": {
      "type": "string",
      "title": "New score reason",
      "description": "R-NNN. From section 'Risks moved this week (top 3)'."
    },
    "owner_rationale": {
      "type": "string",
      "title": "Owner rationale",
      "description": "The owner rationale used under 'Decisions taken'."
    },
    "pm_name": {
      "type": "string",
      "title": "Pm name",
      "description": "Author. From section 'Program — Week'."
    },
    "program_week": {
      "type": "integer",
      "title": "Program week",
      "description": "Program — Week."
    },
    "progress_evidence_link": {
      "type": "string",
      "title": "Progress evidence link",
      "description": "The progress evidence link used under 'Progress (per workstream)'."
    },
    "workstream": {
      "type": "string",
      "title": "Workstream",
      "description": "The workstream used under 'Progress (per workstream)'."
    }
  },
  "required": [
    "ask",
    "decision",
    "discovery_delivery_warranty",
    "name",
    "new_score_reason",
    "owner_rationale",
    "pm_name",
    "program_week",
    "progress_evidence_link",
    "workstream"
  ],
  "x-faion-dictionary-refs": 0
}
