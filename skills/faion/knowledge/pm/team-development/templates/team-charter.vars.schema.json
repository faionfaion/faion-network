{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/team-development/team-charter.vars.schema.json",
  "title": "team-charter template variables",
  "description": "Values for templates/team-charter.md.j2 and templates/team-charter.html.j2. Generated by tpl-jinja from team-charter.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "attendees_count": {
      "type": "integer",
      "title": "Attendees count",
      "description": "The attendees count used under 'Co-authoring evidence'."
    },
    "decisions": {
      "type": "string",
      "title": "Decisions",
      "description": "The decisions used under 'Working Agreements'.",
      "enum": [
        "consensus",
        "tech lead breaks ties",
        "RACI-driven"
      ]
    },
    "email_slack": {
      "type": "string",
      "title": "Email slack",
      "description": "The email slack used under 'Members'."
    },
    "end": {
      "type": "string",
      "title": "End",
      "description": "Availability. From section 'Working Agreements'."
    },
    "skills": {
      "type": "string",
      "title": "Skills",
      "description": "The skills used under 'Members'."
    },
    "start": {
      "type": "string",
      "title": "Start",
      "description": "Availability. From section 'Working Agreements'."
    },
    "team_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/team_name"
        }
      ],
      "description": "Team Charter."
    },
    "timezone": {
      "type": "string",
      "title": "Timezone",
      "description": "Availability. From section 'Working Agreements'."
    }
  },
  "required": [
    "attendees_count",
    "decisions",
    "email_slack",
    "end",
    "skills",
    "start",
    "team_name",
    "timezone"
  ],
  "x-faion-dictionary-refs": 1
}
