{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/team-development/skills-matrix.vars.schema.json",
  "title": "skills-matrix template variables",
  "description": "Values for templates/skills-matrix.md.j2 and templates/skills-matrix.html.j2. Generated by tpl-jinja from skills-matrix.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "pm": {
      "type": "string",
      "title": "Pm",
      "description": "High training/pairing/contracting/hiring pairing. From section 'Gap Summary'."
    },
    "role_1": {
      "type": "string",
      "title": "Role 1",
      "description": "Skill. From section 'Skills Matrix'."
    },
    "role_2": {
      "type": "string",
      "title": "Role 2",
      "description": "Skill. From section 'Skills Matrix'."
    },
    "role_3": {
      "type": "string",
      "title": "Role 3",
      "description": "Skill. From section 'Skills Matrix'."
    },
    "skill_b": {
      "type": "string",
      "title": "Skill b",
      "description": "The skill b used under 'Skills Matrix'."
    },
    "skill_c": {
      "type": "string",
      "title": "Skill c",
      "description": "The skill c used under 'Skills Matrix'."
    },
    "team_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/team_name"
        }
      ],
      "description": "Skills Matrix."
    },
    "training_pair_hire": {
      "type": "string",
      "title": "Training pair hire",
      "description": "? 3 2. From section 'Skills Matrix'."
    }
  },
  "required": [
    "pm",
    "role_1",
    "role_2",
    "role_3",
    "skill_b",
    "skill_c",
    "team_name",
    "training_pair_hire"
  ],
  "x-faion-dictionary-refs": 1
}
