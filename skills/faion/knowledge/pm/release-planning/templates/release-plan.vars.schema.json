{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/release-planning/release-plan.vars.schema.json",
  "title": "release-plan template variables",
  "description": "Values for templates/release-plan.md.j2 and templates/release-plan.html.j2. Generated by tpl-jinja from release-plan.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bug_1": {
      "type": "string",
      "title": "Bug 1",
      "description": "The bug 1 used under 'Bug Fixes'."
    },
    "config_change": {
      "type": "string",
      "title": "Config change",
      "description": "The config change used under 'Other Changes'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "Release Date. From section 'Metadata'."
    },
    "dep_1": {
      "type": "string",
      "title": "Dep 1",
      "description": "The dep 1 used under 'Cross-Team Dependencies'."
    },
    "dependency_update": {
      "type": "string",
      "title": "Dependency update",
      "description": "The dependency update used under 'Other Changes'."
    },
    "feature": {
      "type": "string",
      "title": "Feature",
      "description": "The feature used under 'Excluded (Next Release)'."
    },
    "feature_1": {
      "type": "string",
      "title": "Feature 1",
      "description": "The feature 1 used under 'Features'."
    },
    "how": {
      "type": "string",
      "title": "How",
      "description": "The how used under 'Success Metrics'."
    },
    "major_minor_patch": {
      "type": "string",
      "title": "Major minor patch",
      "description": "Type. From section 'Metadata'."
    },
    "metric": {
      "type": "string",
      "title": "Metric",
      "description": "The metric used under 'Success Metrics'."
    },
    "plan": {
      "type": "string",
      "title": "Plan",
      "description": "The plan used under 'Risks'."
    },
    "risk_1": {
      "type": "string",
      "title": "Risk 1",
      "description": "The risk 1 used under 'Risks'."
    },
    "status": {
      "type": "string",
      "title": "Status",
      "description": "The status used under 'Cross-Team Dependencies'."
    },
    "y": {
      "type": "string",
      "title": "Y",
      "description": "The y used under 'Success Metrics'."
    }
  },
  "required": [
    "bug_1",
    "config_change",
    "date",
    "dep_1",
    "dependency_update",
    "feature",
    "feature_1",
    "how",
    "major_minor_patch",
    "metric",
    "plan",
    "risk_1",
    "status",
    "y"
  ],
  "x-faion-dictionary-refs": 0
}
