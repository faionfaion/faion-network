{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/cost-estimation-pm-traditional/cost-worksheet.vars.schema.json",
  "title": "cost-worksheet template variables",
  "description": "Values for templates/cost-worksheet.md.j2 and templates/cost-worksheet.html.j2. Generated by tpl-jinja from cost-worksheet.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_survey": {
      "type": "string",
      "title": "Contract survey",
      "description": "Labor. From section 'Direct Costs'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Cost Estimate'."
    },
    "explicit_assumption_1": {
      "type": "string",
      "title": "Explicit assumption 1",
      "description": "The explicit assumption 1 used under 'Assumptions'."
    },
    "explicit_assumption_2": {
      "type": "string",
      "title": "Explicit assumption 2",
      "description": "The explicit assumption 2 used under 'Assumptions'."
    },
    "hours": {
      "type": "string",
      "title": "Hours",
      "description": "Labor. From section 'Direct Costs'."
    },
    "id": {
      "type": "string",
      "title": "Id",
      "description": "WBS version. From section 'Cost Estimate'."
    },
    "infracost_pricing_api": {
      "type": "string",
      "title": "Infracost pricing api",
      "description": "Cloud/Infra. From section 'Direct Costs'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Estimator. From section 'Cost Estimate'."
    },
    "project_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/project_name"
        }
      ],
      "description": "Cost Estimate."
    },
    "role": {
      "type": "string",
      "title": "Role",
      "description": "Labor. From section 'Direct Costs'."
    },
    "service": {
      "type": "string",
      "title": "Service",
      "description": "Cloud/Infra. From section 'Direct Costs'."
    },
    "tool": {
      "type": "string",
      "title": "Tool",
      "description": "Software. From section 'Direct Costs'."
    },
    "vendor_quote": {
      "type": "string",
      "title": "Vendor quote",
      "description": "Software. From section 'Direct Costs'."
    },
    "x_h": {
      "type": "string",
      "title": "X h",
      "description": "Labor. From section 'Direct Costs'."
    }
  },
  "required": [
    "contract_survey",
    "date",
    "explicit_assumption_1",
    "explicit_assumption_2",
    "hours",
    "id",
    "infracost_pricing_api",
    "name",
    "project_name",
    "role",
    "service",
    "tool",
    "vendor_quote",
    "x_h"
  ],
  "x-faion-dictionary-refs": 1
}
