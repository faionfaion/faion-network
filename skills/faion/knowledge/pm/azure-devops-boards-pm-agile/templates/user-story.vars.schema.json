{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/azure-devops-boards-pm-agile/user-story.vars.schema.json",
  "title": "user-story template variables",
  "description": "Values for templates/user-story.md.j2 and templates/user-story.html.j2. Generated by tpl-jinja from user-story.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "i_want": {
      "type": "string",
      "title": "I want",
      "description": "The i want used under 'User Story'.",
      "enum": [
        "capability",
        "action"
      ]
    },
    "persona_role": {
      "type": "string",
      "title": "Persona role",
      "description": "As a. From section 'User Story'."
    },
    "title": {
      "type": "string",
      "title": "Title",
      "description": "User Story."
    },
    "work_item_id": {
      "type": "string",
      "title": "Work item id",
      "description": "Blocks. From section 'Dependencies'."
    }
  },
  "required": [
    "i_want",
    "persona_role",
    "title",
    "work_item_id"
  ],
  "x-faion-dictionary-refs": 0
}
