{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/pm/saas-stack-audit-micro-agency/skeleton.vars.schema.json",
  "title": "skeleton template variables",
  "description": "Values for templates/skeleton.md.j2 and templates/skeleton.html.j2. Generated by tpl-jinja from skeleton.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "document_version": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/document_version"
        }
      ],
      "description": "Version. From section 'SaaS Audit'."
    },
    "founder_handle": {
      "type": "string",
      "title": "Founder handle",
      "description": "Signed by. From section 'Kill list'."
    },
    "founder_role": {
      "type": "string",
      "title": "Founder role",
      "description": "Owner. From section 'SaaS Audit'."
    },
    "owner_full_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_full_name"
        }
      ],
      "description": "Owner. From section 'SaaS Audit'."
    },
    "quarter": {
      "type": "string",
      "title": "Quarter",
      "description": "SaaS Audit."
    }
  },
  "required": [
    "founder_handle",
    "founder_role",
    "quarter"
  ],
  "x-faion-dictionary-refs": 2
}
