{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/focus-groups/note-taking.vars.schema.json",
  "title": "note-taking template variables",
  "description": "Values for templates/note-taking.md.j2 and templates/note-taking.html.j2. Generated by tpl-jinja from note-taking.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "count": {
      "type": "integer",
      "title": "Count",
      "description": "Participants. From section 'Group Notes — —'."
    },
    "group": {
      "type": "string",
      "title": "Group",
      "description": "Group Notes —."
    },
    "iso_date": {
      "type": "string",
      "title": "Iso date",
      "description": "Group Notes — —."
    },
    "segment": {
      "type": "string",
      "title": "Segment",
      "description": "Group Notes."
    },
    "session_facilitator": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/session_facilitator"
        }
      ],
      "description": "Moderator. From section 'Group Notes — —'."
    },
    "theme": {
      "type": "string",
      "title": "Theme",
      "description": "The theme used under 'Themes candidate from this group'."
    }
  },
  "required": [
    "count",
    "group",
    "iso_date",
    "segment",
    "session_facilitator",
    "theme"
  ],
  "x-faion-dictionary-refs": 1
}
