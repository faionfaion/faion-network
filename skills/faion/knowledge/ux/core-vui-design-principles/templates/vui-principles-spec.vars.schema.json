{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/core-vui-design-principles/vui-principles-spec.vars.schema.json",
  "title": "vui-principles-spec template variables",
  "description": "Values for templates/vui-principles-spec.md.j2 and templates/vui-principles-spec.html.j2. Generated by tpl-jinja from vui-principles-spec.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled_handling": {
      "type": "string",
      "title": "Enabled handling",
      "description": "Barge-in. From section 'Natural Conversation'."
    },
    "handling": {
      "type": "string",
      "title": "Handling",
      "description": "15-second ceiling. From section 'Simplicity'."
    },
    "max_duration_seconds": {
      "type": "integer",
      "title": "Max duration seconds",
      "description": "The max duration seconds used under 'Context Awareness'."
    },
    "pattern": {
      "type": "string",
      "title": "Pattern",
      "description": "Follow-up awareness. From section 'Natural Conversation'."
    },
    "product": {
      "type": "string",
      "title": "Product",
      "description": "VUI Principles."
    },
    "rules": {
      "type": "string",
      "title": "Rules",
      "description": "Single-idea-per-response. From section 'Simplicity'."
    },
    "runtime": {
      "type": "string",
      "title": "Runtime",
      "description": "The runtime used under 'VUI Principles'.",
      "enum": [
        "Alexa",
        "Google",
        "Siri",
        "LLM-native"
      ]
    },
    "turn_taking": {
      "type": "string",
      "title": "Turn taking",
      "description": "Turn-taking. From section 'Natural Conversation'.",
      "enum": [
        "VAD",
        "push-to-talk"
      ]
    },
    "turns_remembered": {
      "type": "integer",
      "title": "Turns remembered",
      "description": "The turns remembered used under 'Context Awareness'."
    }
  },
  "required": [
    "enabled_handling",
    "handling",
    "max_duration_seconds",
    "pattern",
    "product",
    "rules",
    "runtime",
    "turn_taking",
    "turns_remembered"
  ],
  "x-faion-dictionary-refs": 0
}
