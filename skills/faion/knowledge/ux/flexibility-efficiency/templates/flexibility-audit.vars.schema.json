{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/flexibility-efficiency/flexibility-audit.vars.schema.json",
  "title": "flexibility-audit template variables",
  "description": "Values for templates/flexibility-audit.md.j2 and templates/flexibility-audit.html.j2. Generated by tpl-jinja from flexibility-audit.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "count": {
      "type": "integer",
      "title": "Count",
      "description": "The count used under 'Multiple Paths'."
    },
    "element": {
      "type": "string",
      "title": "Element",
      "description": "The element used under 'Customization Options'."
    },
    "feature_product": {
      "type": "string",
      "title": "Feature product",
      "description": "Flexibility Audit."
    },
    "fix": {
      "type": "string",
      "title": "Fix",
      "description": "Novice / Expert / Both. From section 'Priority Gaps'."
    },
    "guided_click_path": {
      "type": "string",
      "title": "Guided click path",
      "description": "The guided click path used under 'Multiple Paths'."
    },
    "issue": {
      "type": "string",
      "title": "Issue",
      "description": "The issue used under 'Priority Gaps'."
    },
    "reviewer_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/reviewer_name"
        }
      ],
      "description": "Reviewer. From section 'Flexibility Audit'."
    },
    "task": {
      "type": "string",
      "title": "Task",
      "description": "The task used under 'Multiple Paths'."
    }
  },
  "required": [
    "count",
    "element",
    "feature_product",
    "fix",
    "guided_click_path",
    "issue",
    "task"
  ],
  "x-faion-dictionary-refs": 1
}
