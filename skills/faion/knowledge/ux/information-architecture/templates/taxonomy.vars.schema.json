{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/information-architecture/taxonomy.vars.schema.json",
  "title": "taxonomy template variables",
  "description": "Values for templates/taxonomy.md.j2 and templates/taxonomy.html.j2. Generated by tpl-jinja from taxonomy.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "category_1": {
      "type": "string",
      "title": "Category 1",
      "description": "The category 1 used under 'Primary Categories'."
    },
    "content_type": {
      "type": "string",
      "title": "Content type",
      "description": "The content type used under 'Tags'."
    },
    "field_list": {
      "type": "string",
      "title": "Field list",
      "description": "The field list used under 'Content Types'."
    },
    "group": {
      "type": "string",
      "title": "Group",
      "description": "The group used under 'Tags'."
    },
    "site_name": {
      "type": "string",
      "title": "Site name",
      "description": "Taxonomy."
    },
    "specific_scope_name": {
      "type": "string",
      "title": "Specific scope name",
      "description": "Miscellaneous. From section 'Naming Conventions'."
    },
    "subcategory_1a": {
      "type": "string",
      "title": "Subcategory 1a",
      "description": "The subcategory 1a used under 'Primary Categories'."
    },
    "type": {
      "type": "string",
      "title": "Type",
      "description": "The type used under 'Content Types'."
    }
  },
  "required": [
    "category_1",
    "content_type",
    "field_list",
    "group",
    "site_name",
    "specific_scope_name",
    "subcategory_1a",
    "type"
  ],
  "x-faion-dictionary-refs": 0
}
