{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/information-architecture/sitemap.vars.schema.json",
  "title": "sitemap template variables",
  "description": "Values for templates/sitemap.md.j2 and templates/sitemap.html.j2. Generated by tpl-jinja from sitemap.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Sitemap'."
    },
    "page": {
      "type": "string",
      "title": "Page",
      "description": "The page used under 'Page Inventory'."
    },
    "path": {
      "type": "string",
      "title": "Path",
      "description": "The path used under 'Page Inventory'."
    },
    "site_name": {
      "type": "string",
      "title": "Site name",
      "description": "Sitemap."
    },
    "template": {
      "type": "string",
      "title": "Template",
      "description": "/ High/Med/Low. From section 'Page Inventory'."
    },
    "version": {
      "type": "integer",
      "title": "Version",
      "description": "The version used under 'Sitemap'."
    }
  },
  "required": [
    "date",
    "page",
    "path",
    "site_name",
    "template",
    "version"
  ],
  "x-faion-dictionary-refs": 0
}
