{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/focus-groups-ux-research/session-notes.vars.schema.json",
  "title": "session-notes template variables",
  "description": "Values for templates/session-notes.md.j2 and templates/session-notes.html.j2. Generated by tpl-jinja from session-notes.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "group_dynamics": {
      "type": "string",
      "title": "Group dynamics",
      "description": "The group dynamics used under 'Topic 1'.",
      "enum": [
        "Agreement",
        "Debate",
        "Passive",
        "Energized"
      ]
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Note-taker. From section 'Focus Group Notes'."
    },
    "path": {
      "type": "string",
      "title": "Path",
      "description": "Session recording path. From section 'Moderator Notes'."
    },
    "same_structure": {
      "type": "string",
      "title": "Same structure",
      "description": "The same structure used under 'Topic 2'."
    },
    "segment_name": {
      "type": "string",
      "title": "Segment name",
      "description": "Session. From section 'Focus Group Notes'."
    },
    "session": {
      "type": "integer",
      "title": "Session",
      "description": "The session used under 'Focus Group Notes'."
    },
    "session_facilitator": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/session_facilitator"
        }
      ],
      "description": "Moderator. From section 'Focus Group Notes'."
    },
    "who_said_what": {
      "type": "string",
      "title": "Who said what",
      "description": "Positive themes. From section 'Concept Reactions (if applicable)'."
    }
  },
  "required": [
    "group_dynamics",
    "name",
    "path",
    "same_structure",
    "segment_name",
    "session",
    "who_said_what"
  ],
  "x-faion-dictionary-refs": 1
}
