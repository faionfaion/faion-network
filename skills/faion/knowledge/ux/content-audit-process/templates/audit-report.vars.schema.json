{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/content-audit-process/audit-report.vars.schema.json",
  "title": "audit-report template variables",
  "description": "Values for templates/audit-report.md.j2 and templates/audit-report.html.j2. Generated by tpl-jinja from audit-report.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "area": {
      "type": "string",
      "title": "Area",
      "description": "1. From section 'Problem Areas'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Content Audit Report'."
    },
    "issue": {
      "type": "string",
      "title": "Issue",
      "description": "The issue used under 'Problem Areas'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Auditor. From section 'Content Audit Report'."
    },
    "number": {
      "type": "string",
      "title": "Number",
      "description": "Total content pieces. From section 'Executive Summary'."
    },
    "strength": {
      "type": "string",
      "title": "Strength",
      "description": "1. From section 'Strengths'."
    },
    "total": {
      "type": "integer",
      "title": "Total",
      "description": "The total used under 'By Type'."
    },
    "type_1": {
      "type": "string",
      "title": "Type 1",
      "description": "The type 1 used under 'By Type'."
    },
    "type_2": {
      "type": "string",
      "title": "Type 2",
      "description": "The type 2 used under 'By Type'."
    },
    "what_was_audited": {
      "type": "string",
      "title": "What was audited",
      "description": "Scope. From section 'Content Audit Report'."
    }
  },
  "required": [
    "area",
    "date",
    "issue",
    "name",
    "number",
    "strength",
    "total",
    "type_1",
    "type_2",
    "what_was_audited"
  ],
  "x-faion-dictionary-refs": 0
}
