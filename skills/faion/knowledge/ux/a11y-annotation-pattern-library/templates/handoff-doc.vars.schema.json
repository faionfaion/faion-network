{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/a11y-annotation-pattern-library/handoff-doc.vars.schema.json",
  "title": "handoff-doc template variables",
  "description": "Values for templates/handoff-doc.md.j2 and templates/handoff-doc.html.j2. Generated by tpl-jinja from handoff-doc.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "aria_role": {
      "type": "string",
      "title": "Aria role",
      "description": "Role."
    },
    "comma_separated": {
      "type": "string",
      "title": "Comma separated",
      "description": "States."
    },
    "component_name": {
      "type": "string",
      "title": "Component name",
      "description": "The component name used under 'Handoff'."
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "Focus behaviour."
    },
    "key_action_map": {
      "type": "string",
      "title": "Key action map",
      "description": "Keyboard."
    },
    "screen_name": {
      "type": "string",
      "title": "Screen name",
      "description": "Handoff."
    },
    "user_facing_label": {
      "type": "string",
      "title": "User facing label",
      "description": "Name."
    }
  },
  "required": [
    "aria_role",
    "comma_separated",
    "component_name",
    "description",
    "key_action_map",
    "screen_name",
    "user_facing_label"
  ],
  "x-faion-dictionary-refs": 0
}
