      "title": "Expected duration",
      "description": "Duration. From section 'Contextual Inquiry Guide'."
    },
    "id": {
      "type": "string",
      "title": "Id",
      "description": "Participant. From section 'Contextual Inquiry Guide'."
    },
    "name": {
      "type": "string",
