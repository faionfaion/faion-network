{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/contextual-inquiry-ux-research/session-notes.vars.schema.json",
  "title": "session-notes template variables",
  "description": "Values for templates/session-notes.md.j2 and templates/session-notes.html.j2. Generated by tpl-jinja from session-notes.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "actual_duration": {
      "type": "string",
      "title": "Actual duration",
      "description": "Duration. From section 'Contextual Inquiry Notes'."
    },
    "id": {
      "type": "string",
      "title": "Id",
      "description": "Participant. From section 'Contextual Inquiry Notes'."
    },
    "insight_1": {
      "type": "string",
      "title": "Insight 1",
      "description": "1. From section 'Key Insights'."
    },
    "insight_2": {
      "type": "string",
      "title": "Insight 2",
      "description": "2. From section 'Key Insights'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Researcher. From section 'Contextual Inquiry Notes'."
    },
    "quote_id": {
      "type": "string",
      "title": "Quote id",
      "description": "Quote. From section 'Task 1'."
    },
    "step_2": {
      "type": "string",
      "title": "Step 2",
      "description": "2. From section 'Task 1'."
    },
    "step_3": {
      "type": "string",
      "title": "Step 3",
      "description": "3. From section 'Task 1'."
    },
    "task_name": {
      "type": "string",
      "title": "Task name",
      "description": "Task 1. From section 'Workflow Observations'."
    },
    "verbatim_participant_words": {
      "type": "string",
      "title": "Verbatim participant words",
      "description": "Quote. From section 'Task 1'."
    },
    "where": {
      "type": "string",
      "title": "Where",
      "description": "Location. From section 'Contextual Inquiry Notes'."
    },
    "workaround": {
      "type": "string",
      "title": "Workaround",
      "description": "The workaround used under 'Workarounds Observed'."
    }
  },
  "required": [
    "actual_duration",
    "id",
    "insight_1",
    "insight_2",
    "name",
    "quote_id",
    "step_2",
    "step_3",
    "task_name",
    "verbatim_participant_words",
    "where",
    "workaround"
  ],
  "x-faion-dictionary-refs": 0
}
