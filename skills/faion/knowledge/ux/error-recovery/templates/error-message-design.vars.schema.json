{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/error-recovery/error-message-design.vars.schema.json",
  "title": "error-message-design template variables",
  "description": "Values for templates/error-message-design.md.j2 and templates/error-message-design.html.j2. Generated by tpl-jinja from error-message-design.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "error_type": {
      "type": "string",
      "title": "Error type",
      "description": "Error Message Design."
    },
    "timing": {
      "type": "string",
      "title": "Timing",
      "description": "The timing used under 'Visual Design'.",
      "enum": [
        "When to show — on blur",
        "on submit",
        "immediately on type"
      ]
    }
  },
  "required": [
    "error_type",
    "timing"
  ],
  "x-faion-dictionary-refs": 0
}
