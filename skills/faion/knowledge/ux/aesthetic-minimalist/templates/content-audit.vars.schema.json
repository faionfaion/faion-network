{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/aesthetic-minimalist/content-audit.vars.schema.json",
  "title": "content-audit template variables",
  "description": "Values for templates/content-audit.md.j2 and templates/content-audit.html.j2. Generated by tpl-jinja from content-audit.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "advanced_settings": {
      "type": "string",
      "title": "Advanced settings",
      "description": "The advanced settings used under 'Progressive Disclosure Candidates'."
    },
    "count": {
      "type": "integer",
      "title": "Count",
      "description": "The count used under 'Information Density'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Content Audit'."
    },
    "decorative_banner": {
      "type": "string",
      "title": "Decorative banner",
      "description": "Remove. From section 'Recommendations'."
    },
    "element": {
      "type": "string",
      "title": "Element",
      "description": "The element used under 'Element Analysis'."
    },
    "hero_image": {
      "type": "string",
      "title": "Hero image",
      "description": "The hero image used under 'Visual Elements'."
    },
    "icon_set": {
      "type": "string",
      "title": "Icon set",
      "description": "The icon set used under 'Visual Elements'."
    },
    "page_feature": {
      "type": "string",
      "title": "Page feature",
      "description": "Content Audit."
    },
    "primary_cta": {
      "type": "string",
      "title": "Primary cta",
      "description": "The primary cta used under 'Visual Hierarchy Assessment'."
    },
    "rarely_used_filters": {
      "type": "string",
      "title": "Rarely used filters",
      "description": "Hide. From section 'Recommendations'."
    },
    "reviewer_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/reviewer_name"
        }
      ],
      "description": "Reviewer. From section 'Content Audit'."
    },
    "secondary_link": {
      "type": "string",
      "title": "Secondary link",
      "description": "The secondary link used under 'Visual Hierarchy Assessment'."
    },
    "secondary_nav": {
      "type": "string",
      "title": "Secondary nav",
      "description": "Shrink. From section 'Recommendations'."
    },
    "section_name": {
      "type": "string",
      "title": "Section name",
      "description": "The section name used under 'Information Density'."
    },
    "y_n": {
      "type": "string",
      "title": "Y n",
      "description": "Y / N. From section 'Information Density'.",
      "enum": [
        "Why too dense",
        "appropriate"
      ]
    }
  },
  "required": [
    "advanced_settings",
    "count",
    "date",
    "decorative_banner",
    "element",
    "hero_image",
    "icon_set",
    "page_feature",
    "primary_cta",
    "rarely_used_filters",
    "secondary_link",
    "secondary_nav",
    "section_name",
    "y_n"
  ],
  "x-faion-dictionary-refs": 1
}
