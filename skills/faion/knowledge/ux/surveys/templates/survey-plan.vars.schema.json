{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/surveys/survey-plan.vars.schema.json",
  "title": "survey-plan template variables",
  "description": "Values for templates/survey-plan.md.j2 and templates/survey-plan.html.j2. Generated by tpl-jinja from survey-plan.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "title": "Date",
      "description": "Deadline. From section 'Success Metrics'."
    },
    "distribution": {
      "type": "string",
      "title": "Distribution",
      "description": "The distribution used under 'Survey Plan'.",
      "enum": [
        "Email",
        "In-app",
        "Intercept",
        "Panel"
      ]
    },
    "instrument": {
      "type": "string",
      "title": "Instrument",
      "description": "The instrument used under 'Survey Plan'.",
      "enum": [
        "Custom",
        "SUS",
        "NPS",
        "CSAT",
        "SEQ"
      ]
    },
    "options": {
      "type": "string",
      "title": "Options",
      "description": "The options used under 'Core Questions'.",
      "enum": [
        "List options",
        "scale endpoints"
      ]
    },
    "product": {
      "type": "string",
      "title": "Product",
      "description": "[How long have you used. From section 'Demographics (at end)'."
    },
    "question": {
      "type": "string",
      "title": "Question",
      "description": "1. From section 'Core Questions'."
    },
    "survey_name": {
      "type": "string",
      "title": "Survey name",
      "description": "Survey Plan."
    },
    "type": {
      "type": "string",
      "title": "Type",
      "description": "The type used under 'Core Questions'.",
      "enum": [
        "Multiple choice",
        "Rating scale",
        "Ranking",
        "Open-ended"
      ]
    }
  },
  "required": [
    "date",
    "distribution",
    "instrument",
    "options",
    "product",
    "question",
    "survey_name",
    "type"
  ],
  "x-faion-dictionary-refs": 0
}
