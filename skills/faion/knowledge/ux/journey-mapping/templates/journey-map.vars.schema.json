{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/journey-mapping/journey-map.vars.schema.json",
  "title": "journey-map template variables",
  "description": "Values for templates/journey-map.md.j2 and templates/journey-map.html.j2. Generated by tpl-jinja from journey-map.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "channel_location": {
      "type": "string",
      "title": "Channel location",
      "description": "Touchpoints. From section 'Journey Overview'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Customer Journey Map'."
    },
    "end_point": {
      "type": "string",
      "title": "End point",
      "description": "Scope. From section 'Customer Journey Map'."
    },
    "feeling": {
      "type": "string",
      "title": "Feeling",
      "description": "Emotions. From section 'Journey Overview'."
    },
    "friction": {
      "type": "string",
      "title": "Friction",
      "description": "Pain Points. From section 'Journey Overview'."
    },
    "h_m_l": {
      "type": "string",
      "title": "H m l",
      "description": "H/M/L. From section 'Key Pain Points'.",
      "enum": [
        "Interview ID",
        "ticket ID",
        "analytics event"
      ]
    },
    "impact_description": {
      "type": "string",
      "title": "Impact description",
      "description": "The impact description used under 'Prioritized Opportunities'."
    },
    "improvement_idea": {
      "type": "string",
      "title": "Improvement idea",
      "description": "Opportunities. From section 'Journey Overview'."
    },
    "journey_name": {
      "type": "string",
      "title": "Journey name",
      "description": "Customer Journey Map."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Row. From section 'Journey Overview'."
    },
    "persona_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/persona_name"
        }
      ],
      "description": "Persona. From section 'Customer Journey Map'."
    },
    "quote": {
      "type": "string",
      "title": "Quote",
      "description": "Thoughts. From section 'Journey Overview'."
    },
    "specific_friction": {
      "type": "string",
      "title": "Specific friction",
      "description": "The specific friction used under 'Key Pain Points'."
    },
    "specific_improvement": {
      "type": "string",
      "title": "Specific improvement",
      "description": "The specific improvement used under 'Prioritized Opportunities'."
    },
    "start_point": {
      "type": "string",
      "title": "Start point",
      "description": "Scope. From section 'Customer Journey Map'."
    },
    "thoughts": {
      "type": "string",
      "title": "Thoughts",
      "description": "The thoughts used under 'Journey Overview'.",
      "enum": [
        "Quote",
        "paraphrase"
      ]
    },
    "ticket_issue_id": {
      "type": "string",
      "title": "Ticket issue id",
      "description": "The ticket issue id used under 'Prioritized Opportunities'."
    }
  },
  "required": [
    "channel_location",
    "date",
    "end_point",
    "feeling",
    "friction",
    "h_m_l",
    "impact_description",
    "improvement_idea",
    "journey_name",
    "name",
    "persona_name",
    "quote",
    "specific_friction",
    "specific_improvement",
    "start_point",
    "thoughts",
    "ticket_issue_id"
  ],
  "x-faion-dictionary-refs": 1
}
