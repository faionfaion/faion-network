{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/journey-mapping/stage-detail.vars.schema.json",
  "title": "stage-detail template variables",
  "description": "Values for templates/stage-detail.md.j2 and templates/stage-detail.html.j2. Generated by tpl-jinja from stage-detail.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action_1": {
      "type": "string",
      "title": "Action 1",
      "description": "The action 1 used under 'Actions'."
    },
    "action_2": {
      "type": "string",
      "title": "Action 2",
      "description": "The action 2 used under 'Actions'."
    },
    "action_3": {
      "type": "string",
      "title": "Action 3",
      "description": "The action 3 used under 'Actions'."
    },
    "channel_location_1": {
      "type": "string",
      "title": "Channel location 1",
      "description": "The channel location 1 used under 'Touchpoints'."
    },
    "channel_location_2": {
      "type": "string",
      "title": "Channel location 2",
      "description": "The channel location 2 used under 'Touchpoints'."
    },
    "evidence": {
      "type": "string",
      "title": "Evidence",
      "description": "The evidence used under 'Emotional State'.",
      "enum": [
        "Quote",
        "behavioral observation"
      ]
    },
    "improvement_idea_1": {
      "type": "string",
      "title": "Improvement idea 1",
      "description": "The improvement idea 1 used under 'Opportunities'."
    },
    "improvement_idea_2": {
      "type": "string",
      "title": "Improvement idea 2",
      "description": "The improvement idea 2 used under 'Opportunities'."
    },
    "parent_journey_name": {
      "type": "string",
      "title": "Parent journey name",
      "description": "Journey. From section 'Stage Detail'."
    },
    "persona_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/persona_name"
    },
    "relevant_metric": {
      "type": "string",
      "title": "Relevant metric",
      "description": "The relevant metric used under 'Metrics for This Stage'."
    },
    "stage_name": {
      "type": "string",
      "title": "Stage name",
      "description": "Stage Detail."
    }
  },
  "required": [
    "action_1",
    "action_2",
    "action_3",
    "channel_location_1",
    "channel_location_2",
    "evidence",
    "improvement_idea_1",
    "improvement_idea_2",
    "parent_journey_name",
    "persona_name",
    "relevant_metric",
    "stage_name"
  ],
  "x-faion-dictionary-refs": 1
}
