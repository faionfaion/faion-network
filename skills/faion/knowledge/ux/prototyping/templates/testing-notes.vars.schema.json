  "type": "object",
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Prototype Testing Notes'."
    },
    "h_m_l": {
      "type": "string",
      "title": "H m l",
      "description": "The h m l used under 'Issues Found'."
    },
    "id": {
      "type": "string",
      "title": "Id",
      "description": "Participant. From section 'Prototype Testing Notes'."
    },
    "issue": {
      "type": "string",
      "title": "Issue",
      "description": "The issue used under 'Issues Found'."
    },
    "notes": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/notes"
    },
    "recommendation_1": {
      "type": "string",
      "title": "Recommendation 1",
      "description": "The recommendation 1 used under 'Recommendations'."
    },
    "same_structure": {
      "type": "string",
      "title": "Same structure",
      "description": "The same structure used under 'Task 2'."
    },
    "screen": {
      "type": "string",
      "title": "Screen",
      "description": "The screen used under 'Issues Found'."
    },
    "session_facilitator": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/session_facilitator"
    },
    "task_description": {
      "type": "string",
      "title": "Task description",
      "description": "Task 1. From section 'Prototype Testing Notes'."
    },
    "user_quote": {
      "type": "string",
      "title": "User quote",
      "description": "Quote. From section 'Task 1'."
    },
    "what_user_did": {
      "type": "string",
      "title": "What user did",
      "description": "The what user did used under 'Task 1'."
    },
    "what_was_unclear": {
      "type": "string",
      "title": "What was unclear",
      "description": "Confused by. From section 'Overall Feedback'."
    },
    "what_worked": {
      "type": "string",
      "title": "What worked",
      "description": "Liked. From section 'Overall Feedback'."
    },
    "where_they_struggled": {
      "type": "string",
      "title": "Where they struggled",
      "description": "The where they struggled used under 'Task 1'."
    }
