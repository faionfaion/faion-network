{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/cog-walk-process/cw-findings.vars.schema.json",
  "title": "cw-findings template variables",
  "description": "Values for templates/cw-findings.md.j2 and templates/cw-findings.html.j2. Generated by tpl-jinja from cw-findings.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "critical_issues": {
      "type": "integer",
      "title": "Critical issues",
      "description": "The critical issues used under 'Summary (max 5 bullets)'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Cognitive Walkthrough Findings'."
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "Q failure. From section 'Step 1'."
    },
    "fix": {
      "type": "string",
      "title": "Fix",
      "description": "1. From section 'Priority Actions'."
    },
    "names": {
      "type": "string",
      "title": "Names",
      "description": "Evaluators. From section 'Cognitive Walkthrough Findings'."
    },
    "next_step": {
      "type": "string",
      "title": "Next step",
      "description": "Recommended action. From section 'Summary (max 5 bullets)'."
    },
    "optimal_path": {
      "type": "integer",
      "title": "Optimal path",
      "description": "The optimal path used under 'Task Context'."
    },
    "same_structure": {
      "type": "string",
      "title": "Same structure",
      "description": "The same structure used under 'Step 2'."
    },
    "specific_fix": {
      "type": "string",
      "title": "Specific fix",
      "description": "Step , Q. From section 'Priority Actions'."
    },
    "steps_evaluated": {
      "type": "integer",
      "title": "Steps evaluated",
      "description": "The steps evaluated used under 'Summary (max 5 bullets)'."
    },
    "task_evaluated": {
      "type": "string",
      "title": "Task evaluated",
      "description": "Task. From section 'Cognitive Walkthrough Findings'."
    },
    "what_worked": {
      "type": "string",
      "title": "What worked",
      "description": "Step. From section 'Positive Findings (keep these)'."
    }
  },
  "required": [
    "critical_issues",
    "date",
    "description",
    "fix",
    "names",
    "next_step",
    "optimal_path",
    "same_structure",
    "specific_fix",
    "steps_evaluated",
    "task_evaluated",
    "what_worked"
  ],
  "x-faion-dictionary-refs": 0
}
