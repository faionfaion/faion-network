{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/cog-walk-process/walkthrough-plan.vars.schema.json",
  "title": "walkthrough-plan template variables",
  "description": "Values for templates/walkthrough-plan.md.j2 and templates/walkthrough-plan.html.j2. Generated by tpl-jinja from walkthrough-plan.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "alternative_flows": {
      "type": "string",
      "title": "Alternative flows",
      "description": "The alternative flows used under 'Scope'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Cognitive Walkthrough Plan'."
    },
    "error_paths": {
      "type": "string",
      "title": "Error paths",
      "description": "The error paths used under 'Scope'."
    },
    "expert_shortcuts": {
      "type": "string",
      "title": "Expert shortcuts",
      "description": "The expert shortcuts used under 'Scope'."
    },
    "link": {
      "type": "string",
      "title": "Link",
      "description": "The link used under 'Interface'.",
      "enum": [
        "URL",
        "Figma prototype link"
      ]
    },
    "persona": {
      "type": "string",
      "title": "Persona",
      "description": "The persona used under 'User Profile'.",
      "enum": [
        "Name",
        "description"
      ]
    },
    "screen_1": {
      "type": "string",
      "title": "Screen 1",
      "description": "The screen 1 used under 'Scope'."
    },
    "screen_2": {
      "type": "string",
      "title": "Screen 2",
      "description": "The screen 2 used under 'Scope'."
    },
    "session_facilitator": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/session_facilitator"
        }
      ],
      "description": "Facilitator. From section 'Cognitive Walkthrough Plan'."
    }
  },
  "required": [
    "alternative_flows",
    "date",
    "error_paths",
    "expert_shortcuts",
    "link",
    "persona",
    "screen_1",
    "screen_2"
  ],
  "x-faion-dictionary-refs": 1
}
