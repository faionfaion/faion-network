{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/journey-mapping-ux-research/journey-map.vars.schema.json",
  "title": "journey-map template variables",
  "description": "Values for templates/journey-map.md.j2 and templates/journey-map.html.j2. Generated by tpl-jinja from journey-map.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "channels": {
      "type": "string",
      "title": "Channels",
      "description": "Touchpoints. From section 'Journey Overview'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Customer Journey Map'."
    },
    "end_point": {
      "type": "string",
      "title": "End point",
      "description": "Scope. From section 'Customer Journey Map'."
    },
    "feeling_1_5": {
      "type": "string",
      "title": "Feeling 1 5",
      "description": "Emotions. From section 'Journey Overview'."
    },
    "friction": {
      "type": "string",
      "title": "Friction",
      "description": "Pain Points. From section 'Journey Overview'."
    },
    "goal": {
      "type": "string",
      "title": "Goal",
      "description": "User Goal. From section 'Journey Overview'."
    },
    "journey_name": {
      "type": "string",
      "title": "Journey name",
      "description": "Customer Journey Map."
    },
    "kpi": {
      "type": "string",
      "title": "Kpi",
      "description": "Metrics. From section 'Journey Overview'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Row. From section 'Journey Overview'."
    },
    "pain": {
      "type": "string",
      "title": "Pain",
      "description": "The pain used under 'Key Pain Points (prioritized by impact)'."
    },
    "persona_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/persona_name"
        }
      ],
      "description": "Persona. From section 'Customer Journey Map'."
    },
    "research_source": {
      "type": "string",
      "title": "Research source",
      "description": "H/M/L. From section 'Key Pain Points (prioritized by impact)'."
    },
    "second_priority": {
      "type": "string",
      "title": "Second priority",
      "description": "2. From section 'Prioritized Actions'."
    },
    "stage": {
      "type": "string",
      "title": "Stage",
      "description": "The stage used under 'Key Pain Points (prioritized by impact)'."
    },
    "start_point": {
      "type": "string",
      "title": "Start point",
      "description": "Scope. From section 'Customer Journey Map'."
    },
    "third_priority": {
      "type": "string",
      "title": "Third priority",
      "description": "3. From section 'Prioritized Actions'."
    },
    "what_they_think": {
      "type": "string",
      "title": "What they think",
      "description": "Thoughts. From section 'Journey Overview'."
    }
  },
  "required": [
    "channels",
    "date",
    "end_point",
    "feeling_1_5",
    "friction",
    "goal",
    "journey_name",
    "kpi",
    "name",
    "pain",
    "persona_name",
    "research_source",
    "second_priority",
    "stage",
    "start_point",
    "third_priority",
    "what_they_think"
  ],
  "x-faion-dictionary-refs": 1
}
