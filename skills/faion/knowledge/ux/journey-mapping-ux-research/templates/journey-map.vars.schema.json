{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/journey-mapping-ux-research/journey-map.vars.schema.json",
  "title": "journey-map template variables",
  "description": "Values for templates/journey-map.md.j2 and templates/journey-map.html.j2. Generated by tpl-jinja from journey-map.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Customer Journey Map'."
    },
    "end_point": {
      "type": "string",
      "title": "End point",
      "description": "Scope. From section 'Customer Journey Map'."
    },
    "journey_name": {
      "type": "string",
      "title": "Journey name",
      "description": "Customer Journey Map."
    },
    "pain": {
      "type": "string",
      "title": "Pain",
      "description": "The pain used under 'Key Pain Points (prioritized by impact)'."
    },
    "persona_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/persona_name"
    },
    "research_source": {
      "type": "string",
      "title": "Research source",
      "description": "H/M/L. From section 'Key Pain Points (prioritized by impact)'."
    },
    "second_priority": {
      "type": "string",
      "title": "Second priority",
      "description": "2. From section 'Prioritized Actions'."
    },
    "stage": {
      "type": "string",
      "title": "Stage",
      "description": "The stage used under 'Key Pain Points (prioritized by impact)'."
    },
    "start_point": {
      "type": "string",
      "title": "Start point",
      "description": "Scope. From section 'Customer Journey Map'."
    },
    "third_priority": {
      "type": "string",
      "title": "Third priority",
      "description": "3. From section 'Prioritized Actions'."
    }
  },
  "required": [
    "date",
    "end_point",
    "journey_name",
    "pain",
    "persona_name",
    "research_source",
    "second_priority",
    "stage",
    "start_point",
    "third_priority"
  ],
  "x-faion-dictionary-refs": 1
}
