{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/wireframing-ui-design/wireframe-doc.vars.schema.json",
  "title": "wireframe-doc template variables",
  "description": "Values for templates/wireframe-doc.md.j2 and templates/wireframe-doc.html.j2. Generated by tpl-jinja from wireframe-doc.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Wireframe'."
    },
    "element": {
      "type": "string",
      "title": "Element",
      "description": "The element used under 'Interactions'."
    },
    "layout_notes": {
      "type": "string",
      "title": "Layout notes",
      "description": "Desktop (1280px+). From section 'Responsive Considerations'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Designer. From section 'Wireframe'."
    },
    "outcome_next_state": {
      "type": "string",
      "title": "Outcome next state",
      "description": "Click / Hover / Focus. From section 'Interactions'."
    },
    "page_screen_name": {
      "type": "string",
      "title": "Page screen name",
      "description": "Wireframe."
    },
    "what_happens": {
      "type": "string",
      "title": "What happens",
      "description": "Click / Hover / Focus. From section 'Interactions'."
    }
  },
  "required": [
    "date",
    "element",
    "layout_notes",
    "name",
    "outcome_next_state",
    "page_screen_name",
    "what_happens"
  ],
  "x-faion-dictionary-refs": 0
}
