    },
    "product": {
      "type": "string",
      "title": "Product",
      "description": "Spatial Platform Decision."
    },
    "risk_1": {
      "type": "string",
      "title": "Risk 1",
      "description": "The risk 1 used under 'Risks'."
    },
    "risk_2": {
      "type": "string",
      "title": "Risk 2",
      "description": "The risk 2 used under 'Risks'."
    }
