{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/competitive-analysis/competitor-profile.vars.schema.json",
  "title": "competitor-profile template variables",
  "description": "Values for templates/competitor-profile.md.j2 and templates/competitor-profile.html.j2. Generated by tpl-jinja from competitor-profile.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "approximate": {
      "type": "string",
      "title": "Approximate",
      "description": "Time to value."
    },
    "company_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/company_name"
        }
      ],
      "description": "Competitor Profile."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "Analyzed. From section 'Competitor Profile'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Analyzer. From section 'Competitor Profile'."
    },
    "step_1": {
      "type": "string",
      "title": "Step 1",
      "description": "1."
    },
    "step_2": {
      "type": "string",
      "title": "Step 2",
      "description": "2."
    },
    "step_3": {
      "type": "string",
      "title": "Step 3",
      "description": "3."
    },
    "strength_2": {
      "type": "string",
      "title": "Strength 2",
      "description": "The strength 2 used under 'Strengths'."
    },
    "url": {
      "type": "string",
      "title": "Url",
      "description": "Website. From section 'Competitor Profile'."
    },
    "weakness_1_specific": {
      "type": "string",
      "title": "Weakness 1 specific",
      "description": "The weakness 1 specific used under 'Weaknesses'."
    },
    "weakness_2": {
      "type": "string",
      "title": "Weakness 2",
      "description": "The weakness 2 used under 'Weaknesses'."
    }
  },
  "required": [
    "approximate",
    "company_name",
    "date",
    "name",
    "step_1",
    "step_2",
    "step_3",
    "strength_2",
    "url",
    "weakness_1_specific",
    "weakness_2"
  ],
  "x-faion-dictionary-refs": 1
}
