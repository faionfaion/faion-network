{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/immersive-design-principles/immersive-spec.vars.schema.json",
  "title": "immersive-spec template variables",
  "description": "Values for templates/immersive-spec.md.j2 and templates/immersive-spec.html.j2. Generated by tpl-jinja from immersive-spec.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "audience": {
      "type": "string",
      "title": "Audience",
      "description": "The audience used under 'Immersive Spec'.",
      "enum": [
        "consumer",
        "enterprise",
        "education",
        "training"
      ]
    },
    "experience": {
      "type": "string",
      "title": "Experience",
      "description": "Immersive Spec."
    },
    "locomotion": {
      "type": "string",
      "title": "Locomotion",
      "description": "The locomotion used under 'Immersive Spec'.",
      "enum": [
        "teleport",
        "smooth-with-vignette",
        "comfort-toggle",
        "none-stationary"
      ]
    },
    "session_length": {
      "type": "integer",
      "title": "Session length",
      "description": "The session length used under 'Immersive Spec'."
    },
    "true_false": {
      "type": "boolean",
      "title": "True false",
      "description": "Spatial audio. From section 'Immersive Spec'."
    }
  },
  "required": [
    "audience",
    "experience",
    "locomotion",
    "session_length",
    "true_false"
  ],
  "x-faion-dictionary-refs": 0
}
