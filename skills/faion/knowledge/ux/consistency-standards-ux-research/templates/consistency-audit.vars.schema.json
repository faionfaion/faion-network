{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/consistency-standards-ux-research/consistency-audit.vars.schema.json",
  "title": "consistency-audit template variables",
  "description": "Values for templates/consistency-audit.md.j2 and templates/consistency-audit.html.j2. Generated by tpl-jinja from consistency-audit.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "concept_1": {
      "type": "string",
      "title": "Concept 1",
      "description": "The concept 1 used under 'Terminology Consistency'."
    },
    "concept_2": {
      "type": "string",
      "title": "Concept 2",
      "description": "The concept 2 used under 'Terminology Consistency'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Consistency Audit'."
    },
    "icon_set_name": {
      "type": "string",
      "title": "Icon set name",
      "description": "Icons. From section 'Visual Consistency'."
    },
    "product": {
      "type": "string",
      "title": "Product",
      "description": "Consistency Audit."
    },
    "reviewer_name": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/reviewer_name"
    },
    "scope": {
      "type": "string",
      "title": "Scope",
      "description": "The scope used under 'Consistency Audit'.",
      "enum": [
        "Pages",
        "features reviewed"
      ]
    },
    "token_names": {
      "type": "string",
      "title": "Token names",
      "description": "Colors. From section 'Visual Consistency'."
    }
  },
  "required": [
    "concept_1",
    "concept_2",
    "date",
    "icon_set_name",
    "product",
    "scope",
    "token_names"
  ],
  "x-faion-dictionary-refs": 1
}
