{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/feature-discovery/feature-request-log.vars.schema.json",
  "title": "feature-request-log template variables",
  "description": "Values for templates/feature-request-log.md.j2 and templates/feature-request-log.html.j2. Generated by tpl-jinja from feature-request-log.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "feature_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/feature_name"
        }
      ],
      "description": "Feature Request."
    },
    "high_medium_low": {
      "type": "string",
      "title": "High medium low",
      "description": "Retention impact. From section 'Impact Assessment'."
    },
    "n_times_requested": {
      "type": "string",
      "title": "N times requested",
      "description": "Request count. From section 'Request Details'."
    },
    "n_users": {
      "type": "string",
      "title": "N users",
      "description": "Estimated demand. From section 'Validation'."
    },
    "name_segment": {
      "type": "string",
      "title": "Name segment",
      "description": "Requester. From section 'Request Details'."
    },
    "planned_rejected_deferred": {
      "type": "string",
      "title": "Planned rejected deferred",
      "description": "Status. From section 'Decision'."
    },
    "why": {
      "type": "string",
      "title": "Why",
      "description": "Reasoning. From section 'Decision'."
    }
  },
  "required": [
    "feature_name",
    "high_medium_low",
    "n_times_requested",
    "n_users",
    "name_segment",
    "planned_rejected_deferred",
    "why"
  ],
  "x-faion-dictionary-refs": 1
}
