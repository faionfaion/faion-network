{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/help-documentation-a11y/help-audit.vars.schema.json",
  "title": "help-audit template variables",
  "description": "Values for templates/help-audit.md.j2 and templates/help-audit.html.j2. Generated by tpl-jinja from help-audit.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "content": {
      "type": "string",
      "title": "Content",
      "description": "The content used under 'Help Content Quality'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Help Audit'."
    },
    "fix": {
      "type": "string",
      "title": "Fix",
      "description": "H/M/L H/M/L. From section 'Gaps Identified'."
    },
    "gap": {
      "type": "string",
      "title": "Gap",
      "description": "The gap used under 'Gaps Identified'."
    },
    "notes": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/notes"
        }
      ],
      "description": "Y/N Y/N. From section 'Common User Questions'."
    },
    "page_feature": {
      "type": "string",
      "title": "Page feature",
      "description": "The page feature used under 'Help Availability'."
    },
    "product_feature": {
      "type": "string",
      "title": "Product feature",
      "description": "Help Audit."
    },
    "question": {
      "type": "string",
      "title": "Question",
      "description": "The question used under 'Common User Questions'."
    },
    "rating": {
      "type": "string",
      "title": "Rating",
      "description": "Y/N Tooltip/Inline/How-to/FAQ. From section 'Help Availability'."
    },
    "reviewer_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/reviewer_name"
        }
      ],
      "description": "Reviewer. From section 'Help Audit'."
    },
    "second_priority": {
      "type": "string",
      "title": "Second priority",
      "description": "2. From section 'Priority Improvements'."
    },
    "third_priority": {
      "type": "string",
      "title": "Third priority",
      "description": "3. From section 'Priority Improvements'."
    }
  },
  "required": [
    "content",
    "date",
    "fix",
    "gap",
    "page_feature",
    "product_feature",
    "question",
    "rating",
    "second_priority",
    "third_priority"
  ],
  "x-faion-dictionary-refs": 2
}
