{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/cognitive-walkthrough/evaluation-form.vars.schema.json",
  "title": "evaluation-form template variables",
  "description": "Values for templates/evaluation-form.md.j2 and templates/evaluation-form.html.j2. Generated by tpl-jinja from evaluation-form.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "title": "Action",
      "description": "Step."
    },
    "severity_description_recommendation": {
      "type": "string",
      "title": "Severity description recommendation",
      "description": "Finding (if any). From section 'Step'."
    },
    "yes_no_note": {
      "type": "string",
      "title": "Yes no note",
      "description": "Q1 right effect. From section 'Step'."
    }
  },
  "required": [
    "action",
    "severity_description_recommendation",
    "yes_no_note"
  ],
  "x-faion-dictionary-refs": 0
}
