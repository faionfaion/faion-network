{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/wireframing/wireframe-doc.vars.schema.json",
  "title": "wireframe-doc template variables",
  "description": "Values for templates/wireframe-doc.md.j2 and templates/wireframe-doc.html.j2. Generated by tpl-jinja from wireframe-doc.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Wireframe'."
    },
    "element": {
      "type": "string",
      "title": "Element",
      "description": "The element used under 'Interactions'."
    },
    "how_layout_changes": {
      "type": "string",
      "title": "How layout changes",
      "description": "Desktop (1280px+). From section 'Responsive Notes'."
    },
    "outcome_state_change": {
      "type": "string",
      "title": "Outcome state change",
      "description": "Click / Hover / Submit. From section 'Interactions'."
    },
    "page_screen_name": {
      "type": "string",
      "title": "Page screen name",
      "description": "Wireframe."
    },
    "question_2": {
      "type": "string",
      "title": "Question 2",
      "description": "The question 2 used under 'Open Questions'."
    },
    "what_happens": {
      "type": "string",
      "title": "What happens",
      "description": "Click / Hover / Submit. From section 'Interactions'."
    }
  },
  "required": [
    "date",
    "element",
    "how_layout_changes",
    "outcome_state_change",
    "page_screen_name",
    "question_2",
    "what_happens"
  ],
  "x-faion-dictionary-refs": 0
}
