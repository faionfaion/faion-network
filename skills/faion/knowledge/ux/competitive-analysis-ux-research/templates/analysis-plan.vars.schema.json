      "description": "The criterion 2 used under 'Evaluation Criteria'."
    },
    "criterion_3": {
      "type": "string",
      "title": "Criterion 3",
      "description": "The criterion 3 used under 'Evaluation Criteria'."
    },
    "date": {
      "type": "string",
