{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/ar-design-patterns/ar-screen-spec.vars.schema.json",
  "title": "ar-screen-spec template variables",
  "description": "Values for templates/ar-screen-spec.md.j2 and templates/ar-screen-spec.html.j2. Generated by tpl-jinja from ar-screen-spec.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "anchoring": {
      "type": "string",
      "title": "Anchoring",
      "description": "The anchoring used under 'Screen'.",
      "enum": [
        "plane",
        "saved-anchor",
        "image"
      ]
    },
    "estimated_baked_none": {
      "type": "string",
      "title": "Estimated baked none",
      "description": "Lighting. From section 'Screen'."
    },
    "gestures": {
      "type": "string",
      "title": "Gestures",
      "description": "The gestures used under 'Screen'.",
      "enum": [
        "move",
        "scale",
        "rotate map"
      ]
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Screen."
    },
    "occlusion": {
      "type": "string",
      "title": "Occlusion",
      "description": "The occlusion used under 'Screen'.",
      "enum": [
        "people",
        "depth",
        "people+depth",
        "none"
      ]
    },
    "prompt_state_preservation": {
      "type": "string",
      "title": "Prompt state preservation",
      "description": "Track-loss path. From section 'Screen'."
    },
    "runtime": {
      "type": "string",
      "title": "Runtime",
      "description": "The runtime used under 'Screen'.",
      "enum": [
        "ARKit",
        "ARCore",
        "WebXR",
        "Unity-ARF"
      ]
    }
  },
  "required": [
    "anchoring",
    "estimated_baked_none",
    "gestures",
    "name",
    "occlusion",
    "prompt_state_preservation",
    "runtime"
  ],
  "x-faion-dictionary-refs": 0
}
