{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/tree-testing-ux-research/results-report.vars.schema.json",
  "title": "results-report template variables",
  "description": "Values for templates/results-report.md.j2 and templates/results-report.html.j2. Generated by tpl-jinja from results-report.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "abandoned": {
      "type": "string",
      "title": "Abandoned",
      "description": "The abandoned used under 'Task 1'."
    },
    "change_1": {
      "type": "string",
      "title": "Change 1",
      "description": "1. From section 'Recommendations'."
    },
    "change_2": {
      "type": "string",
      "title": "Change 2",
      "description": "2. From section 'Recommendations'."
    },
    "change_3": {
      "type": "string",
      "title": "Change 3",
      "description": "1. From section 'Recommendations'."
    },
    "correct_path": {
      "type": "string",
      "title": "Correct path",
      "description": "The correct path used under 'Task 1'."
    },
    "correct_section": {
      "type": "string",
      "title": "Correct section",
      "description": "The correct section used under 'Task 1'."
    },
    "end": {
      "type": "string",
      "title": "End",
      "description": "Test dates. From section 'Tree Testing Results'."
    },
    "finding_1": {
      "type": "string",
      "title": "Finding 1",
      "description": "1. From section 'Executive Summary'."
    },
    "finding_2": {
      "type": "string",
      "title": "Finding 2",
      "description": "2. From section 'Executive Summary'."
    },
    "finding_3": {
      "type": "string",
      "title": "Finding 3",
      "description": "3. From section 'Executive Summary'."
    },
    "n_1": {
      "type": "string",
      "title": "N 1",
      "description": "Next action. From section 'Recommendations'."
    },
    "overall_success_rate": {
      "type": "string",
      "title": "Overall success rate",
      "description": "The overall success rate used under 'Executive Summary'.",
      "enum": [
        "Excellent",
        "Acceptable",
        "Problem",
        "Major issue"
      ]
    },
    "participants": {
      "type": "integer",
      "title": "Participants",
      "description": "The participants used under 'Tree Testing Results'."
    },
    "root_cause": {
      "type": "string",
      "title": "Root cause",
      "description": "The root cause used under 'Task 1'.",
      "enum": [
        "Label confusion",
        "Structure mismatch",
        "Content seems absent"
      ]
    },
    "scenario_text": {
      "type": "string",
      "title": "Scenario text",
      "description": "Task 1. From section 'Per-Task Results'."
    },
    "start": {
      "type": "string",
      "title": "Start",
      "description": "Test dates. From section 'Tree Testing Results'."
    },
    "tasks": {
      "type": "integer",
      "title": "Tasks",
      "description": "The tasks used under 'Tree Testing Results'."
    },
    "tool": {
      "type": "string",
      "title": "Tool",
      "description": "The tool used under 'Tree Testing Results'.",
      "enum": [
        "Optimal Workshop",
        "UXtweak",
        "Maze"
      ]
    },
    "version": {
      "type": "string",
      "title": "Version",
      "description": "IA Version. From section 'Tree Testing Results'."
    },
    "wrong_path_1": {
      "type": "string",
      "title": "Wrong path 1",
      "description": "The wrong path 1 used under 'Task 1'."
    },
    "wrong_section": {
      "type": "string",
      "title": "Wrong section",
      "description": "The wrong section used under 'Task 1'."
    },
    "x": {
      "type": "string",
      "title": "X",
      "description": "Overall success rate. From section 'Executive Summary'."
    },
    "x_sec": {
      "type": "string",
      "title": "X sec",
      "description": "Success rate: Directness. From section 'Task 1'."
    }
  },
  "required": [
    "abandoned",
    "change_1",
    "change_2",
    "change_3",
    "correct_path",
    "correct_section",
    "end",
    "finding_1",
    "finding_2",
    "finding_3",
    "n_1",
    "overall_success_rate",
    "participants",
    "root_cause",
    "scenario_text",
    "start",
    "tasks",
    "tool",
    "version",
    "wrong_path_1",
    "wrong_section",
    "x",
    "x_sec"
  ],
  "x-faion-dictionary-refs": 0
}
