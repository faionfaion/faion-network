{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/diary-studies/entry-event.vars.schema.json",
  "title": "entry-event template variables",
  "description": "Values for templates/entry-event.md.j2 and templates/entry-event.html.j2. Generated by tpl-jinja from entry-event.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "context": {
      "type": "string",
      "title": "Context",
      "description": "Where."
    },
    "timestamp": {
      "type": "string",
      "title": "Timestamp",
      "description": "When."
    },
    "what_happened": {
      "type": "string",
      "title": "What happened",
      "description": "Trigger."
    }
  },
  "required": [
    "context",
    "timestamp",
    "what_happened"
  ],
  "x-faion-dictionary-refs": 0
}
