{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/contextual-inquiry/field-notes.vars.schema.json",
  "title": "field-notes template variables",
  "description": "Values for templates/field-notes.md.j2 and templates/field-notes.html.j2. Generated by tpl-jinja from field-notes.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "iso_date": {
      "type": "string",
      "title": "Iso date",
      "description": "Field Notes —."
    },
    "location": {
      "type": "string",
      "title": "Location",
      "description": "The location used under 'Field Notes —'.",
      "enum": [
        "ward",
        "office",
        "home",
        "other"
      ]
    },
    "min": {
      "type": "string",
      "title": "Min",
      "description": "Duration. From section 'Field Notes —'."
    },
    "participant_id": {
      "type": "string",
      "title": "Participant id",
      "description": "Field Notes."
    },
    "photo_refs_descriptions": {
      "type": "string",
      "title": "Photo refs descriptions",
      "description": "The photo refs descriptions used under 'Artefacts noted'."
    }
  },
  "required": [
    "iso_date",
    "location",
    "min",
    "participant_id",
    "photo_refs_descriptions"
  ],
  "x-faion-dictionary-refs": 0
}
