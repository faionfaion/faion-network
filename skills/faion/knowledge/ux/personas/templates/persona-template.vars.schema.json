{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/personas/persona-template.vars.schema.json",
  "title": "persona-template template variables",
  "description": "Values for templates/persona-template.md.j2 and templates/persona-template.html.j2. Generated by tpl-jinja from persona-template.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "exact_text": {
      "type": "string",
      "title": "Exact text",
      "description": "Verbatim quote."
    },
    "interview_date": {
      "type": "string",
      "title": "Interview date",
      "description": "Verbatim quote."
    },
    "iso": {
      "type": "string",
      "title": "Iso",
      "description": "Date-stamped."
    },
    "job": {
      "type": "string",
      "title": "Job",
      "description": "JTBD."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "JTBD."
    },
    "participant_id": {
      "type": "string",
      "title": "Participant id",
      "description": "Verbatim quote."
    },
    "product": {
      "type": "string",
      "title": "Product",
      "description": "JTBD."
    },
    "usage_story": {
      "type": "string",
      "title": "Usage story",
      "description": "Scenario."
    }
  },
  "required": [
    "exact_text",
    "interview_date",
    "iso",
    "job",
    "name",
    "participant_id",
    "product",
    "usage_story"
  ],
  "x-faion-dictionary-refs": 0
}
