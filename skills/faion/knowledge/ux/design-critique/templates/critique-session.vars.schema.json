{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/design-critique/critique-session.vars.schema.json",
  "title": "critique-session template variables",
  "description": "Values for templates/critique-session.md.j2 and templates/critique-session.html.j2. Generated by tpl-jinja from critique-session.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "title": "Action",
      "description": "The action used under 'Action Items'."
    },
    "business_constraint": {
      "type": "string",
      "title": "Business constraint",
      "description": "The business constraint used under 'Context'."
    },
    "decision_1": {
      "type": "string",
      "title": "Decision 1",
      "description": "The decision 1 used under 'Decisions Made'."
    },
    "directional_refinement_polish": {
      "type": "string",
      "title": "Directional refinement polish",
      "description": "Feedback requested. From section 'Context'."
    },
    "feature_screen_name": {
      "type": "string",
      "title": "Feature screen name",
      "description": "Design Critique."
    },
    "goal_1": {
      "type": "string",
      "title": "Goal 1",
      "description": "The goal 1 used under 'Design Goals'."
    },
    "goal_2": {
      "type": "string",
      "title": "Goal 2",
      "description": "The goal 2 used under 'Design Goals'."
    },
    "impact": {
      "type": "string",
      "title": "Impact",
      "description": "→ →. From section 'Major concerns (max 5)'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Presenter. From section 'Design Critique'."
    },
    "names": {
      "type": "string",
      "title": "Names",
      "description": "Participants. From section 'Design Critique'."
    },
    "observation": {
      "type": "string",
      "title": "Observation",
      "description": "The observation used under 'Major concerns (max 5)'."
    },
    "principle_goal": {
      "type": "string",
      "title": "Principle goal",
      "description": "The principle goal used under 'Major concerns (max 5)'."
    },
    "question": {
      "type": "string",
      "title": "Question",
      "description": "The question used under 'Clarifying questions raised'."
    },
    "session_facilitator": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/session_facilitator"
    },
    "technical_constraint": {
      "type": "string",
      "title": "Technical constraint",
      "description": "The technical constraint used under 'Context'."
    }
  },
  "required": [
    "action",
    "business_constraint",
    "decision_1",
    "directional_refinement_polish",
    "feature_screen_name",
    "goal_1",
    "goal_2",
    "impact",
    "name",
    "names",
    "observation",
    "principle_goal",
    "question",
    "technical_constraint"
  ],
  "x-faion-dictionary-refs": 1
}
