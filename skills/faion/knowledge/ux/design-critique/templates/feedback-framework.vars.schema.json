{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/design-critique/feedback-framework.vars.schema.json",
  "title": "feedback-framework template variables",
  "description": "Values for templates/feedback-framework.md.j2 and templates/feedback-framework.html.j2. Generated by tpl-jinja from feedback-framework.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "impact": {
      "type": "string",
      "title": "Impact",
      "description": "The impact used under 'Structure'.",
      "enum": [
        "positive",
        "negative consequence"
      ]
    },
    "mechanism": {
      "type": "string",
      "title": "Mechanism",
      "description": "Impact. From section 'Structure'."
    },
    "principle": {
      "type": "string",
      "title": "Principle",
      "description": "Principle/Goal. From section 'Structure'."
    },
    "specific_alternative": {
      "type": "string",
      "title": "Specific alternative",
      "description": "Suggestion (optional). From section 'Structure'."
    },
    "stated_design_goal": {
      "type": "string",
      "title": "Stated design goal",
      "description": "Principle/Goal. From section 'Structure'."
    }
  },
  "required": [
    "impact",
    "mechanism",
    "principle",
    "stated_design_goal"
  ],
  "x-faion-dictionary-refs": 0
}
