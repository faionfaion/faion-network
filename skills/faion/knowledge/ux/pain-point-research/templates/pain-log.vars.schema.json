{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/pain-point-research/pain-log.vars.schema.json",
  "title": "pain-log template variables",
  "description": "Values for templates/pain-log.md.j2 and templates/pain-log.html.j2. Generated by tpl-jinja from pain-log.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "audience": {
      "type": "string",
      "title": "Audience",
      "description": "Pain Point Research Log."
    },
    "brief": {
      "type": "string",
      "title": "Brief",
      "description": "PP-X. From section 'Top 5 Pain Points (Prioritized)'."
    },
    "exact_quote": {
      "type": "string",
      "title": "Exact quote",
      "description": "Quote. From section 'PP-001'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "PP-001. From section 'Pain Points Found'."
    },
    "where_found": {
      "type": "string",
      "title": "Where found",
      "description": "Source. From section 'PP-001'."
    }
  },
  "required": [
    "audience",
    "brief",
    "exact_quote",
    "name",
    "where_found"
  ],
  "x-faion-dictionary-refs": 0
}
