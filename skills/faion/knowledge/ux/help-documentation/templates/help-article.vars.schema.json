{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/help-documentation/help-article.vars.schema.json",
  "title": "help-article template variables",
  "description": "Values for templates/help-article.md.j2 and templates/help-article.html.j2. Generated by tpl-jinja from help-article.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action_verb_object": {
      "type": "string",
      "title": "Action verb object",
      "description": "Step 1. From section 'Steps'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "Last reviewed. From section 'Related Topics'."
    },
    "fix": {
      "type": "string",
      "title": "Fix",
      "description": "Solution. From section 'Troubleshooting'."
    },
    "instruction": {
      "type": "string",
      "title": "Instruction",
      "description": "The instruction used under 'Step 2'."
    },
    "reviewer_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/reviewer_name"
        }
      ],
      "description": "Last reviewed. From section 'Related Topics'."
    },
    "second_common_issue": {
      "type": "string",
      "title": "Second common issue",
      "description": "Problem. From section 'Troubleshooting'."
    },
    "task_name": {
      "type": "string",
      "title": "Task name",
      "description": "How to."
    }
  },
  "required": [
    "action_verb_object",
    "date",
    "fix",
    "instruction",
    "second_common_issue",
    "task_name"
  ],
  "x-faion-dictionary-refs": 1
}
