{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/prototyping-ui-design/testing-notes.vars.schema.json",
  "title": "testing-notes template variables",
  "description": "Values for templates/testing-notes.md.j2 and templates/testing-notes.html.j2. Generated by tpl-jinja from testing-notes.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Prototype Testing Notes'."
    },
    "direct_user_quote": {
      "type": "string",
      "title": "Direct user quote",
      "description": "Quote. From section 'Task 1'."
    },
    "issue": {
      "type": "string",
      "title": "Issue",
      "description": "The issue used under 'Task 1'."
    },
    "rating": {
      "type": "string",
      "title": "Rating",
      "description": "Overall ease (1-5). From section 'Post-Session Rating'."
    },
    "screen": {
      "type": "string",
      "title": "Screen",
      "description": "H/M/L. From section 'Task 1'."
    },
    "session_facilitator": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/session_facilitator"
    },
    "task_description": {
      "type": "string",
      "title": "Task description",
      "description": "Task 1. From section 'Prototype Testing Notes'."
    },
    "what_was_unclear": {
      "type": "string",
      "title": "What was unclear",
      "description": "Confused by. From section 'Overall Feedback'."
    },
    "what_worked_well": {
      "type": "string",
      "title": "What worked well",
      "description": "Liked. From section 'Overall Feedback'."
    }
  },
  "required": [
    "date",
    "direct_user_quote",
    "issue",
    "rating",
    "screen",
    "task_description",
    "what_was_unclear",
    "what_worked_well"
  ],
  "x-faion-dictionary-refs": 1
}
