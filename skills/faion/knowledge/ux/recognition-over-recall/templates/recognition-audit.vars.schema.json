{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/recognition-over-recall/recognition-audit.vars.schema.json",
  "title": "recognition-audit template variables",
  "description": "Values for templates/recognition-audit.md.j2 and templates/recognition-audit.html.j2. Generated by tpl-jinja from recognition-audit.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "context": {
      "type": "string",
      "title": "Context",
      "description": "Y/N. From section 'Hidden Information'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Recognition Audit'."
    },
    "feature_screen": {
      "type": "string",
      "title": "Feature screen",
      "description": "Recognition Audit."
    },
    "icon": {
      "type": "string",
      "title": "Icon",
      "description": "The icon used under 'Icons Without Labels'."
    },
    "info": {
      "type": "string",
      "title": "Info",
      "description": "The info used under 'Hidden Information'."
    },
    "issue": {
      "type": "string",
      "title": "Issue",
      "description": "The issue used under 'Recommendations'."
    },
    "location": {
      "type": "string",
      "title": "Location",
      "description": "The location used under 'Hidden Information'."
    },
    "meaning": {
      "type": "string",
      "title": "Meaning",
      "description": "The meaning used under 'Icons Without Labels'."
    },
    "prior_info_needed": {
      "type": "string",
      "title": "Prior info needed",
      "description": "The prior info needed used under 'Multi-step Context Failures'."
    },
    "recognition_fix": {
      "type": "string",
      "title": "Recognition fix",
      "description": "The recognition fix used under 'Recommendations'."
    },
    "reviewer_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/reviewer_name"
        }
      ],
      "description": "Reviewer. From section 'Recognition Audit'."
    },
    "step": {
      "type": "string",
      "title": "Step",
      "description": "The step used under 'Multi-step Context Failures'."
    },
    "task": {
      "type": "string",
      "title": "Task",
      "description": "The task used under 'Recall Requirements'."
    }
  },
  "required": [
    "context",
    "date",
    "feature_screen",
    "icon",
    "info",
    "issue",
    "location",
    "meaning",
    "prior_info_needed",
    "recognition_fix",
    "step",
    "task"
  ],
  "x-faion-dictionary-refs": 1
}
