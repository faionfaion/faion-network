{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/usability-testing-ux-research/test-plan.vars.schema.json",
  "title": "test-plan template variables",
  "description": "Values for templates/test-plan.md.j2 and templates/test-plan.html.j2. Generated by tpl-jinja from test-plan.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "how_recruited": {
      "type": "string",
      "title": "How recruited",
      "description": "Recruitment. From section 'Participants'."
    },
    "incentive": {
      "type": "string",
      "title": "Incentive",
      "description": "Compensation. From section 'Participants'."
    },
    "product_feature": {
      "type": "string",
      "title": "Product feature",
      "description": "Usability Test Plan."
    },
    "question_1": {
      "type": "string",
      "title": "Question 1",
      "description": "1. From section 'Objectives'."
    },
    "question_2": {
      "type": "string",
      "title": "Question 2",
      "description": "2. From section 'Objectives'."
    },
    "same_structure": {
      "type": "string",
      "title": "Same structure",
      "description": "The same structure used under 'Task 2'."
    },
    "time": {
      "type": "string",
      "title": "Time",
      "description": "The time used under 'Schedule'."
    },
    "where": {
      "type": "string",
      "title": "Where",
      "description": "Location. From section 'Test Environment'."
    },
    "x_minutes": {
      "type": "string",
      "title": "X minutes",
      "description": "Time limit. From section 'Task 1'."
    }
  },
  "required": [
    "how_recruited",
    "incentive",
    "product_feature",
    "question_1",
    "question_2",
    "same_structure",
    "time",
    "where",
    "x_minutes"
  ],
  "x-faion-dictionary-refs": 0
}
