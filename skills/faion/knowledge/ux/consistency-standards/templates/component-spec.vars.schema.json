{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/consistency-standards/component-spec.vars.schema.json",
  "title": "component-spec template variables",
  "description": "Values for templates/component-spec.md.j2 and templates/component-spec.html.j2. Generated by tpl-jinja from component-spec.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "additional_rule": {
      "type": "string",
      "title": "Additional rule",
      "description": "The additional rule used under 'Usage Rules'."
    },
    "large": {
      "type": "integer",
      "title": "Large",
      "description": "The large used under 'Sizes'."
    },
    "medium": {
      "type": "integer",
      "title": "Medium",
      "description": "The medium used under 'Sizes'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Component."
    },
    "small": {
      "type": "integer",
      "title": "Small",
      "description": "The small used under 'Sizes'."
    }
  },
  "required": [
    "additional_rule",
    "large",
    "medium",
    "name",
    "small"
  ],
  "x-faion-dictionary-refs": 0
}
