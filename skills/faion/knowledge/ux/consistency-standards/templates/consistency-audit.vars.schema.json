{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/ux/consistency-standards/consistency-audit.vars.schema.json",
  "title": "consistency-audit template variables",
  "description": "Values for templates/consistency-audit.md.j2 and templates/consistency-audit.html.j2. Generated by tpl-jinja from consistency-audit.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "title": "Action",
      "description": "The action used under 'Functional Consistency'."
    },
    "chosen_canonical": {
      "type": "string",
      "title": "Chosen canonical",
      "description": "The chosen canonical used under 'Terminology Consistency'."
    },
    "concept": {
      "type": "string",
      "title": "Concept",
      "description": "The concept used under 'Terminology Consistency'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Consistency Audit'."
    },
    "product": {
      "type": "string",
      "title": "Product",
      "description": "Consistency Audit."
    },
    "reviewer_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/reviewer_name"
        }
      ],
      "description": "Reviewer. From section 'Consistency Audit'."
    },
    "screens_where_different": {
      "type": "string",
      "title": "Screens where different",
      "description": "Y/N. From section 'Functional Consistency'."
    },
    "standard_behavior": {
      "type": "string",
      "title": "Standard behavior",
      "description": "Y/N. From section 'Functional Consistency'."
    },
    "total_inconsistencies_found": {
      "type": "integer",
      "title": "Total inconsistencies found",
      "description": "The total inconsistencies found used under 'Summary'."
    }
  },
  "required": [
    "action",
    "chosen_canonical",
    "concept",
    "date",
    "product",
    "screens_where_different",
    "standard_behavior",
    "total_inconsistencies_found"
  ],
  "x-faion-dictionary-refs": 1
}
