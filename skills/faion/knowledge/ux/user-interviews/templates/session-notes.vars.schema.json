      "description": "The behavior 1 used under 'Behaviors'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Interview Notes — Participant'."
    },
    "duration": {
      "type": "string",
      "title": "Duration",
      "description": "The duration used under 'Interview Notes — Participant'."
    },
    "id": {
      "type": "string",
      "title": "Id",
      "description": "Interview Notes — Participant."
    },
    "insight_1": {
      "type": "string",
      "title": "Insight 1",
      "description": "The insight 1 used under 'Surprising Insights'."
    },
    "level": {
      "type": "string",
      "title": "Level",
      "description": "Experience. From section 'Participant Profile'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Interviewer. From section 'Interview Notes — Participant'."
    },
    "need_1": {
      "type": "string",
      "title": "Need 1",
      "description": "The need 1 used under 'Needs / Desires'."
