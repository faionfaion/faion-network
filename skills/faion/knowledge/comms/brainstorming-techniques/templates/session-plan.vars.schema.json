{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/comms/brainstorming-techniques/session-plan.vars.schema.json",
  "title": "session-plan template variables",
  "description": "Values for templates/session-plan.md.j2 and templates/session-plan.html.j2. Generated by tpl-jinja from session-plan.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "count": {
      "type": "integer",
      "title": "Count",
      "description": "Ideas generated. From section 'Results'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Brainstorm'."
    },
    "names": {
      "type": "string",
      "title": "Names",
      "description": "Participants. From section 'Brainstorm'."
    },
    "session_facilitator": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/session_facilitator"
        }
      ],
      "description": "Facilitator. From section 'Brainstorm'."
    },
    "technique": {
      "type": "string",
      "title": "Technique",
      "description": "The technique used under 'Brainstorm'.",
      "enum": [
        "Classic",
        "Brainwriting 6-3-5",
        "Round Robin",
        "Reverse"
      ]
    },
    "time": {
      "type": "string",
      "title": "Time",
      "description": "Duration. From section 'Brainstorm'."
    },
    "topic": {
      "type": "string",
      "title": "Topic",
      "description": "Brainstorm."
    }
  },
  "required": [
    "count",
    "date",
    "names",
    "session_facilitator",
    "technique",
    "time",
    "topic"
  ],
  "x-faion-dictionary-refs": 1
}
