{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/comms/storytelling/presentation-outline.vars.schema.json",
  "title": "presentation-outline template variables",
  "description": "Values for templates/presentation-outline.md.j2 and templates/presentation-outline.html.j2. Generated by tpl-jinja from presentation-outline.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "complication": {
      "type": "string",
      "title": "Complication",
      "description": "The complication used under 'Problem (2-3 slides)'.",
      "enum": [
        "What tension",
        "change exists"
      ]
    },
    "what_we_propose": {
      "type": "string",
      "title": "What we propose",
      "description": "Approach. From section 'Solution (3-5 slides)'."
    }
  },
  "required": [
    "complication",
    "what_we_propose"
  ],
  "x-faion-dictionary-refs": 0
}
