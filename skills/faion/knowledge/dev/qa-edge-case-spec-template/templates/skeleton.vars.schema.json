{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/dev/qa-edge-case-spec-template/skeleton.vars.schema.json",
  "title": "skeleton template variables",
  "description": "Values for templates/skeleton.md.j2 and templates/skeleton.html.j2. Generated by tpl-jinja from skeleton.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owner_full_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_full_name"
        }
      ],
      "description": "Owner."
    },
    "pr_url": {
      "type": "string",
      "title": "Pr url",
      "description": "The pr url used under 'Evidence'."
    }
  },
  "required": [
    "owner_full_name",
    "pr_url"
  ],
  "x-faion-dictionary-refs": 1
}
