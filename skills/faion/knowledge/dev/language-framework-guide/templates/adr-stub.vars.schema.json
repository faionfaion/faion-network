{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/dev/language-framework-guide/adr-stub.vars.schema.json",
  "title": "adr-stub template variables",
  "description": "Values for templates/adr-stub.md.j2 and templates/adr-stub.html.j2. Generated by tpl-jinja from adr-stub.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "alt_1": {
      "type": "string",
      "title": "Alt 1",
      "description": "The alt 1 used under 'Alternatives Considered'."
    },
    "alt_2": {
      "type": "string",
      "title": "Alt 2",
      "description": "The alt 2 used under 'Alternatives Considered'."
    },
    "bullet": {
      "type": "string",
      "title": "Bullet",
      "description": "The bullet used under 'Consequences'."
    },
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'ADR-NNN'."
    },
    "project": {
      "type": "string",
      "title": "Project",
      "description": "ADR-NNN."
    },
    "reason": {
      "type": "string",
      "title": "Reason",
      "description": "Rejected because. From section 'Alternatives Considered'."
    }
  },
  "required": [
    "alt_1",
    "alt_2",
    "bullet",
    "date",
    "project",
    "reason"
  ],
  "x-faion-dictionary-refs": 0
}
