{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/dev/regression-test-first-bugfix-workflow/skeleton.vars.schema.json",
  "title": "skeleton template variables",
  "description": "Values for templates/skeleton.md.j2 and templates/skeleton.html.j2. Generated by tpl-jinja from skeleton.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "alert_url": {
      "type": "string",
      "title": "Alert url",
      "description": "Url. From section 'Alert'."
    },
    "assertion_1": {
      "type": "string",
      "title": "Assertion 1",
      "description": "The assertion 1 used under 'Red Test (committed FIRST)'."
    },
    "assertion_2": {
      "type": "string",
      "title": "Assertion 2",
      "description": "The assertion 2 used under 'Red Test (committed FIRST)'."
    },
    "ci_run_url": {
      "type": "string",
      "title": "Ci run url",
      "description": "The ci run url used under 'Verification'."
    },
    "int": {
      "type": "string",
      "title": "Int",
      "description": "Diff lines. From section 'Fix'."
    },
    "json_snippet": {
      "type": "string",
      "title": "Json snippet",
      "description": "Reproducing input. From section 'Alert'."
    },
    "owner_full_name": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_full_name"
        }
      ],
      "description": "Owner."
    },
    "pr_url": {
      "type": "string",
      "title": "Pr url",
      "description": "The pr url used under 'Fix'."
    },
    "short_hash": {
      "type": "string",
      "title": "Short hash",
      "description": "Commit. From section 'Red Test (committed FIRST)'."
    },
    "slug": {
      "type": "string",
      "title": "Slug",
      "description": "Path. From section 'Red Test (committed FIRST)'."
    }
  },
  "required": [
    "alert_url",
    "assertion_1",
    "assertion_2",
    "ci_run_url",
    "int",
    "json_snippet",
    "pr_url",
    "short_hash",
    "slug"
  ],
  "x-faion-dictionary-refs": 1
}
