# purpose: Build-context exclusion list — the file that decides what `COPY . .` cannot pick up
# consumes: nothing; it is read by the docker daemon before the build starts
# produces: a build context with no secrets, no VCS history and no local state in it
# depends-on: content/01-core-rules.xml
# token-budget-impact: ~150 tokens when loaded as context
#
# A Dockerfile with `COPY . .` and no .dockerignore beside it bakes whatever is
# in the directory into a pushed image: .env, a private key, the whole .git
# history. `docker history` and `docker save` read it back out of any layer, so
# deleting the file in a later RUN does not remove it. This file is the only
# place that can prevent it, and it must sit next to the Dockerfile — the daemon
# reads it from the build-context root, not from a parent.

# secrets — the reason this file exists
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
secrets/
credentials.json
service-account*.json
.aws/
.gcloud/
.kube/
.netrc
.npmrc
.pypirc

# version control and CI
.git/
.gitignore
.github/
.gitlab-ci.yml

# local tooling and editor state
.vscode/
.idea/
*.swp
.DS_Store
.direnv/
.envrc

# build and test artefacts that the image rebuilds anyway
Dockerfile*
.dockerignore
docker-compose*.yml
README.md
docs/
tests/

# pnpm / node
node_modules/
.pnpm-store/
dist/
build/
coverage/
*.log
