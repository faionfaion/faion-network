{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/dev/evolutionary-architecture-fitness-functions/skeleton.vars.schema.json",
  "title": "skeleton template variables",
  "description": "Values for templates/skeleton.md.j2 and templates/skeleton.html.j2. Generated by tpl-jinja from skeleton.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decision_statement": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/decision_statement"
        }
      ],
      "description": "The single declarative sentence used under 'Decision'."
    },
    "input_name": {
      "type": "string",
      "title": "Input name",
      "description": "Name. From section 'Inputs'."
    },
    "owner_handle": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_handle"
        }
      ],
      "description": "Owner."
    },
    "trigger_kind": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/trigger_kind"
        }
      ],
      "description": "Kind. From section 'Trigger'."
    },
    "trigger_url": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/trigger_url"
        }
      ],
      "description": "Trigger url."
    },
    "typed_value": {
      "type": "string",
      "title": "Typed value",
      "description": "Value. From section 'Inputs'."
    },
    "url_1": {
      "type": "string",
      "title": "Url 1",
      "description": "The url 1 used under 'Evidence'."
    },
    "url_2": {
      "type": "string",
      "title": "Url 2",
      "description": "The url 2 used under 'Evidence'."
    }
  },
  "required": [
    "decision_statement",
    "input_name",
    "owner_handle",
    "trigger_kind",
    "trigger_url",
    "typed_value",
    "url_1",
    "url_2"
  ],
  "x-faion-dictionary-refs": 4
}
