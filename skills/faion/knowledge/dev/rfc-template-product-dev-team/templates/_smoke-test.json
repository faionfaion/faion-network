        },
        {
          "name": "cache the pricing service responses in Redis for 60 s",
          "chosen": false,
          "rejection_reason": "cuts p95 to about 1.8 s in the spike test, short of the 1.2 s target; stale prices during promotions"
        },
        {
          "name": "do nothing / keep current behaviour",
          "chosen": false,
          "rejection_reason": "abandonment cost estimated at 40k per month at current traffic"
        }
      ]
    },
    {
      "name": "blast_radius",
