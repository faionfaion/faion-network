  "rfc": {
    "id": "RFC-118",
    "title": "Checkout p95 latency under 1.2 s",
    "author": "swe:alice",
    "shared_on": "2026-05-29"
  },
  "owner": "swe:alice",
  "inputs": [
    {
      "name": "problem",
