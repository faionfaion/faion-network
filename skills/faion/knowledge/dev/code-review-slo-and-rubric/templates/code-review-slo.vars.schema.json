{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/dev/code-review-slo-and-rubric/code-review-slo.vars.schema.json",
  "title": "code-review-slo template variables",
  "description": "Values for templates/code-review-slo.md.j2 and templates/code-review-slo.html.j2. Generated by tpl-jinja from code-review-slo.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owner_handle": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_handle"
    },
    "team": {
      "type": "string",
      "title": "Team",
      "description": "Code Review SLO + Rubric."
    },
    "tool": {
      "type": "string",
      "title": "Tool",
      "description": "The tool used under 'AI pre-review'.",
      "enum": [
        "Claude",
        "CodeRabbit",
        "GH Copilot"
      ]
    }
  },
  "required": [
    "team",
    "tool"
  ],
  "x-faion-dictionary-refs": 1
}
