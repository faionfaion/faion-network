{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/dev/event-sourcing-fundamentals/decision-record.vars.schema.json",
  "title": "decision-record template variables",
  "description": "Values for templates/decision-record.md.j2 and templates/decision-record.html.j2. Generated by tpl-jinja from decision-record.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "title": "Date",
      "description": "The date used under 'Context'."
    },
    "list": {
      "type": "string",
      "title": "List",
      "description": "Projections planned. From section 'Consequences'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Decision-maker. From section 'Context'."
    },
    "snapshot_policy": {
      "type": "string",
      "title": "Snapshot policy",
      "description": "The snapshot policy used under 'Consequences'.",
      "enum": [
        "every N events",
        "off"
      ]
    },
    "yes_no_why": {
      "type": "string",
      "title": "Yes no why",
      "description": "Audit need. From section 'Context'."
    }
  },
  "required": [
    "date",
    "list",
    "name",
    "snapshot_policy",
    "yes_no_why"
  ],
  "x-faion-dictionary-refs": 0
}
