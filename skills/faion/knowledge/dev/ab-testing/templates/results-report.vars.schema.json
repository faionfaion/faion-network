{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/dev/ab-testing/results-report.vars.schema.json",
  "title": "results-report template variables",
  "description": "Values for templates/results-report.md.j2 and templates/results-report.html.j2. Generated by tpl-jinja from results-report.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action_item": {
      "type": "string",
      "title": "Action item",
      "description": "The action item used under 'Next Steps'."
    },
    "end": {
      "type": "string",
      "title": "End",
      "description": "Test Period. From section 'A/B Test Results'."
    },
    "guardrail": {
      "type": "string",
      "title": "Guardrail",
      "description": "The guardrail used under 'Results'."
    },
    "learning_1": {
      "type": "string",
      "title": "Learning 1",
      "description": "The learning 1 used under 'Key Learnings'."
    },
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Guardrails. From section 'Summary'."
    },
    "primary": {
      "type": "string",
      "title": "Primary",
      "description": "The primary used under 'Results'."
    },
    "sample_size": {
      "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/sample_size"
    },
    "secondary": {
      "type": "string",
      "title": "Secondary",
      "description": "The secondary used under 'Results'."
    },
    "start": {
      "type": "string",
      "title": "Start",
      "description": "Test Period. From section 'A/B Test Results'."
    },
    "test_name": {
      "type": "string",
      "title": "Test name",
      "description": "A/B Test Results."
    },
    "x_days": {
      "type": "string",
      "title": "X days",
      "description": "Duration. From section 'A/B Test Results'."
    }
  },
  "required": [
    "action_item",
    "end",
    "guardrail",
    "learning_1",
    "name",
    "primary",
    "sample_size",
    "secondary",
    "start",
    "test_name",
    "x_days"
  ],
  "x-faion-dictionary-refs": 1
}
