{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/dev/codemod-recipe-library/codemod-recipe.vars.schema.json",
  "title": "codemod-recipe template variables",
  "description": "Values for templates/codemod-recipe.md.j2 and templates/codemod-recipe.html.j2. Generated by tpl-jinja from codemod-recipe.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "title": "Name",
      "description": "Codemod Recipe."
    },
    "owner_handle": {
      "allOf": [
        {
          "$ref": "../../../../templates/vars-dictionary.schema.json#/$defs/owner_handle"
        }
      ],
      "description": "Owner. From section 'Codemod Recipe'."
    },
    "tool": {
      "type": "string",
      "title": "Tool",
      "description": "The tool used under 'Codemod Recipe'.",
      "enum": [
        "jscodeshift",
        "ast-grep",
        "libcst",
        "Bowler"
      ]
    }
  },
  "required": [
    "name",
    "owner_handle",
    "tool"
  ],
  "x-faion-dictionary-refs": 1
}
