{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/dev/client-conventions-reverse-engineering/repo-rules.vars.schema.json",
  "title": "repo-rules template variables",
  "description": "Values for templates/repo-rules.md.j2 and templates/repo-rules.html.j2. Generated by tpl-jinja from repo-rules.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "allowed_sources": {
      "type": "string",
      "title": "Allowed sources",
      "description": "The allowed sources used under 'Dependency policy'.",
      "enum": [
        "npm public",
        "internal mirror"
      ]
    },
    "branch_model": {
      "type": "string",
      "title": "Branch model",
      "description": "The branch model used under 'Branching + commit'.",
      "enum": [
        "trunk",
        "gitflow",
        "github-flow"
      ]
    },
    "colocated_tests": {
      "type": "string",
      "title": "Colocated tests",
      "description": "Unit. From section 'Test placement'."
    },
    "files": {
      "type": "string",
      "title": "Files",
      "description": "The files used under 'Naming conventions'.",
      "enum": [
        "snake_case",
        "kebab-case"
      ]
    },
    "functions": {
      "type": "string",
      "title": "Functions",
      "description": "The functions used under 'Naming conventions'.",
      "enum": [
        "camelCase",
        "snake_case"
      ]
    },
    "list": {
      "type": "string",
      "title": "List",
      "description": "Rules of note. From section 'Lint / formatter'."
    },
    "pascal_case": {
      "type": "string",
      "title": "Pascal case",
      "description": "Classes. From section 'Naming conventions'."
    },
    "path": {
      "type": "string",
      "title": "Path",
      "description": "Config. From section 'Lint / formatter'."
    },
    "renovate_dependabot_manual": {
      "type": "string",
      "title": "Renovate dependabot manual",
      "description": "Updates. From section 'Dependency policy'."
    },
    "tests": {
      "type": "string",
      "title": "Tests",
      "description": "Integration. From section 'Test placement'."
    },
    "tool": {
      "type": "string",
      "title": "Tool",
      "description": "The tool used under 'Lint / formatter'.",
      "enum": [
        "eslint",
        "ruff",
        "prettier",
        "gofmt"
      ]
    }
  },
  "required": [
    "allowed_sources",
    "branch_model",
    "colocated_tests",
    "files",
    "functions",
    "list",
    "pascal_case",
    "path",
    "renovate_dependabot_manual",
    "tests",
    "tool"
  ],
  "x-faion-dictionary-refs": 0
}
