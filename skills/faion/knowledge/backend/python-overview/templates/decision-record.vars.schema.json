{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/backend/python-overview/decision-record.vars.schema.json",
  "title": "decision-record template variables",
  "description": "Values for templates/decision-record.md.j2 and templates/decision-record.html.j2. Generated by tpl-jinja from decision-record.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "domain": {
      "type": "string",
      "title": "Domain",
      "description": "The domain used under 'Decision Record'.",
      "enum": [
        "web",
        "data",
        "ml",
        "automation",
        "embedded"
      ]
    },
    "pinned": {
      "type": "string",
      "title": "Pinned",
      "description": "Python version. From section 'Decision Record'."
    },
    "slug": {
      "type": "string",
      "title": "Slug",
      "description": "The slug used under 'Decision Record'."
    }
  },
  "required": [
    "domain",
    "pinned",
    "slug"
  ],
  "x-faion-dictionary-refs": 0
}
