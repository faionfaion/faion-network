<?xml version="1.0" encoding="UTF-8"?>
<text id="06-decision-tree" title="rust-tokio-async Decision Tree" version="1.1.0" est_tokens="600" depth="essential">
  <summary>Routing tree mapping observable signals to a rule from 01-core-rules.xml.</summary>

  <decision-tree>
      <root-question id="q-root">Runtime gates first: default runtime in production? unbounded mpsc on a production path? blocking syscall on an async path? no coordinated shutdown? If all four are clear, is the workload CPU-heavy?</root-question>
      <branch when="runtime_flavour_is_default == true">
        <conclusion ref="r9" verdict="declare rt flavour + worker_threads before anything else"/>
      </branch>
      <branch when="uses_unbounded_mpsc == true">
        <conclusion ref="r10" verdict="switch to bounded mpsc::channel(capacity)"/>
      </branch>
      <branch when="blocking_call_on_async_path == true">
        <conclusion ref="r3" verdict="offload via spawn_blocking or tokio::fs"/>
      </branch>
      <branch when="no_coordinated_shutdown == true">
        <conclusion ref="r11" verdict="wire ctrl_c + CancellationToken before shipping"/>
      </branch>
      <branch when="is_cpu_heavy == true">
        <conclusion ref="r3" verdict="tokio::task::spawn_blocking + .await??"/>
      </branch>
      <branch when="is_cpu_heavy == false">
        <question id="q-next">n_known_at_compile_time == true?</question>
        <branch when="n_known_at_compile_time == true">
          <question id="q-next">n &lt;= 20?</question>
          <branch when="n &lt;= 20">
            <conclusion ref="r2" verdict="tokio::try_join!"/>
          </branch>
          <branch when="n &gt; 20">
            <conclusion ref="r4" verdict="buffer_unordered + Semaphore"/>
          </branch>
        </branch>
        <branch when="n_known_at_compile_time == false">
          <question id="q-next">tasks_added_dynamically == true?</question>
          <branch when="tasks_added_dynamically == true">
            <conclusion ref="r5" verdict="tokio::task::JoinSet"/>
          </branch>
          <branch when="tasks_added_dynamically == false">
            <conclusion ref="r4" verdict="buffer_unordered + Semaphore"/>
          </branch>
        </branch>
      </branch>
  </decision-tree>
</text>
