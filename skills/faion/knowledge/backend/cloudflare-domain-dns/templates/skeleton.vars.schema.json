{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faion.net/schemas/vars/backend/cloudflare-domain-dns/skeleton.vars.schema.json",
  "title": "skeleton template variables",
  "description": "Values for templates/skeleton.md.j2 and templates/skeleton.html.j2. Generated by tpl-jinja from skeleton.md; `description` on each property is the question put to the author.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ipv4": {
      "type": "string",
      "title": "Ipv4",
      "description": "A @. From section 'Records'."
    },
    "ipv6": {
      "type": "string",
      "title": "Ipv6",
      "description": "AAAA. From section 'Records'."
    },
    "mail_provider": {
      "type": "string",
      "title": "Mail provider",
      "description": "TXT. From section 'Records'."
    },
    "mx_host": {
      "type": "string",
      "title": "Mx host",
      "description": "MX. From section 'Records'."
    },
    "zone": {
      "type": "string",
      "title": "Zone",
      "description": "Cloudflare DNS Plan."
    }
  },
  "required": [
    "ipv4",
    "ipv6",
    "mail_provider",
    "mx_host",
    "zone"
  ],
  "x-faion-dictionary-refs": 0
